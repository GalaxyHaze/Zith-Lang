# module: seq-emit

1. outputSink() -> wasm-safe-text-output

2. cstPrinter() -> deterministic-cst-dump
   depends_on: seq-emit::outputSink

3. virPrinter() -> deterministic-vm-v2-dump
   depends_on: seq-emit::outputSink

4. cliFlags() -> cumulative-cst-vir-cli-flags
   depends_on: seq-emit::cstPrinter, seq-emit::virPrinter

5. wasmAbi() -> textual-cst-vir-playground-output
   depends_on: seq-emit::cliFlags

6. tests() -> verified-cst-vir-support
   depends_on: seq-emit::wasmAbi

7. docs() -> published-cst-vir-contract
   depends_on: seq-emit::tests
