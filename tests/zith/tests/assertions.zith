from std/test
from std/io/format
from std/memory/allocators/heap

#[test]
fn assertion_helpers_pass() {
    @log("passing test log sentinel");
    @assertTrue(2 + 2 == 4);
    @assertFalse(2 + 2 == 5);
    @assertEq(2 + 2, 4);
    @assertNe(2 + 2, 5);
}

#[test]
fn assert_eq_reports_mismatch() {
    @assertEq(4 + 1, 4);
}

#[test]
fn fail_reports_message() {
    @fail("intentional failure");
}

struct Ticket {
    value: u32,
}

implement Ticket as Formatable {
    fn format(self, dest: lend FormatBuffer): IoError {
        let status = appendRawBuffer(lend dest, "ticket:", 7);
        if (status != IoError.Ok) {
            return status;
        }
        return formatU32(self.value, lend dest);
    }
}

#[test]
fn user_defined_formatable() {
    let allocator = HeapAllocator {};
    var buffer = emptyFormatBuffer(allocator);
    let value = Ticket { value: 42 };
    let status = format(lend buffer, "custom=#", value);
    if (status != IoError.Ok) {
        destroyBuffer(lend buffer);
        @assert(false);
    }
    @log(buffer.text());
    destroyBuffer(lend buffer);
    @assert(true);
}
