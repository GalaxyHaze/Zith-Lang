// Language corpus: if/else, while and for loops.
fn sumTo(limit: i32): i32 {
    var total = 0;
    for (var i = 0), (i < limit), (i = i + 1) {
        total = total + i
    }
    total
}

fn countdown(start: i32): i32 {
    var value = start;
    var steps = 0;
    for (value > 0) {
        value = value - 1;
        steps = steps + 1
    }
    steps
}

#[test]
fn for_loop_accumulates() {
    @assert(sumTo(4) == 6);
    @assert(sumTo(0) == 0);
}

#[test]
fn conditional_for_terminates() {
    @assert(countdown(5) == 5);
    @assert(countdown(0) == 0);
}

#[test]
fn if_else_branches() {
    let value: i32 = 7;
    var label = 0;
    if (value > 5) {
        label = 1
    } else {
        label = 2
    }
    @assert(label == 1);
}
