    ];
    let metadata_type_0 = must expected->types[0u64];
    let metadata_type_1 = must expected->types[1u64];
    let metadata_type_2 = must expected->types[2u64];
    let metadata_type_3 = must expected->types[3u64];
    let metadata_type_4 = must expected->types[4u64];
