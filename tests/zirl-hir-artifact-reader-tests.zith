        ZirlArtifactSection { id: 0u16, flags: 0u16, schema_version: 0u16, payload: raw no_payload[0u64..0u64] },
        ZirlArtifactSection { id: 0u16, flags: 0u16, schema_version: 0u16, payload: raw no_payload[0u64..0u64] },
        ZirlArtifactSection { id: 0u16, flags: 0u16, schema_version: 0u16, payload: raw no_payload[0u64..0u64] },
