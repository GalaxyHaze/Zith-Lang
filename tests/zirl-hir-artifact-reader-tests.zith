extern fn calloc(count: u64, size: u64): raw opaque
extern fn free(ptr: raw opaque): void


fn hir_artifact_read_fails_atomically(
    bytes: []u8,
    read_storage: *ZirlHirArtifactReadStorage,
    hydration_storage: *ZirlHirArtifactHydrationStorage,
    expected_error: ZirlHirArtifactReadError
): bool {
    let result = read_zirl_hir_artifact_module(
        bytes,
        read_storage,
        hydration_storage
    );
    return result.error == expected_error and
        hir_artifact_module_is_empty(result.module);
}

fn hir_artifact_mutated_reference_fails_atomically(
    bytes: []u8,
    identity: *ZirlArtifactIdentity,
    section_id: u16,
    byte_offset: u64,
    replacement: u8,
    read_storage: *ZirlHirArtifactReadStorage,
    hydration_storage: *ZirlHirArtifactHydrationStorage,
    output: []u8,
    expected_error: ZirlHirArtifactReadError
): bool {
    let original = read_zirl_artifact(bytes, &raw read_storage->artifact);
    if (original.error != ZirlArtifactError.None) {
        return false;
    }
    let no_payload: [0]u8 = [];
    var payload = raw no_payload[0u64..0u64];
    var found = false;
    for (offset in 1u64..@lengthOf(original.sections)) {
        let index = offset - 1u64;
        let section: ZirlArtifactSection = raw original.sections[index];
        if (section.id == section_id) {
            payload = section.payload;
            found = true;
            break;
        }
    }
    if (not found or byte_offset >= @lengthOf(payload)) {
        return false;
    }

    let previous = raw payload[byte_offset];
    raw payload[byte_offset] = replacement;
    var writable_identity = *identity;
    let rewritten = write_zirl_artifact(
        &raw writable_identity,
        original.sections,
        output
    );
    raw payload[byte_offset] = previous;
    if (rewritten.error != ZirlArtifactError.None or rewritten.size == 0u64) {
        return false;
    }
    return hir_artifact_read_fails_atomically(
        raw output[0u64..rewritten.size],
        read_storage,
        hydration_storage,
        expected_error
    );
}

fn hir_artifact_identity_count_mismatch_fails_atomically(
    bytes: []u8,
    identity: *ZirlArtifactIdentity,
    count_kind: u8,
    read_storage: *ZirlHirArtifactReadStorage,
    hydration_storage: *ZirlHirArtifactHydrationStorage,
    output: []u8
): bool {
    let original = read_zirl_artifact(bytes, &raw read_storage->artifact);
    if (original.error != ZirlArtifactError.None) {
        return false;
    }
    let original_typed = read_zirl_hir_artifact_sections(bytes, read_storage);
    if (original_typed.error != ZirlHirArtifactReadError.None) {
        return false;
    }
    let original_declaration_count =
        @lengthOf(original_typed.declarations.declarations);
    let original_template_count =
        @lengthOf(original_typed.templates.templates);
    let original_function_count =
        @lengthOf(original_typed.code.functions);

    var mismatched_identity = *identity;
    if (count_kind == 0u8) {
        if (original_declaration_count == 0xFFFFFFFFu64) {
            return false;
        }
        mismatched_identity.declaration_count =
            (original_declaration_count + 1u64) as u32;
    } else if (count_kind == 1u8) {
        if (original_template_count == 0xFFFFFFFFu64) {
            return false;
        }
        mismatched_identity.template_count =
            (original_template_count + 1u64) as u32;
    } else if (count_kind == 2u8) {
        if (original_function_count == 0xFFFFFFFFu64) {
            return false;
        }
        mismatched_identity.function_count =
            (original_function_count + 1u64) as u32;
    } else {
        return false;
    }
    let rewritten = write_zirl_artifact(
        &raw mismatched_identity,
        original.sections,
        output
    );
    if (rewritten.error != ZirlArtifactError.None or rewritten.size == 0u64) {
        return false;
    }
    return hir_artifact_read_fails_atomically(
        raw output[0u64..rewritten.size],
        read_storage,
        hydration_storage,
        ZirlHirArtifactReadError.IdentityMismatch
    );
}

fn hir_artifact_nonempty_section_fails_without_storage(
    bytes: []u8,
    expected_identity: *ZirlArtifactIdentity,
    section_id: u16,
    payload: []u8,
    read_storage: *ZirlHirArtifactReadStorage,
    hydration_storage: *ZirlHirArtifactHydrationStorage,
    output: []u8
): bool {
    let original = read_zirl_artifact(bytes, &raw read_storage->artifact);
    if (original.error != ZirlArtifactError.None or
        @lengthOf(original.sections) != 5u64) {
        return false;
    }

    var section_index = 0u64;
    if (section_id == zirlHirDeclsSectionId) {
        section_index = 1u64;
    } else (section_id == zirlHirTemplatesSectionId) {
        section_index = 2u64;
    } else {
        return false;
    }
    raw read_storage->artifact.sections[section_index].payload = payload;

    var identity = *expected_identity;
    if (section_id == zirlHirDeclsSectionId) {
        identity.declaration_count = 1u32;
    } else {
        identity.declaration_count = original.header.declaration_count;
    }
    identity.template_count = 1u32;
    let written = write_zirl_artifact(
        &raw identity,
        read_storage->artifact.sections,
        output
    );
    if (written.error != ZirlArtifactError.None or written.size == 0u64) {
        return false;
    }
    return hir_artifact_read_fails_atomically(
        raw output[0u64..written.size],
        read_storage,
        hydration_storage,
        ZirlHirArtifactReadError.InvalidHydratedHir
    );
}

