    if (encoded.failed) {
        free(encoded_bytes);
        return 1;
    }
    if (encoded.position == 0u64) {
        free(encoded_bytes);
        return 2;
    }
    let empty_chars: [1]char = [0 as char];
    let empty_type_ids: [2]HirTypeId = [0u32, 0u32];
    let empty_string_ids: [1]HirStringId = [0u32];
    let output_type_args: [2]HirTypeId = [0u32, 0u32];
    let output_type_arg_names: [1]HirStringId = [0u32];
    let empty_offsets: [1]u64 = [0u64];
    var module_name_buffer: [16]char = [
        0 as char, 0 as char, 0 as char, 0 as char,
        0 as char, 0 as char, 0 as char, 0 as char,
