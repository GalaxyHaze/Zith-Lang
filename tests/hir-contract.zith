}

fn test_required_check_without_proof(): i32 {
    let no_arguments: [1]HirTypeId = [invalidType];
    let no_names: [1]HirStringId = [invalidString];
    let integer_type_id: HirTypeId = 0;
    var integer_type = HirType {
        kind: HirTypeKind.Int,
        width: 32,
        flags: 0,
        ref0: invalidType,
        ref1: 0,
        args: raw no_arguments[0..0],
        arg_names: raw no_names[0..0],
    };
    integer_type.kind = HirTypeKind.Int;
    integer_type.args = raw no_arguments[0..0];
    integer_type.arg_names = raw no_names[0..0];
    var array_type = HirType {
        kind: HirTypeKind.Array,
        width: 0,
        flags: 0,
        ref0: 1,
        ref1: 4,
        args: raw no_arguments[0..0],
        arg_names: raw no_names[0..0],
    };
    array_type.kind = HirTypeKind.Array;
    array_type.ref0 = integer_type_id;
    array_type.args = raw no_arguments[0..0];
    array_type.arg_names = raw no_names[0..0];
    let types: [2]HirType = [integer_type, array_type];
    var object = HirLiteral {
        value_kind: HirLiteralKind.Integer,
        integer: 0,
        float: 0.0,
        boolean: false,
        string_id: invalidString,
        type_id: 1,
    };
    object.value_kind = HirLiteralKind.Integer;
    object.integer = 0;
    object.string_id = invalidString;
    object.type_id = 1;
    var index_value = HirLiteral {
        value_kind: HirLiteralKind.Integer,
        integer: 1,
        float: 0.0,
        boolean: false,
        string_id: invalidString,
        type_id: 1,
    };
    index_value.value_kind = HirLiteralKind.Integer;
    index_value.integer = 1;
    index_value.string_id = invalidString;
    index_value.type_id = integer_type_id;
    var access = HirIndex {
        object: 1,
        index: 1,
        type_id: 1,
        object_type: 1,
        is_array: true,
        safety: HirSafetyMode.RequiredCheck,
    };
    access.object = 0;
    access.type_id = integer_type_id;
    let expressions: [3]HirExpr = [
        HirExpr { object },
        HirExpr { index_value },
        HirExpr { access },
    ];
    let strings: [0][]char = [];
    let functions: [0]HirFunction = [];
    let proofs: [0]HirSafetyProof = [];
    let module = make_hir_module(
        raw strings[0..0],
        raw types[0..2],
        raw expressions[0..3],
        raw functions[0..0],
        raw proofs[0..0]
    );
    let result = verify_hir(&module);
    let checked_expression: HirExpr = raw module.expressions[2];
    if (result.error == HirVerifyError.None) {
        if (checked_expression is HirIndex) {
            let checked_index: HirIndex = checked_expression;
            if (checked_index.safety == HirSafetyMode.RequiredCheck) {
                return 0;
            }
        }
    }
    return 1;
}

fn test_required_check_proof_operands_match(expected_operand: HirExprId): i32 {
    let no_arguments: [1]HirTypeId = [invalidType];
    let no_names: [1]HirStringId = [invalidString];
    let integer_type_id: HirTypeId = 0;
    var integer_type = HirType {
        kind: HirTypeKind.Int,
        width: 32,
        flags: 0,
        ref0: invalidType,
        ref1: 0,
        args: raw no_arguments[0..0],
        arg_names: raw no_names[0..0],
    };
    integer_type.kind = HirTypeKind.Int;
    integer_type.args = raw no_arguments[0..0];
    integer_type.arg_names = raw no_names[0..0];
    var array_type = HirType {
        kind: HirTypeKind.Array,
        width: 0,
        flags: 0,
        ref0: 1,
        ref1: 4,
        args: raw no_arguments[0..0],
        arg_names: raw no_names[0..0],
    };
    array_type.kind = HirTypeKind.Array;
    array_type.ref0 = integer_type_id;
    array_type.args = raw no_arguments[0..0];
    array_type.arg_names = raw no_names[0..0];
    let types: [2]HirType = [integer_type, array_type];
    var object = HirLiteral {
        value_kind: HirLiteralKind.Integer,
        integer: 0,
        float: 0.0,
        boolean: false,
        string_id: invalidString,
        type_id: 1,
    };
    object.value_kind = HirLiteralKind.Integer;
    object.integer = 0;
    object.string_id = invalidString;
    object.type_id = 1;
    var index_value = HirLiteral {
        value_kind: HirLiteralKind.Integer,
        integer: 1,
        float: 0.0,
        boolean: false,
        string_id: invalidString,
        type_id: 1,
    };
    index_value.value_kind = HirLiteralKind.Integer;
    index_value.integer = 1;
    index_value.string_id = invalidString;
    index_value.type_id = integer_type_id;
    var access = HirIndex {
        object: 1,
        index: 1,
        type_id: 1,
        object_type: 1,
        is_array: true,
        safety: HirSafetyMode.RequiredCheck,
    };
    access.object = 0;
    access.type_id = integer_type_id;
    let expressions: [3]HirExpr = [
        HirExpr { object },
        HirExpr { index_value },
        HirExpr { access },
    ];
    let absent = HirSafetyProof {
        kind: HirSafetyProofKind.BoundsValid,
        operand_a: 0xFFFFFFFFu32,
        operand_b: 0xFFFFFFFFu32,
        operand_c: 0xFFFFFFFFu32,
        present: false,
    };
    var absent_proof = absent;
    absent_proof.kind = HirSafetyProofKind.BoundsValid;
    absent_proof.operand_a = 0xFFFFFFFFu32;
    absent_proof.operand_b = 0xFFFFFFFFu32;
    absent_proof.operand_c = 0xFFFFFFFFu32;
    absent_proof.present = false;
    var present = HirSafetyProof {
        kind: HirSafetyProofKind.BoundsValid,
        operand_a: 1,
        operand_b: expected_operand,
        operand_c: 0xFFFFFFFFu32,
        present: true,
    };
    present.kind = HirSafetyProofKind.BoundsValid;
    present.operand_a = 0;
    present.operand_b = expected_operand;
    present.operand_c = 0xFFFFFFFFu32;
    present.present = true;
    let proofs: [3]HirSafetyProof = [absent_proof, absent_proof, present];
    let strings: [0][]char = [];
    let functions: [0]HirFunction = [];
    let module = make_hir_module(
        raw strings[0..0],
        raw types[0..2],
        raw expressions[0..3],
        raw functions[0..0],
        raw proofs[0..3]
    );
    let result = verify_hir(&module);
    if (expected_operand == 1 and result.error == HirVerifyError.None) {
        return 0;
    }
    if (expected_operand != 1 and result.error == HirVerifyError.InvalidSafetyProof) {
        return 0;
    }
    if (expected_operand == 1) {
        return 1;
    }
    return 1;
}

