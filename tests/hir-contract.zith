    var name_storage = ZirlMetadataStorage {
        module_name: raw module_name_buffer[0..16],
        name_scratch: raw name_scratch[0..16],
        paths: raw path_values[0..1],
        path_bytes: raw path_bytes[0..32],
        strings: raw string_values[0..4],
        string_bytes: raw string_bytes[0..32],
        types: raw output_types[0..2],
        type_args: raw output_type_args[0..2],
        type_arg_names: raw output_type_arg_names[0..1],
        struct_defs: raw output_struct_defs[0..1],
        struct_field_names: raw empty_string_ids[0..1],
        struct_field_types: raw empty_type_ids[0..1],
        struct_foreign_offsets: raw empty_offsets[0..1],
        struct_type_args: raw empty_type_ids[0..1],
        enum_defs: raw output_enum_defs[0..1],
        enum_variants: raw output_enum_variants[0..1],
        union_defs: raw output_union_defs[0..1],
        union_member_types: raw union_members[0..1],
    };
    var flags_storage = ZirlMetadataStorage {
        module_name: raw module_name_buffer[0..16],
        name_scratch: raw name_scratch[0..16],
        paths: raw path_values[0..1],
        path_bytes: raw path_bytes[0..32],
        strings: raw string_values[0..4],
        string_bytes: raw string_bytes[0..32],
        types: raw output_types[0..2],
        type_args: raw output_type_args[0..2],
        type_arg_names: raw output_type_arg_names[0..1],
        struct_defs: raw output_struct_defs[0..1],
        struct_field_names: raw empty_string_ids[0..1],
        struct_field_types: raw empty_type_ids[0..1],
        struct_foreign_offsets: raw empty_offsets[0..1],
        struct_type_args: raw empty_type_ids[0..1],
        enum_defs: raw output_enum_defs[0..1],
        enum_variants: raw output_enum_variants[0..1],
        union_defs: raw output_union_defs[0..1],
        union_member_types: raw union_members[0..1],
    };
    let reader = ZirlByteReader {
        bytes: raw encoded_bytes[0u64..encoded.position],
        position: 0u64,
        failed: false,
    };
    let decoded = read_metadata_section(reader, &storage);
    if (decoded.reader.failed or decoded.reader.position != encoded.position) {
        free(encoded_bytes);
        return 2;
    }
    let decoded_path = must decoded.value.paths[0];
    let first_string = must decoded.value.strings[0];
    let decoded_type = must decoded.value.types[0];
    let decoded_generic_type = must decoded.value.types[1];
    if (@lengthOf(decoded.value.module_name) != 4u64 or
        raw decoded.value.module_name[0] != raw "demo"[0] or
        @lengthOf(decoded.value.paths) != 1u64 or
        @lengthOf(decoded_path) != 12u64 or
        @lengthOf(decoded.value.strings) != 4u64 or
        @lengthOf(first_string) != 6u64 or
        @lengthOf(decoded.value.types) != 2u64 or
        decoded_type.kind != HirTypeKind.Bool) {
        free(encoded_bytes);
        return 3;
    }
    if (decoded_generic_type.kind != HirTypeKind.Fn) {
        free(encoded_bytes);
        return 9;
    }
    if (@lengthOf(decoded_generic_type.args) != 2u64) {
        free(encoded_bytes);
        return 10;
    }
    if (raw decoded_generic_type.args[0] != 0u32 or
        raw decoded_generic_type.args[1] != 1u32) {
        free(encoded_bytes);
        return 11;
    }
    if (@lengthOf(decoded_generic_type.arg_names) != 1u64) {
        free(encoded_bytes);
        return 12;
    }
    if (raw decoded_generic_type.arg_names[0] != 3u32) {
        free(encoded_bytes);
        return 13;
    }
    let decoded_struct = must decoded.value.struct_defs[0];
    let decoded_field_name = must decoded_struct.field_name_ids[0];
    let decoded_field_type = must decoded_struct.field_type_ids[0];
    let decoded_field_offset = must decoded_struct.foreign_field_offsets[0];
    let decoded_type_arg = must decoded_struct.type_arg_ids[0];
    let decoded_enum = must decoded.value.enum_defs[0];
    let decoded_variant = must decoded_enum.variants[0];
    let decoded_union = must decoded.value.union_defs[0];
    let decoded_member = must decoded_union.member_type_ids[0];
    if (@lengthOf(decoded.value.struct_defs) != 1u64 or
        decoded_struct.name_id != 0u32 or
        @lengthOf(decoded_struct.field_name_ids) != 1u64 or
        decoded_field_name != 0u32 or
        @lengthOf(decoded_struct.field_type_ids) != 1u64 or
        decoded_field_type != 0u32 or
        @lengthOf(decoded_struct.foreign_field_offsets) != 1u64 or
        decoded_field_offset != 0u64 or
        @lengthOf(decoded_struct.type_arg_ids) != 1u64 or
        decoded_type_arg != 0u32 or
        decoded_struct.has_foreign_layout or
        decoded_struct.foreign_abi_is_single_i64 or
        @lengthOf(decoded.value.enum_defs) != 1u64 or
        decoded_enum.name_id != 1u32 or
        decoded_enum.underlying_type_id != 0u32 or
        @lengthOf(decoded_enum.variants) != 1u64 or
        decoded_variant.name_id != 2u32 or
        decoded_variant.discriminant != 7i64 or
        @lengthOf(decoded.value.union_defs) != 1u64 or
        decoded_union.name_id != 3u32 or
        not decoded_union.is_raw or
        @lengthOf(decoded_union.member_type_ids) != 1u64 or
        decoded_member != 0u32) {
        free(encoded_bytes);
        return 4;
    }

    let truncated_reader = ZirlByteReader {
        bytes: raw encoded_bytes[0u64..(encoded.position - 1u64)],
        position: 0u64,
        failed: false,
    };
    let truncated = read_metadata_section(truncated_reader, &truncated_storage);
    if (not truncated.reader.failed or truncated.reader.position != 0u64 or
        @lengthOf(truncated.value.types) != 0u64 or
        @lengthOf(truncated.value.struct_defs) != 0u64) {
        free(encoded_bytes);
        return 5;
    }

    raw encoded_bytes[139u64] = 1u8;
    let mismatched_name = read_metadata_section(reader, &name_storage);
    if (not mismatched_name.reader.failed or
        mismatched_name.reader.position != 0u64 or
        @lengthOf(mismatched_name.value.types) != 0u64 or
        @lengthOf(mismatched_name.value.struct_defs) != 0u64) {
        raw encoded_bytes[139u64] = 0u8;
        free(encoded_bytes);
        return 6;
    }
    raw encoded_bytes[139u64] = 0u8;

    raw encoded_bytes[260u64] = 2u8;
    let invalid_flags = read_metadata_section(reader, &flags_storage);
    if (not invalid_flags.reader.failed or invalid_flags.reader.position != 0u64 or
        @lengthOf(invalid_flags.value.types) != 0u64 or
        @lengthOf(invalid_flags.value.union_defs) != 0u64) {
        raw encoded_bytes[260u64] = 1u8;
        free(encoded_bytes);
        return 7;
    }
    raw encoded_bytes[260u64] = 1u8;

    let short_writer = ZirlByteWriter {
        bytes: raw encoded_bytes[0u64..(encoded.position - 1u64)],
        position: 0u64,
        failed: false,
    };
    var short_module = empty_hir_module();
    short_module.strings = raw strings[0..4];
    short_module.types = raw types[0..2];
    short_module.struct_defs = raw struct_defs[0..1];
    short_module.enum_defs = raw enum_defs[0..1];
    short_module.union_defs = raw union_defs[0..1];
    let short_write = write_metadata_section(short_writer, "demo", raw paths[0..1], &short_module);
    if (not short_write.failed) {
        free(encoded_bytes);
        return 8;
    }

    free(encoded_bytes);
    return 0;
}

fn test_zirl_decls_golden_roundtrip_and_failures(): i32 {
    let field_names: [1]HirStringId = [5u32];
    let field_types: [1]HirTypeId = [6u32];
    let method_indices: [2]HirDeclarationId = [7u32, 9u32];
    let declarations: [2]ZirlDeclarationRecord = [
        ZirlDeclarationRecord {
            kind: HirDeclarationKind.Struct,
            visibility: HirVisibility.Module,
            is_extern: true,
            discardable: true,
            module_depth: -2i32,
            name_id: 3u32,
            type_id: 4u32,
            template_index: 0xFFFFFFFFu32,
            body_function_index: 8u32,
            field_name_ids: raw field_names[0..1],
            field_type_ids: raw field_types[0..1],
            method_declaration_indices: raw method_indices[0..2],
        },
        ZirlDeclarationRecord {
            kind: HirDeclarationKind.Function,
            visibility: HirVisibility.Private,
            is_extern: false,
            discardable: false,
            module_depth: 0i32,
            name_id: 10u32,
            type_id: 11u32,
            template_index: 0xFFFFFFFFu32,
            body_function_index: 12u32,
            field_name_ids: raw field_names[0..0],
            field_type_ids: raw field_types[0..0],
            method_declaration_indices: raw method_indices[0..0],
        },
    ];
    let section = ZirlDeclSection {
        declarations: raw declarations[0..2],
    };
    let expected: [84]u8 = [
        2u8, 0u8, 0u8, 0u8,
        1u8, 2u8, 1u8, 1u8,
        254u8, 255u8, 255u8, 255u8,
        3u8, 0u8, 0u8, 0u8,
        4u8, 0u8, 0u8, 0u8,
        255u8, 255u8, 255u8, 255u8,
        8u8, 0u8, 0u8, 0u8,
        1u8, 0u8, 0u8, 0u8,
        5u8, 0u8, 0u8, 0u8,
        6u8, 0u8, 0u8, 0u8,
        2u8, 0u8, 0u8, 0u8,
        7u8, 0u8, 0u8, 0u8,
        9u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8,
        10u8, 0u8, 0u8, 0u8,
        11u8, 0u8, 0u8, 0u8,
        255u8, 255u8, 255u8, 255u8,
        12u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8,
    ];
    var encoded_bytes: [84]u8 = expected;
    var writer = ZirlByteWriter {
        bytes: raw encoded_bytes[0..84],
        position: 0u64,
        failed: false,
    };
    writer = write_decls_section(writer, &raw section);
    if (writer.failed or writer.position != 84u64) {
        return 1;
    }
    for (offset in 1u64..84u64) {
        let index = offset - 1;
        if (raw encoded_bytes[index] != raw expected[index]) {
            return 2;
        }
    }

    let decoded_records: [2]ZirlDeclarationRecord = [
        ZirlDeclarationRecord {
            kind: HirDeclarationKind.Function,
            visibility: HirVisibility.Private,
            is_extern: false,
            discardable: false,
            module_depth: 0i32,
            name_id: 0u32,
            type_id: 0u32,
            template_index: 0u32,
            body_function_index: 0u32,
            field_name_ids: raw field_names[0..0],
            field_type_ids: raw field_types[0..0],
            method_declaration_indices: raw method_indices[0..0],
        },
        ZirlDeclarationRecord {
            kind: HirDeclarationKind.Function,
            visibility: HirVisibility.Private,
            is_extern: false,
            discardable: true,
            module_depth: 0i32,
            name_id: 0u32,
            type_id: 0u32,
            template_index: 0u32,
            body_function_index: 0u32,
            field_name_ids: raw field_names[0..0],
            field_type_ids: raw field_types[0..0],
            method_declaration_indices: raw method_indices[0..0],
        },
    ];
    let decoded_names: [1]HirStringId = [0u32];
    let decoded_types: [1]HirTypeId = [0u32];
    let decoded_methods: [2]HirDeclarationId = [0u32, 0u32];
    var storage = ZirlDeclStorage {
        declarations: raw decoded_records[0..2],
        field_name_ids: raw decoded_names[0..1],
        field_type_ids: raw decoded_types[0..1],
        method_declaration_indices: raw decoded_methods[0..2],
    };
    let reader = ZirlByteReader {
        bytes: raw encoded_bytes[0..84],
        position: 0u64,
        failed: false,
    };
    let decoded = read_decls_section(reader, &raw storage);
    if (decoded.reader.failed or decoded.reader.position != 84u64 or
        @lengthOf(decoded.value.declarations) != 2u64) {
        return 3;
    }
    let item = must decoded.value.declarations[0];
    let second_item = must decoded.value.declarations[1];
    if (item.kind != HirDeclarationKind.Struct or
        item.visibility != HirVisibility.Module or not item.is_extern or
        not item.discardable or
        item.module_depth != -2i32 or item.name_id != 3u32 or
        item.type_id != 4u32 or item.template_index != 0xFFFFFFFFu32 or
        item.body_function_index != 8u32 or
        @lengthOf(item.field_name_ids) != 1u64 or
        raw item.field_name_ids[0] != 5u32 or
        @lengthOf(item.field_type_ids) != 1u64 or
        raw item.field_type_ids[0] != 6u32 or
        @lengthOf(item.method_declaration_indices) != 2u64 or
        raw item.method_declaration_indices[0] != 7u32 or
        raw item.method_declaration_indices[1] != 9u32 or
        second_item.name_id != 10u32 or second_item.type_id != 11u32 or
        second_item.body_function_index != 12u32 or second_item.discardable) {
        return 4;
    }

    let truncated = read_decls_section(
        ZirlByteReader {
            bytes: raw encoded_bytes[0..83],
            position: 0u64,
            failed: false,
        },
        &raw storage
    );
    if (not truncated.reader.failed or truncated.reader.position != 0u64 or
        @lengthOf(truncated.value.declarations) != 0u64) {
        return 5;
    }

    raw encoded_bytes[4u64] = 13u8;
    let invalid_kind = read_decls_section(reader, &raw storage);
    if (not invalid_kind.reader.failed or invalid_kind.reader.position != 0u64) {
        raw encoded_bytes[4u64] = 1u8;
        return 6;
    }
    raw encoded_bytes[4u64] = 1u8;

    raw encoded_bytes[7u64] = 2u8;
    let invalid_discardable = read_decls_section(reader, &raw storage);
    if (not invalid_discardable.reader.failed or
        invalid_discardable.reader.position != 0u64) {
        raw encoded_bytes[7u64] = 1u8;
        return 12;
    }
    raw encoded_bytes[7u64] = 1u8;

    let short_writer = write_decls_section(
        ZirlByteWriter {
            bytes: raw encoded_bytes[0..83],
            position: 0u64,
            failed: false,
        },
        &raw section
    );
    if (not short_writer.failed) {
        return 7;
    }
    return 0;
}

fn test_zirl_templates_golden_roundtrip_and_failures(): i32 {
    let bound_types: [1]HirTypeId = [4u32];
    let params: [1]ZirlGenericParamRecord = [
        ZirlGenericParamRecord {
            name_id: 3u32,
            bound_type_ids: raw bound_types[0..1],
        },
    ];
    let param_types: [1]HirTypeId = [5u32];
    let param_names: [1]HirStringId = [6u32];
    let field_names: [1]HirStringId = [7u32];
    let field_types: [1]HirTypeId = [8u32];
    let field_order: [1]u32 = [0u32];
    let methods: [1]HirDeclarationId = [9u32];
    let traits: [1]HirTypeId = [10u32];
    let templates: [1]ZirlTemplateRecord = [
        ZirlTemplateRecord {
            kind: HirDeclarationKind.Function,
            is_extern: true,
            name_id: 1u32,
            declaration_index: 11u32,
            function_index: invalidFunction,
            return_type_id: 2u32,
            params: raw params[0..1],
            param_type_ids: raw param_types[0..1],
            param_name_ids: raw param_names[0..1],
            field_name_ids: raw field_names[0..1],
            field_type_ids: raw field_types[0..1],
            canonical_field_order: raw field_order[0..1],
            method_declaration_indices: raw methods[0..1],
            trait_type_ids: raw traits[0..1],
        },
    ];
    let section = ZirlTemplateSection { templates: raw templates[0..1] };
    let expected: [96]u8 = [
        1u8, 0u8, 0u8, 0u8,
        0u8, 1u8, 0u8, 0u8,
        1u8, 0u8, 0u8, 0u8,
        11u8, 0u8, 0u8, 0u8,
        255u8, 255u8, 255u8, 255u8,
        2u8, 0u8, 0u8, 0u8,
        1u8, 0u8, 0u8, 0u8,
        3u8, 0u8, 0u8, 0u8,
        1u8, 0u8, 0u8, 0u8,
        4u8, 0u8, 0u8, 0u8,
        1u8, 0u8, 0u8, 0u8,
        5u8, 0u8, 0u8, 0u8,
        1u8, 0u8, 0u8, 0u8,
        6u8, 0u8, 0u8, 0u8,
        1u8, 0u8, 0u8, 0u8,
        7u8, 0u8, 0u8, 0u8,
        1u8, 0u8, 0u8, 0u8,
        8u8, 0u8, 0u8, 0u8,
        1u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8,
        1u8, 0u8, 0u8, 0u8,
        9u8, 0u8, 0u8, 0u8,
        1u8, 0u8, 0u8, 0u8,
        10u8, 0u8, 0u8, 0u8,
    ];
    var encoded: [96]u8 = expected;
    let writer = write_templates_section(
        ZirlByteWriter {
            bytes: raw encoded[0..96],
            position: 0u64,
            failed: false,
        },
        &raw section
    );
    if (writer.failed or writer.position != 96u64) {
        return 1;
    }
    for (offset in 1u64..96u64) {
        let index = offset - 1;
        if (raw encoded[index] != raw expected[index]) {
            return 2;
        }
    }

    let empty_params: [1]ZirlGenericParamRecord = [
        ZirlGenericParamRecord {
            name_id: 0u32,
            bound_type_ids: raw bound_types[0..0],
        },
    ];
    let decoded_templates: [1]ZirlTemplateRecord = [
        ZirlTemplateRecord {
            kind: HirDeclarationKind.Struct,
            is_extern: false,
            name_id: 0u32,
            declaration_index: 0u32,
            function_index: invalidFunction,
            return_type_id: 0u32,
            params: raw empty_params[0..0],
            param_type_ids: raw param_types[0..0],
            param_name_ids: raw param_names[0..0],
            field_name_ids: raw field_names[0..0],
            field_type_ids: raw field_types[0..0],
            canonical_field_order: raw field_order[0..0],
            method_declaration_indices: raw methods[0..0],
            trait_type_ids: raw traits[0..0],
        },
    ];
    let decoded_params: [1]ZirlGenericParamRecord = [
        ZirlGenericParamRecord {
            name_id: 0u32,
            bound_type_ids: raw bound_types[0..0],
        },
    ];
    let decoded_bounds: [1]HirTypeId = [0u32];
    let decoded_param_types: [1]HirTypeId = [0u32];
    let decoded_param_names: [1]HirStringId = [0u32];
    let decoded_field_names: [1]HirStringId = [0u32];
    let decoded_field_types: [1]HirTypeId = [0u32];
    let decoded_field_order: [1]u32 = [0u32];
    let decoded_methods: [1]HirDeclarationId = [0u32];
    let decoded_traits: [1]HirTypeId = [0u32];
    var storage = ZirlTemplateStorage {
        templates: raw decoded_templates[0..1],
        params: raw decoded_params[0..1],
        param_bound_type_ids: raw decoded_bounds[0..1],
        param_type_ids: raw decoded_param_types[0..1],
        param_name_ids: raw decoded_param_names[0..1],
        field_name_ids: raw decoded_field_names[0..1],
        field_type_ids: raw decoded_field_types[0..1],
        canonical_field_order: raw decoded_field_order[0..1],
        method_declaration_indices: raw decoded_methods[0..1],
        trait_type_ids: raw decoded_traits[0..1],
    };
    let reader = ZirlByteReader {
        bytes: raw encoded[0..96],
        position: 0u64,
        failed: false,
    };
    let decoded = read_templates_section(reader, &raw storage);
    if (decoded.reader.failed or decoded.reader.position != 96u64 or
        @lengthOf(decoded.value.templates) != 1u64) {
        return 3;
    }
    let item = must decoded.value.templates[0];
    let param = must item.params[0];
    if (item.kind != HirDeclarationKind.Function or not item.is_extern or
        item.name_id != 1u32 or item.return_type_id != 2u32 or
        item.declaration_index != 11u32 or
        item.function_index != invalidFunction or
        @lengthOf(item.params) != 1u64 or param.name_id != 3u32 or
        @lengthOf(param.bound_type_ids) != 1u64 or
        raw param.bound_type_ids[0] != 4u32 or
        raw item.param_type_ids[0] != 5u32 or
        raw item.param_name_ids[0] != 6u32 or
        raw item.field_name_ids[0] != 7u32 or
        raw item.field_type_ids[0] != 8u32 or
        raw item.canonical_field_order[0] != 0u32 or
        raw item.method_declaration_indices[0] != 9u32 or
        raw item.trait_type_ids[0] != 10u32) {
        return 4;
    }

    let truncated = read_templates_section(
        ZirlByteReader {
            bytes: raw encoded[0..95],
            position: 0u64,
            failed: false,
        },
        &raw storage
    );
    if (not truncated.reader.failed or truncated.reader.position != 0u64 or
        @lengthOf(truncated.value.templates) != 0u64) {
        return 5;
    }

    raw encoded[6u64] = 1u8;
    let invalid_reserved = read_templates_section(reader, &raw storage);
    if (not invalid_reserved.reader.failed or invalid_reserved.reader.position != 0u64) {
        raw encoded[6u64] = 0u8;
        return 6;
    }
    raw encoded[6u64] = 0u8;
    return 0;
}

fn test_zirl_attrs_golden_roundtrip_and_failures(): i32 {
    let escapes: [2]HirCallEscape = [
        HirCallEscape.Borrow,
        HirCallEscape.Move,
    ];
    let slots: [1]ZirlSlotAttrsRecord = [
        ZirlSlotAttrsRecord {
            slot_id: 0x12u32,
            ownership: HirOwnership.Unique,
            consumed: HirConsumedState.NonConsumed,
            non_null: true,
            volatile_slot: false,
        },
    ];
    let calls: [1]ZirlCallAttrsRecord = [
        ZirlCallAttrsRecord {
            expr_id: 0x34u32,
            returns_argument: 1u32,
            arg_escapes: raw escapes[0..2],
        },
    ];
    let functions: [1]ZirlFunctionAttrsRecord = [
        ZirlFunctionAttrsRecord {
            function_index: 0x56u32,
            return_consumed: HirConsumedState.Consumed,
            non_null: true,
            no_alias: false,
            read_only: true,
            no_capture: false,
            discardable: true,
        },
    ];
    let proofs: [2]ZirlSafetyProofRecord = [
        ZirlSafetyProofRecord {
            expr_id: 0u32,
            kind: HirSafetyProofKind.OpaqueTypeMatches,
            operand_a: 1u32,
            operand_b: 2u32,
            operand_c: 3u32,
            present: true,
        },
        ZirlSafetyProofRecord {
            expr_id: 1u32,
            kind: HirSafetyProofKind.BoundsValid,
            operand_a: 4u32,
            operand_b: 5u32,
            operand_c: 6u32,
            present: false,
        },
    ];
    let section = ZirlAttrsSection {
        slots: raw slots[0..1],
        calls: raw calls[0..1],
        functions: raw functions[0..1],
        safety_proofs: raw proofs[0..2],
    };
    let expected: [92]u8 = [
        1u8, 0u8, 0u8, 0u8,
        0x12u8, 0u8, 0u8, 0u8,
        3u8, 2u8, 1u8, 0u8,
        1u8, 0u8, 0u8, 0u8,
        0x34u8, 0u8, 0u8, 0u8,
        1u8, 0u8, 0u8, 0u8,
        2u8, 0u8, 0u8, 0u8,
        1u8, 0u8, 0u8, 0u8,
        4u8, 0u8, 0u8, 0u8,
        1u8, 0u8, 0u8, 0u8,
        0x56u8, 0u8, 0u8, 0u8,
        1u8, 1u8, 0u8, 1u8, 0u8, 1u8, 0u8, 0u8,
        2u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8,
        3u8,
        1u8, 0u8, 0u8, 0u8,
        2u8, 0u8, 0u8, 0u8,
        3u8, 0u8, 0u8, 0u8,
        1u8,
        1u8, 0u8, 0u8, 0u8,
        0u8,
        4u8, 0u8, 0u8, 0u8,
        5u8, 0u8, 0u8, 0u8,
        6u8, 0u8, 0u8, 0u8,
        0u8,
    ];
    var encoded: [92]u8 = expected;
    let writer = write_attrs_section(
        ZirlByteWriter {
            bytes: raw encoded[0..92],
            position: 0u64,
            failed: false,
        },
        &raw section
    );
    if (writer.failed or writer.position != 92u64) {
        return 1;
    }
    for (offset in 1u64..92u64) {
        let index = offset - 1;
        if (raw encoded[index] != raw expected[index]) {
            return 2;
        }
    }

    let decoded_slots: [1]ZirlSlotAttrsRecord = [
        ZirlSlotAttrsRecord {
            slot_id: 0u32,
            ownership: HirOwnership.Default,
            consumed: HirConsumedState.Unknown,
            non_null: false,
            volatile_slot: false,
        },
    ];
    let decoded_calls: [1]ZirlCallAttrsRecord = [
        ZirlCallAttrsRecord {
            expr_id: 0u32,
            returns_argument: 0xFFFFFFFFu32,
            arg_escapes: raw escapes[0..0],
        },
    ];
    let decoded_escapes: [2]HirCallEscape = [
        HirCallEscape.None,
        HirCallEscape.None,
    ];
    let decoded_functions: [1]ZirlFunctionAttrsRecord = [
        ZirlFunctionAttrsRecord {
            function_index: 0u32,
            return_consumed: HirConsumedState.Unknown,
            non_null: false,
            no_alias: false,
            read_only: false,
            no_capture: false,
            discardable: false,
        },
    ];
    let decoded_proofs: [2]ZirlSafetyProofRecord = [
        ZirlSafetyProofRecord {
            expr_id: 0u32,
            kind: HirSafetyProofKind.BoundsValid,
            operand_a: 0u32,
            operand_b: 0u32,
            operand_c: 0u32,
            present: false,
        },
        ZirlSafetyProofRecord {
            expr_id: 0u32,
            kind: HirSafetyProofKind.BoundsValid,
            operand_a: 0u32,
            operand_b: 0u32,
            operand_c: 0u32,
            present: true,
        },
    ];
    let proof_seen: [2]bool = [false, false];
    var storage = ZirlAttrsStorage {
        slots: raw decoded_slots[0..1],
        calls: raw decoded_calls[0..1],
        call_escapes: raw decoded_escapes[0..2],
        functions: raw decoded_functions[0..1],
        safety_proofs: raw decoded_proofs[0..2],
        proof_expr_seen: raw proof_seen[0..2],
    };
    let reader = ZirlByteReader {
        bytes: raw encoded[0..92],
        position: 0u64,
        failed: false,
    };
    let decoded = read_attrs_section(reader, &raw storage);
    if (decoded.reader.failed or decoded.reader.position != 92u64 or
        @lengthOf(decoded.value.slots) != 1u64 or
        @lengthOf(decoded.value.calls) != 1u64 or
        @lengthOf(decoded.value.functions) != 1u64 or
        @lengthOf(decoded.value.safety_proofs) != 2u64) {
        return 3;
    }
    let decoded_slot = must decoded.value.slots[0];
    let decoded_call = must decoded.value.calls[0];
    let decoded_function = must decoded.value.functions[0];
    let decoded_proof = must decoded.value.safety_proofs[0];
    let decoded_absent_proof = must decoded.value.safety_proofs[1];
    if (decoded_slot.slot_id != 0x12u32 or
        decoded_slot.ownership != HirOwnership.Unique or
        decoded_slot.consumed != HirConsumedState.NonConsumed or
        not decoded_slot.non_null or decoded_slot.volatile_slot or
        decoded_call.expr_id != 0x34u32 or
        decoded_call.returns_argument != 1u32 or
        @lengthOf(decoded_call.arg_escapes) != 2u64 or
        raw decoded_call.arg_escapes[0] != HirCallEscape.Borrow or
        raw decoded_call.arg_escapes[1] != HirCallEscape.Move or
        decoded_function.function_index != 0x56u32 or
        decoded_function.return_consumed != HirConsumedState.Consumed or
        not decoded_function.non_null or decoded_function.no_alias or
        not decoded_function.read_only or decoded_function.no_capture or
        not decoded_function.discardable or
        decoded_proof.expr_id != 0u32 or
        decoded_proof.kind != HirSafetyProofKind.OpaqueTypeMatches or
        decoded_proof.operand_a != 1u32 or decoded_proof.operand_b != 2u32 or
        decoded_proof.operand_c != 3u32 or not decoded_proof.present or
        not raw proof_seen[0] or decoded_absent_proof.expr_id != 1u32 or
        decoded_absent_proof.kind != HirSafetyProofKind.BoundsValid or
        decoded_absent_proof.operand_a != 4u32 or
        decoded_absent_proof.operand_b != 5u32 or
        decoded_absent_proof.operand_c != 6u32 or
        decoded_absent_proof.present or not raw proof_seen[1]) {
        return 4;
    }

    let truncated = read_attrs_section(
        ZirlByteReader {
            bytes: raw encoded[0..91],
            position: 0u64,
            failed: false,
        },
        &raw storage
    );
    if (not truncated.reader.failed or truncated.reader.position != 0u64 or
        @lengthOf(truncated.value.slots) != 0u64 or
        @lengthOf(truncated.value.safety_proofs) != 0u64 or raw proof_seen[0]) {
        return 5;
    }

    raw encoded[73u64] = 2u8;
    let invalid_present = read_attrs_section(reader, &raw storage);
    if (not invalid_present.reader.failed or invalid_present.reader.position != 0u64) {
        raw encoded[73u64] = 1u8;
        return 9;
    }
    raw encoded[73u64] = 1u8;

    raw encoded[28u64] = 5u8;
    let invalid_escape = read_attrs_section(reader, &raw storage);
    if (not invalid_escape.reader.failed or invalid_escape.reader.position != 0u64) {
        raw encoded[28u64] = 1u8;
        return 6;
    }
    raw encoded[28u64] = 1u8;

    raw encoded[60u64] = 4u8;
    let invalid_proof = read_attrs_section(reader, &raw storage);
    if (not invalid_proof.reader.failed or invalid_proof.reader.position != 0u64) {
        raw encoded[60u64] = 3u8;
        return 7;
    }
    raw encoded[60u64] = 3u8;

    let short_writer = write_attrs_section(
        ZirlByteWriter {
            bytes: raw encoded[0..91],
            position: 0u64,
            failed: false,
        },
        &raw section
    );
    if (not short_writer.failed) {
        return 8;
    }
    return 0;
}

fn test_zirl_code_golden_and_failures(): i32 {
    let no_ids: [0]u32 = [];
    let no_u64s: [0]u64 = [];
    let expression = ZirlCompactExpr {
        kind: ZirlCompactExprKind.Literal as u8,
        op: 2u8,
        flags: 3u8,
        safety: ZirlCompactSafetyMode.Raw,
        type_id: 0x01020304u32,
        ref_a: 0x11121314u32,
        ref_b: 0x21222324u32,
        ref_c: 0x31323334u32,
        ref_d: 0x41424344u32,
        ref_e: 0x51525354u32,
        ref_f: 0x61626364u32,
        name_id: 0x71727374u32,
        resolved_function_name_id: 0x81828384u32,
        resolved_function_signature_type_id: 0x91929394u32,
        variadic_slice_param: 0xFFFFFFFFu32,
        is_variadic_slice: false,
        auto_collect_tail: false,
        int_value: -2i64,
        float_value: 1.0,
        args: raw no_ids[0..0],
        arg_types: raw no_ids[0..0],
        integers: raw no_u64s[0..0],
    };
    let expressions: [1]ZirlCompactExpr = [expression];
    let no_functions: [0]ZirlCompactFunction = [];
    let no_blocks: [0]ZirlCompactBasicBlock = [];
    let no_globals: [0]ZirlCodeGlobal = [];
    let no_vtables: [0]ZirlCodeVTable = [];
    let no_mappings: [0]ZirlCanonicalMapping = [];
    let section = ZirlCodeSection {
        expressions: raw expressions[0..1],
        functions: raw no_functions[0..0],
        globals: raw no_globals[0..0],
        vtables: raw no_vtables[0..0],
        canonical_mappings: raw no_mappings[0..0],
    };
    let expected: [98]u8 = [
        1u8, 0u8, 0u8, 0u8,
        0u8, 2u8, 3u8, 3u8,
        4u8, 3u8, 2u8, 1u8,
        0x14u8, 0x13u8, 0x12u8, 0x11u8,
        0x24u8, 0x23u8, 0x22u8, 0x21u8,
        0x34u8, 0x33u8, 0x32u8, 0x31u8,
        0x44u8, 0x43u8, 0x42u8, 0x41u8,
        0x54u8, 0x53u8, 0x52u8, 0x51u8,
        0x64u8, 0x63u8, 0x62u8, 0x61u8,
        0x74u8, 0x73u8, 0x72u8, 0x71u8,
        0x84u8, 0x83u8, 0x82u8, 0x81u8,
        0x94u8, 0x93u8, 0x92u8, 0x91u8,
        0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0u8, 0u8,
        0xFEu8, 0xFFu8, 0xFFu8, 0xFFu8,
        0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0xF0u8, 0x3Fu8,
        0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8,
    ];
    var encoded: [98]u8 = expected;
    let writer = write_code_section(
        ZirlByteWriter {
            bytes: raw encoded[0..98],
            position: 0u64,
            failed: false,
        },
        &raw section
    );
    if (writer.failed or writer.position != 98u64) {
        return 1;
    }
    for (offset in 1u64..98u64) {
        let index = offset - 1;
        if (raw encoded[index] != raw expected[index]) {
            return 2;
        }
    }
    let decoded_expressions: [1]ZirlCompactExpr = [expression];
    let decoded_functions: [0]ZirlCompactFunction = [];
    let decoded_globals: [0]ZirlCodeGlobal = [];
    let decoded_vtables: [0]ZirlCodeVTable = [];
    let decoded_mappings: [0]ZirlCanonicalMapping = [];
    var storage = ZirlCodeStorage {
        expressions: raw decoded_expressions[0..1],
        expression_args: raw no_ids[0..0],
        expression_arg_types: raw no_ids[0..0],
        expression_integers: raw no_u64s[0..0],
        functions: raw decoded_functions[0..0],
        function_parameter_type_ids: raw no_ids[0..0],
        function_parameter_name_ids: raw no_ids[0..0],
        function_parameter_slot_ids: raw no_ids[0..0],
        blocks: raw no_blocks[0..0],
        block_instructions: raw no_ids[0..0],
        globals: raw decoded_globals[0..0],
        vtables: raw decoded_vtables[0..0],
        vtable_function_name_ids: raw no_ids[0..0],
        vtable_function_signature_type_ids: raw no_ids[0..0],
        canonical_mappings: raw decoded_mappings[0..0],
    };
    let full_reader = ZirlByteReader {
        bytes: raw encoded[0..98],
        position: 0u64,
        failed: false,
    };
    let decoded = read_code_section(full_reader, &raw storage);
    if (decoded.reader.failed or decoded.reader.position != 98u64 or
        @lengthOf(decoded.value.expressions) != 1u64 or
        @lengthOf(decoded.value.functions) != 0u64 or
        @lengthOf(decoded.value.globals) != 0u64) {
        return 3;
    }
    let decoded_expression = must decoded.value.expressions[0];
    if (decoded_expression.kind != 0u8 or
        decoded_expression.op != 2u8 or decoded_expression.flags != 3u8 or
        decoded_expression.safety != ZirlCompactSafetyMode.Raw or
        decoded_expression.variadic_slice_param != 0xFFFFFFFFu32 or
        decoded_expression.is_variadic_slice or
        decoded_expression.auto_collect_tail or
        decoded_expression.type_id != 0x01020304u32 or
        decoded_expression.ref_a != 0x11121314u32 or
        decoded_expression.ref_f != 0x61626364u32 or
        decoded_expression.name_id != 0x71727374u32 or
        decoded_expression.resolved_function_name_id != 0x81828384u32 or
        decoded_expression.resolved_function_signature_type_id != 0x91929394u32 or
        decoded_expression.int_value != -2i64 or
        decoded_expression.float_value != 1.0 or
        @lengthOf(decoded_expression.args) != 0u64 or
        @lengthOf(decoded_expression.arg_types) != 0u64 or
        @lengthOf(decoded_expression.integers) != 0u64) {
        return 4;
    }

    let truncated = read_code_section(
        ZirlByteReader {
            bytes: raw encoded[0..97],
            position: 0u64,
            failed: false,
        },
        &raw storage
    );
    if (not truncated.reader.failed or truncated.reader.position != 0u64 or
        @lengthOf(truncated.value.expressions) != 0u64) {
        return 5;
    }

    raw encoded[4u64] = 0xFFu8;
    let invalid_kind = read_code_section(full_reader, &raw storage);
    if (not invalid_kind.reader.failed or invalid_kind.reader.position != 0u64) {
        raw encoded[4u64] = 0u8;
        return 6;
    }
    raw encoded[4u64] = 0u8;
    raw encoded[7u64] = 4u8;
    let invalid_safety = read_code_section(full_reader, &raw storage);
    if (not invalid_safety.reader.failed or invalid_safety.reader.position != 0u64) {
        raw encoded[7u64] = 3u8;
        return 7;
    }
    raw encoded[7u64] = 3u8;

    raw encoded[52u64] = 2u8;
    let invalid_variadic_flag = read_code_section(full_reader, &raw storage);
    if (not invalid_variadic_flag.reader.failed or
        invalid_variadic_flag.reader.position != 0u64) {
        raw encoded[52u64] = 0u8;
        return 9;
    }
    raw encoded[52u64] = 0u8;

    let short_writer = write_code_section(
        ZirlByteWriter {
            bytes: raw encoded[0..97],
            position: 0u64,
            failed: false,
        },
        &raw section
    );
    if (not short_writer.failed) {
        return 8;
    }
    return 0;
}

fn test_zirl_code_tables_roundtrip(): i32 {
    let args: [2]u32 = [2u32, 3u32];
    let argument_types: [1]u32 = [4u32];
    let integer_values: [2]u64 = [0x0102030405060708u64, 0x1112131415161718u64];
    let expression = ZirlCompactExpr {
        kind: ZirlCompactExprKind.Call as u8,
        op: 5u8,
        flags: 6u8,
        safety: ZirlCompactSafetyMode.Guarded,
        type_id: 7u32,
        ref_a: 8u32,
        ref_b: 9u32,
        ref_c: 10u32,
        ref_d: 11u32,
        ref_e: 12u32,
        ref_f: 13u32,
        name_id: 14u32,
        resolved_function_name_id: 15u32,
        resolved_function_signature_type_id: 16u32,
        variadic_slice_param: 37u32,
        is_variadic_slice: true,
        auto_collect_tail: true,
        int_value: -17i64,
        float_value: 2.5,
        args: raw args[0..2],
        arg_types: raw argument_types[0..1],
        integers: raw integer_values[0..2],
    };
    let expressions: [1]ZirlCompactExpr = [expression];

    let function_parameter_types: [1]u32 = [21u32];
    let function_parameter_names: [1]u32 = [22u32];
    let function_parameter_slots: [1]u32 = [23u32];
    let block_instructions: [2]u32 = [0u32, 1u32];
    let blocks: [1]ZirlCompactBasicBlock = [
        ZirlCompactBasicBlock {
            instructions: raw block_instructions[0..2],
            terminator: 24u32,
        },
    ];
    let functions: [1]ZirlCompactFunction = [
        ZirlCompactFunction {
            name_id: 18u32,
            signature_type_id: 19u32,
            is_extern: true,
            is_foreign_c: false,
            is_variadic: true,
            is_state: false,
            uses_tail_calling_convention: true,
            discardable: true,
            return_type_id: 20u32,
            machine_return_type_id: 25u32,
            machine_id: 26u32,
            instance_index: 27u32,
            variadic_slice_param: 28u32,
            foreign_adapter_name_id: 29u32,
            parameter_type_ids: raw function_parameter_types[0..1],
            parameter_name_ids: raw function_parameter_names[0..1],
            parameter_slot_ids: raw function_parameter_slots[0..1],
            blocks: raw blocks[0..1],
        },
    ];
    let globals: [1]ZirlCodeGlobal = [
        ZirlCodeGlobal { name_id: 30u32, type_id: 31u32, initializer: 32u32 },
    ];
    let vtable_names: [1]u32 = [33u32];
    let vtable_signatures: [1]u32 = [34u32];
    let vtables: [1]ZirlCodeVTable = [
        ZirlCodeVTable {
            name_id: 35u32,
            slot_function_name_ids: raw vtable_names[0..1],
            slot_function_signature_type_ids: raw vtable_signatures[0..1],
        },
    ];
    let mappings: [1]ZirlCanonicalMapping = [
        ZirlCanonicalMapping {
            canonical_hi: 0x0102030405060708u64,
            canonical_lo: 0x1112131415161718u64,
            runtime_id: 36u32,
        },
    ];
    let section = ZirlCodeSection {
        expressions: raw expressions[0..1],
        functions: raw functions[0..1],
        globals: raw globals[0..1],
        vtables: raw vtables[0..1],
        canonical_mappings: raw mappings[0..1],
    };

    let encoded_option: ?*u8 = calloc(512u64, 1u64) as ?*u8;
    if (encoded_option is null) {
        return 1;
    }
    var encoded: *u8 = must encoded_option;
    let writer = write_code_section(
        ZirlByteWriter {
            bytes: raw encoded[0u64..512u64],
            position: 0u64,
            failed: false,
        },
        &raw section
    );
    if (writer.failed or writer.position == 0u64) {
        free(encoded);
        return 2;
    }

    let mismatched_names: [1]u32 = [35u32];
    let no_signatures: [0]u32 = [];
    let mismatched_vtables: [1]ZirlCodeVTable = [
        ZirlCodeVTable {
            name_id: 35u32,
            slot_function_name_ids: raw mismatched_names[0..1],
            slot_function_signature_type_ids: raw no_signatures[0..0],
        },
    ];
    let mismatched_section = ZirlCodeSection {
        expressions: raw expressions[0..0],
        functions: raw functions[0..0],
        globals: raw globals[0..0],
        vtables: raw mismatched_vtables[0..1],
        canonical_mappings: raw mappings[0..0],
    };
    let rejected_vtable = write_code_section(
        ZirlByteWriter {
            bytes: raw encoded[0u64..512u64],
            position: 0u64,
            failed: false,
        },
        &raw mismatched_section
    );
    if (not rejected_vtable.failed or rejected_vtable.position != 0u64) {
        free(encoded);
        return 3;
    }

    let decoded_expressions: [1]ZirlCompactExpr = [expression];
    let decoded_args: [2]u32 = [0u32, 0u32];
    let decoded_arg_types: [1]u32 = [0u32];
    let decoded_integers: [2]u64 = [0u64, 0u64];
    let original_function = must functions[0];
    let decoded_functions: [1]ZirlCompactFunction = [original_function];
    let decoded_parameter_types: [1]u32 = [0u32];
    let decoded_parameter_names: [1]u32 = [0u32];
    let decoded_parameter_slots: [1]u32 = [0u32];
    let original_block = must blocks[0];
    let decoded_blocks: [1]ZirlCompactBasicBlock = [original_block];
    let decoded_block_instructions: [2]u32 = [0u32, 0u32];
    let original_global = must globals[0];
    let decoded_globals: [1]ZirlCodeGlobal = [original_global];
    let original_vtable = must vtables[0];
    let decoded_vtables: [1]ZirlCodeVTable = [original_vtable];
    let decoded_vtable_names: [1]u32 = [0u32];
    let decoded_vtable_signatures: [1]u32 = [0u32];
    let original_mapping = must mappings[0];
    let decoded_mappings: [1]ZirlCanonicalMapping = [original_mapping];
    var storage = ZirlCodeStorage {
        expressions: raw decoded_expressions[0..1],
        expression_args: raw decoded_args[0..2],
        expression_arg_types: raw decoded_arg_types[0..1],
        expression_integers: raw decoded_integers[0..2],
        functions: raw decoded_functions[0..1],
        function_parameter_type_ids: raw decoded_parameter_types[0..1],
        function_parameter_name_ids: raw decoded_parameter_names[0..1],
        function_parameter_slot_ids: raw decoded_parameter_slots[0..1],
        blocks: raw decoded_blocks[0..1],
        block_instructions: raw decoded_block_instructions[0..2],
        globals: raw decoded_globals[0..1],
        vtables: raw decoded_vtables[0..1],
        vtable_function_name_ids: raw decoded_vtable_names[0..1],
        vtable_function_signature_type_ids: raw decoded_vtable_signatures[0..1],
        canonical_mappings: raw decoded_mappings[0..1],
    };
    let reader = ZirlByteReader {
        bytes: raw encoded[0u64..writer.position],
        position: 0u64,
        failed: false,
    };
    let decoded = read_code_section(reader, &raw storage);
    if (decoded.reader.failed or decoded.reader.position != writer.position or
        @lengthOf(decoded.value.expressions) != 1u64 or
        @lengthOf(decoded.value.functions) != 1u64 or
        @lengthOf(decoded.value.globals) != 1u64 or
        @lengthOf(decoded.value.vtables) != 1u64 or
        @lengthOf(decoded.value.canonical_mappings) != 1u64) {
        free(encoded);
        return 3;
    }
    let decoded_expression = must decoded.value.expressions[0];
    let decoded_function = must decoded.value.functions[0];
    let decoded_block = must decoded_function.blocks[0];
    let decoded_global = must decoded.value.globals[0];
    let decoded_vtable = must decoded.value.vtables[0];
    let decoded_mapping = must decoded.value.canonical_mappings[0];
    if (decoded_expression.kind != (ZirlCompactExprKind.Call as u8) or
        decoded_expression.op != 5u8 or decoded_expression.flags != 6u8 or
        decoded_expression.safety != ZirlCompactSafetyMode.Guarded or
        decoded_expression.type_id != 7u32 or
        decoded_expression.ref_a != 8u32 or decoded_expression.ref_b != 9u32 or
        decoded_expression.ref_c != 10u32 or decoded_expression.ref_d != 11u32 or
        decoded_expression.ref_e != 12u32 or decoded_expression.ref_f != 13u32 or
        decoded_expression.name_id != 14u32 or
        decoded_expression.resolved_function_name_id != 15u32 or
        decoded_expression.resolved_function_signature_type_id != 16u32 or
        decoded_expression.variadic_slice_param != 37u32 or
        not decoded_expression.is_variadic_slice or
        not decoded_expression.auto_collect_tail or
        decoded_expression.int_value != -17i64 or decoded_expression.float_value != 2.5 or
        @lengthOf(decoded_expression.args) != 2u64 or
        raw decoded_expression.args[0] != 2u32 or
        raw decoded_expression.args[1] != 3u32 or
        @lengthOf(decoded_expression.arg_types) != 1u64 or
        raw decoded_expression.arg_types[0] != 4u32 or
        @lengthOf(decoded_expression.integers) != 2u64 or
        raw decoded_expression.integers[1] != 0x1112131415161718u64 or
        decoded_function.name_id != 18u32 or decoded_function.signature_type_id != 19u32 or
        not decoded_function.is_extern or decoded_function.is_foreign_c or
        not decoded_function.is_variadic or decoded_function.is_state or
        not decoded_function.uses_tail_calling_convention or
        not decoded_function.discardable or decoded_function.return_type_id != 20u32 or
        decoded_function.machine_return_type_id != 25u32 or
        decoded_function.machine_id != 26u32 or
        decoded_function.instance_index != 27u32 or
        decoded_function.variadic_slice_param != 28u32 or
        decoded_function.foreign_adapter_name_id != 29u32 or
        @lengthOf(decoded_function.parameter_type_ids) != 1u64 or
        raw decoded_function.parameter_type_ids[0] != 21u32 or
        raw decoded_function.parameter_name_ids[0] != 22u32 or
        raw decoded_function.parameter_slot_ids[0] != 23u32 or
        @lengthOf(decoded_function.blocks) != 1u64 or
        @lengthOf(decoded_block.instructions) != 2u64 or
        raw decoded_block.instructions[1] != 1u32 or
        decoded_block.terminator != 24u32 or
        decoded_global.name_id != 30u32 or decoded_global.type_id != 31u32 or
        decoded_global.initializer != 32u32 or
        decoded_vtable.name_id != 35u32 or
        @lengthOf(decoded_vtable.slot_function_name_ids) != 1u64 or
        raw decoded_vtable.slot_function_name_ids[0] != 33u32 or
        raw decoded_vtable.slot_function_signature_type_ids[0] != 34u32 or
        decoded_mapping.canonical_hi != 0x0102030405060708u64 or
        decoded_mapping.canonical_lo != 0x1112131415161718u64 or
        decoded_mapping.runtime_id != 36u32) {
        free(encoded);
        return 4;
    }

    let reencoded_option: ?*u8 = calloc(512u64, 1u64) as ?*u8;
    if (reencoded_option is null) {
        free(encoded);
        return 5;
    }
    var reencoded: *u8 = must reencoded_option;
    let rewriter = write_code_section(
        ZirlByteWriter {
            bytes: raw reencoded[0u64..512u64],
            position: 0u64,
            failed: false,
        },
        &raw decoded.value
    );
    if (rewriter.failed or rewriter.position != writer.position) {
        free(reencoded);
        free(encoded);
        return 6;
    }
    for (offset in 1u64..writer.position) {
        let index = offset - 1;
        if (raw reencoded[index] != raw encoded[index]) {
            free(reencoded);
            free(encoded);
            return 7;
        }
    }
    free(reencoded);

    var insufficient_storage = storage;
    insufficient_storage.expressions = raw decoded_expressions[0..0];
    let no_expression_capacity = read_code_section(reader, &raw insufficient_storage);
    if (not no_expression_capacity.reader.failed or
        no_expression_capacity.reader.position != 0u64 or
        @lengthOf(no_expression_capacity.value.expressions) != 0u64) {
        free(encoded);
        return 8;
    }

    let truncated = read_code_section(
        ZirlByteReader {
            bytes: raw encoded[0u64..(writer.position - 1)],
            position: 0u64,
            failed: false,
        },
        &raw storage
    );
    if (not truncated.reader.failed or truncated.reader.position != 0u64 or
        @lengthOf(truncated.value.expressions) != 0u64 or
        @lengthOf(truncated.value.functions) != 0u64) {
        free(encoded);
        return 9;
    }
    free(encoded);
    return 0;
}

fn test_zirl_hir_code_projection(): i32 {
    let no_type_args: [1]HirTypeId = [0u32];
    let no_string_args: [1]HirStringId = [0u32];
    var int_type = HirType {
        kind: HirTypeKind.Int,
        width: 32u8,
        flags: 1u8,
        ref0: invalidType,
        ref1: 0u32,
        args: raw no_type_args[0u64..0u64],
        arg_names: raw no_string_args[0u64..0u64],
    };
    int_type.args = raw no_type_args[0u64..0u64];
    int_type.arg_names = raw no_string_args[0u64..0u64];
    let types: [1]HirType = [int_type];
    var literal = HirLiteral {
        value_kind: HirLiteralKind.Integer,
        integer: 17i64,
        float: 0.0,
        boolean: false,
        string_id: invalidString,
        type_id: 0u32,
    };
    // The bootstrap compiler loses some aggregate-initialized fields here.
    literal.value_kind = HirLiteralKind.Integer;
    literal.integer = 17i64;
    literal.float = 0.0;
    literal.boolean = false;
    literal.string_id = invalidString;
    literal.type_id = 0u32;
    let ret = HirRet { value: 0u32 };
    var array_values: [1]HirExprId = [0u32];
    let array_literal = HirArrayLiteral {
        elements: raw array_values[0u64..1u64],
        type_id: 0u32,
    };
    let expressions: [3]HirExpr = [
        HirExpr { literal },
        HirExpr { ret },
        HirExpr { array_literal },
    ];
    var block_instructions: [1]HirExprId = [0u32];
    var block = HirBasicBlock {
        instructions: raw block_instructions[0u64..1u64],
        terminator: 1u32,
    };
    block.instructions = raw block_instructions[0u64..1u64];
    block.terminator = 1u32;
    let blocks: [1]HirBasicBlock = [block];
    let no_parameter_types: [1]HirTypeId = [0u32];
    let no_parameter_names: [1]HirStringId = [0u32];
    let no_parameter_slots: [1]HirSlotId = [0u32];
    var function_parameter_types: [1]HirTypeId = [0u32];
    var function_parameter_names: [1]HirStringId = [0u32];
    let no_compact_blocks: [0]ZirlCompactBasicBlock = [];
    var function = HirFunction {
        name_id: 0u32,
        parameter_types: raw no_parameter_types[0u64..0u64],
        parameter_name_ids: raw no_parameter_names[0u64..0u64],
        parameter_slots: raw no_parameter_slots[0u64..0u64],
        return_type: 0u32,
        state_function: false,
        uses_tail_calling_convention: false,
        machine_return_type: invalidType,
        machine_id: 0u32,
        variadic: false,
        variadic_slice_param: 0xFFFFFFFFu32,
        foreign_c: false,
        has_body: true,
        foreign_adapter_name_id: invalidString,
        blocks: raw blocks[0u64..1u64],
    };
    function.parameter_types = raw function_parameter_types[0u64..1u64];
    function.parameter_name_ids = raw function_parameter_names[0u64..1u64];
    function.parameter_slots = raw no_parameter_slots[0u64..0u64];
    function.return_type = 0u32;
    function.blocks = raw blocks[0u64..1u64];
    let functions: [1]HirFunction = [function];
    let strings: [1][]char = ["main"];
    let proofs: [0]HirSafetyProof = [];
    let module = make_hir_module(
        raw strings[0u64..1u64],
        raw types[0u64..1u64],
        raw expressions[0u64..3u64],
        raw functions[0u64..1u64],
        raw proofs[0u64..0u64]
    );
    let canonical_types_buffer: [2]HirType = [int_type, int_type];
    let canonical_args: [1]HirTypeId = [0u32];
    let canonical_arg_names: [0]HirStringId = [];
    let local_type_ids: [1]ZirlTypeId = [invalidZirlType];
    let signature_type_ids: [1]ZirlTypeId = [invalidZirlType];
    var canonical_storage = ZirlCanonicalTypeStorage {
        types: raw canonical_types_buffer[0u64..2u64],
        type_args: raw canonical_args[0u64..1u64],
        type_arg_names: raw canonical_arg_names[0u64..0u64],
        local_type_ids: raw local_type_ids[0u64..1u64],
        function_signature_type_ids: raw signature_type_ids[0u64..1u64],
    };
    canonical_storage.type_args = raw canonical_args[0u64..1u64];
    canonical_storage.type_arg_names = raw canonical_arg_names[0u64..0u64];
    let canonical = build_zirl_canonical_types(&raw module, &raw canonical_storage);
    if (canonical.failed) {
        return 10 + (canonical.error as i32);
    }
    if (@lengthOf(canonical.types) != 2u64) {
        return 2;
    }
    let no_u64s: [0]u64 = [];
    let output_expressions_seed: [2]ZirlCompactExpr = [
        ZirlCompactExpr {
            kind: ZirlCompactExprKind.Literal as u8,
            op: 0u8,
            flags: 0u8,
            safety: ZirlCompactSafetyMode.RequiredCheck,
            type_id: 0u32,
            ref_a: 0u32,
            ref_b: 0u32,
            ref_c: 0u32,
