fn test_zirl_section_entry_roundtrip(): i32 {
    var output: [24]u8 = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    ];
    var entry = ZirlSectionEntry {
        id: 4u16,
        flags: 1u16,
        schema_version: 1u16,
        reserved: 0u16,
        offset: 0x0102030405060708u64,
        size: 0x1112131415161718u64,
    };
    var entry_writer = ZirlByteWriter {
        bytes: raw output[0..24],
        position: 0,
        failed: false,
    };
    if (not write_section_entry(&raw entry_writer, &raw entry)) {
        return 1;
    }
    var entry_reader = ZirlByteReader {
        bytes: raw output[0..24],
        position: 0,
        failed: false,
    };
    var decoded_entry = ZirlSectionEntry {
        id: 0u16,
        flags: 0u16,
        schema_version: 0u16,
        reserved: 0u16,
        offset: 0u64,
        size: 0u64,
    };
    if (not read_section_entry(&raw entry_reader, &raw decoded_entry)) {
        return 2;
    }
    if (decoded_entry.id != 4u16 or decoded_entry.flags != 1u16 or
        decoded_entry.offset != 0x0102030405060708u64 or
        decoded_entry.size != 0x1112131415161718u64) {
        return 2;
    }
    return 0;
}

fn test_zirl_section_entry_truncation_is_atomic(): i32 {
    var output: [23]u8 = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    ];
    var reader = ZirlByteReader {
        bytes: raw output[0..23],
        position: 0,
        failed: false,
    };
    var entry = ZirlSectionEntry {
        id: 0xAAAau16,
        flags: 0xBBBBu16,
        schema_version: 0xCCCCu16,
        reserved: 0xDDDDu16,
        offset: 0x0102030405060708u64,
        size: 0x1112131415161718u64,
    };
    if (read_section_entry(&raw reader, &raw entry)) {
        return 1;
    }
    if (not reader.failed) {
        return 2;
    }
    if (reader.position != 0u64) {
        return 3;
    }
    if (entry.id != 0xAAAau16) {
        return 4;
    }
    if (entry.flags != 0xBBBBu16) {
        return 5;
    }
    if (entry.offset != 0x0102030405060708u64) {
        return 6;
    }
    if (entry.size != 0x1112131415161718u64) {
        return 7;
    }
    return 0;
}

fn make_zirl_validation_header(): ZirlFileHeader {
    return ZirlFileHeader {
        magic: 0x5A49524Cu32,
        container_version: 20u32,
        hir_schema_version: 1u32,
        endianness: 1u8,
        reserved: 0u8,
        section_count: 6u16,
        header_size: 243u32,
        checksum: 0u32,
        required_features: 7u64,
        optional_features: 0u64,
        source_fingerprint_primary: 0u64,
        source_fingerprint_secondary: 0u64,
        semantic_profile_version: 1u32,
        public_abi_hi: 0u32,
        public_abi_lo: 0u32,
        dependency_count: 0u32,
        declaration_count: 0u32,
        template_count: 0u32,
        function_count: 0u32,
        canonical_path_length: 1u32,
        module_name_length: 1u32,
        semantic_profile_name_length: 1u32,
    };
}

fn make_zirl_validation_entries(): [6]ZirlSectionEntry {
    return [
        ZirlSectionEntry {
            id: 1u16, flags: 1u16, schema_version: 1u16, reserved: 0u16,
            offset: 243u64, size: 4u64,
        },
        ZirlSectionEntry {
            id: 2u16, flags: 1u16, schema_version: 1u16, reserved: 0u16,
            offset: 247u64, size: 4u64,
        },
        ZirlSectionEntry {
            id: 3u16, flags: 1u16, schema_version: 1u16, reserved: 0u16,
            offset: 251u64, size: 4u64,
        },
        ZirlSectionEntry {
            id: 4u16, flags: 1u16, schema_version: 1u16, reserved: 0u16,
            offset: 255u64, size: 4u64,
        },
        ZirlSectionEntry {
            id: 5u16, flags: 1u16, schema_version: 1u16, reserved: 0u16,
            offset: 259u64, size: 4u64,
        },
        ZirlSectionEntry {
            id: 10u16, flags: 0u16, schema_version: 99u16, reserved: 0u16,
            offset: 263u64, size: 4u64,
        },
    ];
}

fn test_zirl_section_table_validation(): i32 {
    var header = make_zirl_validation_header();
    var entries = make_zirl_validation_entries();
    var result = validate_zirl_sections(&raw header, raw entries[0..6], 267u64);
    if (result.error != ZirlValidationError.None) {
        return 1;
    }

    raw entries[5].flags = 1u16;
    result = validate_zirl_sections(&raw header, raw entries[0..6], 267u64);
    if (result.error != ZirlValidationError.UnknownRequiredSection) {
        return 2;
    }

    entries = make_zirl_validation_entries();
    raw entries[0].id = 11u16;
    raw entries[0].flags = 0u16;
    result = validate_zirl_sections(&raw header, raw entries[0..6], 267u64);
    if (result.error != ZirlValidationError.MissingRequiredSection) {
        return 3;
    }

    entries = make_zirl_validation_entries();
    raw entries[1].offset = 245u64;
    result = validate_zirl_sections(&raw header, raw entries[0..6], 267u64);
    if (result.error != ZirlValidationError.OverlappingSections) {
        return 4;
    }

    entries = make_zirl_validation_entries();
    raw entries[4].size = 9u64;
    result = validate_zirl_sections(&raw header, raw entries[0..6], 267u64);
    if (result.error != ZirlValidationError.SectionOutOfBounds) {
        return 5;
    }

    entries = make_zirl_validation_entries();
    raw entries[5].id = 5u16;
    raw entries[5].flags = 1u16;
    raw entries[5].schema_version = 1u16;
    result = validate_zirl_sections(&raw header, raw entries[0..6], 267u64);
    if (result.error != ZirlValidationError.DuplicateSection) {
        return 6;
    }

    entries = make_zirl_validation_entries();
    header.required_features = 7u64 + (1u64 << 63);
    result = validate_zirl_sections(&raw header, raw entries[0..6], 267u64);
    if (result.error != ZirlValidationError.UnsupportedRequiredFeatures) {
        return 7;
    }
    return 0;
}

fn main(): i32 {
    let literal_status = test_hir_literal_variant();
    if (literal_status != 0) {
        return literal_status;
    }
    let empty_status = test_empty_hir_verifies();
    if (empty_status != 0) {
        return empty_status;
    }
    let expression_status = test_nonempty_expression_table_verifies();
    if (expression_status != 0) {
        return expression_status;
    }
    let invalid_literal_status = test_invalid_literal_type_is_rejected();
    if (invalid_literal_status != 0) {
        return invalid_literal_status;
    }
    let required_check_status = test_required_check_without_proof();
    if (required_check_status != 0) {
        return 211;
    }
    let matching_proof_status = test_required_check_proof_operands_match(1);
    if (matching_proof_status != 0) {
        return 212;
    }
    let mismatched_proof_status = test_required_check_proof_operands_match(2);
    if (mismatched_proof_status != 0) {
        return 213;
    }
    let raw_status = test_raw_index_remains_explicit();
    if (raw_status != 0) {
        return 214;
    }
    let valid_guard_status = test_negated_optional_guard(0);
    if (valid_guard_status != 0) {
        return 215;
    }
    if (test_negated_optional_guard(1) != 0) {
        return 216;
    }
    let cache_identity_status = test_cache_identity_ignores_producer();
    if (cache_identity_status != 0) {
        return 217 + cache_identity_status;
    }
    let semantic_mismatch_status = test_cache_identity_rejects_semantic_mismatch();
    if (semantic_mismatch_status != 0) {
        return 218;
    }
    if (test_cache_rejects_invalid_required_features() != 0) {
        return 219;
    }
    if (test_vir_version_compatibility() != 0) {
        return 220;
    }
    if (test_zirl_little_endian_primitives() != 0) {
        return 221;
    }
    if (test_zirl_signed_and_float_primitives() != 0) {
        return 241;
    }
    let type_section_status = test_zirl_type_entry_roundtrip_and_validation();
    if (type_section_status != 0) {
        return 242 + type_section_status;
    }
    if (test_zirl_blob_roundtrip_and_atomic_failures() != 0) {
        return 240;
    }
    if (test_zirl_header_golden_bytes() != 0) {
        return 222;
    }
    if (test_zirl_header_decode_and_truncation() != 0) {
        return 223;
    }
    if (test_zirl_header_truncation() != 0) {
        return 224;
    }
    if (test_zirl_section_entry_roundtrip() != 0) {
        return 225;
    }
    if (test_zirl_section_entry_truncation_is_atomic() != 0) {
        return 226;
    }
    let section_validation_status = test_zirl_section_table_validation();
    if (section_validation_status != 0) {
        return 226 + section_validation_status;
    }
    return 0;
}
