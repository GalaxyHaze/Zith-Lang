    };
    integer_type.kind = HirTypeKind.Int;
    integer_type.args = raw no_arguments[0..0];
    integer_type.arg_names = raw no_names[0..0];
    var array_type = HirType {
        kind: HirTypeKind.Array,
        width: 0,
        flags: 0,
        ref0: 1,
        ref1: 4,
        args: raw no_arguments[0..0],
        arg_names: raw no_names[0..0],
    };
    array_type.kind = HirTypeKind.Array;
    array_type.ref0 = 0;
    array_type.args = raw no_arguments[0..0];
    array_type.arg_names = raw no_names[0..0];
    let types: [2]HirType = [integer_type, array_type];
    var object = HirLiteral {
        value_kind: HirLiteralKind.Integer,
        integer: 0,
        float: 0.0,
        boolean: false,
        string_id: invalidString,
        type_id: 1,
    };
    object.value_kind = HirLiteralKind.Integer;
    object.integer = 0;
    object.string_id = invalidString;
    object.type_id = 1;
    var index_value = HirLiteral {
        value_kind: HirLiteralKind.Integer,
        integer: 1,
        float: 0.0,
        boolean: false,
        string_id: invalidString,
        type_id: 1,
    };
    index_value.value_kind = HirLiteralKind.Integer;
    index_value.integer = 1;
    index_value.string_id = invalidString;
    index_value.type_id = 0;
    var access = HirIndex {
        object: 1,
        index: 1,
        type_id: 1,
        object_type: 1,
        is_array: true,
        safety: HirSafetyMode.Raw,
    };
    access.object = 0;
    access.type_id = 0;
    let expressions: [3]HirExpr = [
        HirExpr { object },
        HirExpr { index_value },
        HirExpr { access },
    ];
    let strings: [0][]char = [];
    let functions: [0]HirFunction = [];
    let proofs: [0]HirSafetyProof = [];
