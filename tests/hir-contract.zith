from cache/zirl-canonical-types
from cache/zirl-hir-code

extern fn calloc(count: u64, size: u64): raw opaque
extern fn free(ptr: raw opaque): void

fn make_hir_module(
    strings: [][]char,
    types: []HirType,
    expressions: []HirExpr,
    functions: []HirFunction,
    proofs: []HirSafetyProof
): HirModule {
    let declarations: [0]HirDeclaration = [];
    let templates: [0]HirTemplate = [];
    let struct_defs: [0]HirStructDef = [];
    let enum_defs: [0]HirEnumDef = [];
    let union_defs: [0]HirUnionDef = [];
    let global_constants: [0]HirGlobalConst = [];
    let vtables: [0]HirVTable = [];
    let slot_attrs: [0]HirSlotAttrs = [];
    let call_attrs: [0]HirCallAttrs = [];
    let function_attrs: [0]HirFunctionAttrs = [];
    return HirModule {
        strings: strings,
        types: types,
        struct_defs: raw struct_defs[0..0],
        enum_defs: raw enum_defs[0..0],
        union_defs: raw union_defs[0..0],
        expressions: expressions,
        functions: functions,
        declarations: raw declarations[0..0],
        templates: raw templates[0..0],
        global_constants: raw global_constants[0..0],
        vtables: raw vtables[0..0],
        slot_attrs: raw slot_attrs[0..0],
        call_attrs: raw call_attrs[0..0],
        function_attrs: raw function_attrs[0..0],
        safety_attrs: HirSafetyAttrs { proofs: proofs },
    };
}

fn empty_hir_module(): HirModule {
    let strings: [0][]char = [];
    let types: [0]HirType = [];
    let expressions: [0]HirExpr = [];
    let functions: [0]HirFunction = [];
    let proofs: [0]HirSafetyProof = [];
    return make_hir_module(
        raw strings[0..0],
        raw types[0..0],
        raw expressions[0..0],
        raw functions[0..0],
        raw proofs[0..0]
    );
}

fn verify_declaration_template_fixture(
    strings: [][]char,
    types: []HirType,
    declarations: []HirDeclaration,
    templates: []HirTemplate
): HirVerificationResult {
    var module = empty_hir_module();
    module.strings = strings;
    module.types = types;
    module.declarations = declarations;
    module.templates = templates;
    return verify_hir(&module);
}

fn test_hir_declaration_template_contract(): i32 {
    let strings: [5][]char = ["Container", "T", "Readable", "value", "method"];
    let no_type_ids: [0]HirTypeId = [];
    let no_string_ids: [0]HirStringId = [];
    let types: [2]HirType = [
        HirType {
            kind: HirTypeKind.Void,
            width: 0u8,
            flags: 0u8,
            ref0: 0u32,
            ref1: 0u32,
            args: raw no_type_ids[0..0],
            arg_names: raw no_string_ids[0..0],
        },
        HirType {
            kind: HirTypeKind.Trait,
            width: 0u8,
            flags: 0u8,
            ref0: 2u32,
            ref1: 0u32,
            args: raw no_type_ids[0..0],
            arg_names: raw no_string_ids[0..0],
        },
    ];
    let no_members: [0]HirDeclarationId = [];
    var declaration_methods: [1]HirDeclarationId = [1u32];
    var declarations: [2]HirDeclaration = [
        HirDeclaration {
            name_id: 0u32,
            kind: HirDeclarationKind.Struct,
            visibility: HirVisibility.Public,
            module_depth: 0i32,
            type_id: invalidType,
            is_extern: false,
            discardable: false,
            body_function_id: invalidFunction,
            template_id: 0u32,
            members: raw no_members[0..0],
            method_declaration_ids: raw declaration_methods[0..1],
        },
        HirDeclaration {
            name_id: 4u32,
            kind: HirDeclarationKind.Function,
            visibility: HirVisibility.Private,
            module_depth: 1i32,
            type_id: invalidType,
            is_extern: false,
            discardable: false,
            body_function_id: invalidFunction,
            template_id: invalidTemplate,
            members: raw no_members[0..0],
            method_declaration_ids: raw no_members[0..0],
        },
    ];
    let trait_bounds: [1]HirTypeId = [1u32];
    let params: [1]HirGenericParam = [
        HirGenericParam {
            name_id: 1u32,
            bound_type_ids: raw trait_bounds[0..1],
        },
    ];
    let no_signature_types: [0]HirTypeId = [];
    let no_signature_names: [0]HirStringId = [];
    let field_names: [1]HirStringId = [3u32];
    let field_types: [1]HirTypeId = [0u32];
    var field_order: [1]u32 = [0u32];
    var template_methods: [1]HirDeclarationId = [1u32];
    var trait_types: [1]HirTypeId = [1u32];
    var templates: [1]HirTemplate = [
        HirTemplate {
            declaration_id: 0u32,
            function_id: invalidFunction,
            kind: HirDeclarationKind.Struct,
            is_extern: false,
            name_id: 0u32,
            return_type_id: invalidType,
            params: raw params[0..1],
            param_type_ids: raw no_signature_types[0..0],
            param_name_ids: raw no_signature_names[0..0],
            field_name_ids: raw field_names[0..1],
            field_type_ids: raw field_types[0..1],
            canonical_field_order: raw field_order[0..1],
            method_declaration_indices: raw template_methods[0..1],
            trait_type_ids: raw trait_types[0..1],
        },
    ];
    let valid = verify_declaration_template_fixture(
        raw strings[0..5],
        raw types[0..2],
        raw declarations[0..2],
        raw templates[0..1]
    );
    if (valid.error != HirVerifyError.None) {
        return 1;
    }

    var declaration_value: HirDeclaration = raw declarations[0];
    declaration_value.body_function_id = 9u32;
    let invalid_function_declarations: [2]HirDeclaration = [
        declaration_value,
        raw declarations[1],
    ];
    let invalid_function_link = verify_declaration_template_fixture(
        raw strings[0..5], raw types[0..2],
        raw invalid_function_declarations[0..2], raw templates[0..1]
    );
    if (invalid_function_link.error != HirVerifyError.InvalidDeclarationReference) {
        return 2;
    }

    var template_value: HirTemplate = raw templates[0];
    template_value.function_id = 9u32;
    let invalid_function_templates: [1]HirTemplate = [template_value];
    let invalid_template_function = verify_declaration_template_fixture(
        raw strings[0..5], raw types[0..2],
        raw declarations[0..2], raw invalid_function_templates[0..1]
    );
    if (invalid_template_function.error != HirVerifyError.InvalidTemplateShape) {
        return 3;
    }

    let invalid_template_id_declarations: [2]HirDeclaration = [
        HirDeclaration {
            name_id: 0u32,
            kind: HirDeclarationKind.Struct,
            visibility: HirVisibility.Public,
            module_depth: 0i32,
            type_id: invalidType,
            is_extern: false,
            discardable: false,
            body_function_id: invalidFunction,
            template_id: 9u32,
            members: raw no_members[0..0],
            method_declaration_ids: raw declaration_methods[0..1],
        },
        raw declarations[1],
    ];
    let invalid_template_id = verify_declaration_template_fixture(
        raw strings[0..5], raw types[0..2],
        raw invalid_template_id_declarations[0..2], raw templates[0..1]
    );
    if (invalid_template_id.error != HirVerifyError.InvalidDeclarationReference) {
        return 4;
    }

    let broken_owner_declarations: [2]HirDeclaration = [
        HirDeclaration {
            name_id: 0u32,
            kind: HirDeclarationKind.Struct,
            visibility: HirVisibility.Public,
            module_depth: 0i32,
            type_id: invalidType,
            is_extern: false,
            discardable: false,
            body_function_id: invalidFunction,
            template_id: invalidTemplate,
            members: raw no_members[0..0],
            method_declaration_ids: raw declaration_methods[0..1],
        },
        raw declarations[1],
    ];
    let broken_owner = verify_declaration_template_fixture(
        raw strings[0..5], raw types[0..2],
        raw broken_owner_declarations[0..2], raw templates[0..1]
    );
    if (broken_owner.error != HirVerifyError.InvalidTemplateReference) {
        return 5;
    }

    template_value = raw templates[0];
    template_value.field_type_ids = raw no_type_ids[0..0];
    let mismatched_templates: [1]HirTemplate = [template_value];
    let mismatch_probe: HirTemplate = raw mismatched_templates[0];
    if (@lengthOf(mismatch_probe.field_type_ids) != 0u64 or
        @lengthOf(mismatch_probe.field_name_ids) != 1u64) {
        return 91;
    }
    var mismatched_module = empty_hir_module();
    mismatched_module.strings = raw strings[0..5];
    mismatched_module.types = raw types[0..2];
    mismatched_module.declarations = raw declarations[0..2];
    mismatched_module.templates = raw mismatched_templates[0..1];
    let mismatched_fields = verify_hir(&mismatched_module);
    if (mismatched_fields.error != HirVerifyError.InvalidTemplateShape) {
        return 6;
    }

    let invalid_order: [1]u32 = [1u32];
    template_value = raw templates[0];
    template_value.canonical_field_order = raw invalid_order[0..1];
    let invalid_order_templates: [1]HirTemplate = [template_value];
    let invalid_field_order = verify_declaration_template_fixture(
        raw strings[0..5], raw types[0..2],
        raw declarations[0..2], raw invalid_order_templates[0..1]
    );
    if (invalid_field_order.error != HirVerifyError.InvalidTemplateShape) {
        return 7;
    }

    let invalid_method_ids: [1]HirDeclarationId = [9u32];
    declaration_value = raw declarations[0];
    declaration_value.method_declaration_ids = raw invalid_method_ids[0..1];
    let invalid_method_declarations: [2]HirDeclaration = [
        declaration_value,
        raw declarations[1],
    ];
    let invalid_declaration_method = verify_declaration_template_fixture(
        raw strings[0..5], raw types[0..2],
        raw invalid_method_declarations[0..2], raw templates[0..1]
    );
    if (invalid_declaration_method.error != HirVerifyError.InvalidDeclarationReference) {
        return 8;
    }

    let inconsistent_method_ids: [1]HirDeclarationId = [0u32];
    template_value = raw templates[0];
    template_value.method_declaration_indices =
        raw inconsistent_method_ids[0..1];
    let inconsistent_templates: [1]HirTemplate = [template_value];
    let invalid_template_method = verify_declaration_template_fixture(
        raw strings[0..5], raw types[0..2],
        raw declarations[0..2], raw inconsistent_templates[0..1]
    );
    if (invalid_template_method.error != HirVerifyError.InvalidTemplateReference) {
        return 9;
    }

    let non_trait_types: [1]HirTypeId = [0u32];
    template_value = raw templates[0];
    template_value.trait_type_ids = raw non_trait_types[0..1];
    let non_trait_templates: [1]HirTemplate = [template_value];
    let non_trait_reference = verify_declaration_template_fixture(
        raw strings[0..5], raw types[0..2],
        raw declarations[0..2], raw non_trait_templates[0..1]
    );
    if (non_trait_reference.error != HirVerifyError.InvalidTypeReference) {
        return 10;
    }
    return 0;
}

fn test_nominal_types_use_definition_tables(): i32 {
    let strings: [2][]char = ["Node", "value"];
    let no_type_ids: [1]HirTypeId = [invalidType];
    let no_string_ids: [1]HirStringId = [invalidString];
    var struct_type = HirType {
        kind: HirTypeKind.Struct,
        width: 0u8,
        flags: 0u8,
        ref0: 0u32,
        ref1: 0u32,
        args: raw no_type_ids[0..0],
        arg_names: raw no_string_ids[0..0],
    };
    struct_type.kind = HirTypeKind.Struct;
    struct_type.ref0 = 0u32;
    struct_type.args = raw no_type_ids[0..0];
    struct_type.arg_names = raw no_string_ids[0..0];
    let types: [1]HirType = [struct_type];
    let field_names: [1]HirStringId = [1u32];
    let field_types: [1]HirTypeId = [0u32];
    let field_offsets: [1]u64 = [0u64];
    let type_args: [1]HirTypeId = [0u32];
    let struct_def = HirStructDef {
        name_id: 0u32,
        field_name_ids: raw field_names[0..1],
        field_type_ids: raw field_types[0..1],
        foreign_field_offsets: raw field_offsets[0..1],
        type_arg_ids: raw type_args[0..1],
        has_foreign_layout: false,
        foreign_abi_is_single_i64: false,
        foreign_size_bytes: 0u64,
        foreign_align_bytes: 0u64,
    };
    let struct_defs: [1]HirStructDef = [struct_def];
    var valid_module = empty_hir_module();
    valid_module.strings = raw strings[0..2];
    valid_module.types = raw types[0..1];
    valid_module.struct_defs = raw struct_defs[0..1];
    let valid = verify_hir(&valid_module);
    if (valid.error != HirVerifyError.None) {
        return 1;
    }

    let invalid_type_args: [1]HirTypeId = [9u32];
    var invalid_struct_def = struct_def;
    invalid_struct_def.type_arg_ids = raw invalid_type_args[0..1];
    let invalid_struct_defs: [1]HirStructDef = [invalid_struct_def];
    var invalid_argument_module = empty_hir_module();
    invalid_argument_module.strings = raw strings[0..2];
    invalid_argument_module.types = raw types[0..1];
    invalid_argument_module.struct_defs = raw invalid_struct_defs[0..1];
    let invalid_argument = verify_hir(&invalid_argument_module);
    if (invalid_argument.error != HirVerifyError.InvalidTypeReference) {
        return 2;
    }

    var invalid_struct_type = struct_type;
    invalid_struct_type.ref0 = 1u32;
    let invalid_types: [1]HirType = [invalid_struct_type];
    var invalid_definition_module = empty_hir_module();
    invalid_definition_module.strings = raw strings[0..2];
    invalid_definition_module.types = raw invalid_types[0..1];
    invalid_definition_module.struct_defs = raw struct_defs[0..1];
    let invalid_definition = verify_hir(&invalid_definition_module);
    if (invalid_definition.error == HirVerifyError.InvalidDefinitionReference and
        invalid_definition.index == 0u32) {
        return 0;
    }
    return 3;
}

fn test_hir_literal_variant(): i32 {
    let literal: HirLiteral = HirLiteral {
        value_kind: HirLiteralKind.Integer,
        integer: 17,
        float: 0.0,
        boolean: false,
        string_id: invalidString,
        type_id: invalidType,
    };
    let payload: HirExpr = HirExpr { literal };
    if (payload is HirLiteral) {
        return 0;
    }
    return 2;
}

fn test_empty_hir_verifies(): i32 {
    let module = empty_hir_module();
    let result = verify_hir(&module);
    if (result.error == HirVerifyError.None) {
        return 0;
    }
    return 3;
}

fn test_nonempty_expression_table_verifies(): i32 {
    let jump_node = HirJump { target: 0 };
    let expression: HirExpr = HirExpr { jump_node };
    let expressions: [1]HirExpr = [expression];
    let strings: [0][]char = [];
    let types: [0]HirType = [];
    let functions: [0]HirFunction = [];
    let proofs: [0]HirSafetyProof = [];
    let module = make_hir_module(
        raw strings[0..0],
        raw types[0..0],
        raw expressions[0..1],
        raw functions[0..0],
        raw proofs[0..0]
    );
    let result = verify_hir(&module);
    if (result.error == HirVerifyError.None) {
        return 0;
    }
    return 4;
}

fn test_runtime_panic_expression_verifies(): i32 {
    let runtime_panic = HirRuntimePanic { code: 7u32 };
    let expressions: [1]HirExpr = [HirExpr { runtime_panic }];
    let strings: [0][]char = [];
    let types: [0]HirType = [];
    let functions: [0]HirFunction = [];
    let proofs: [0]HirSafetyProof = [];
    let module = make_hir_module(
        raw strings[0u64..0u64],
        raw types[0u64..0u64],
        raw expressions[0u64..1u64],
        raw functions[0u64..0u64],
        raw proofs[0u64..0u64]
    );
    let result = verify_hir(&module);
    if (result.error == HirVerifyError.None) {
        return 0;
    }
    return 7;
}

