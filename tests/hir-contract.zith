    let functions: [0]HirFunction = [];
    let proofs: [0]HirSafetyProof = [];
    let module = make_hir_module(
        raw strings[0..0],
        raw types[0..0],
        raw expressions[0..1],
        raw functions[0..0],
        raw proofs[0..0]
    );
    let result = verify_hir(&module);
    if (result.error == HirVerifyError.InvalidExpressionShape) {
