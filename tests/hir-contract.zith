    var truncated_storage = ZirlMetadataStorage {
        module_name: raw module_name_buffer[0..16],
        name_scratch: raw name_scratch[0..16],
        paths: raw path_values[0..1],
        path_bytes: raw path_bytes[0..32],
        strings: raw string_values[0..4],
        string_bytes: raw string_bytes[0..32],
        types: raw output_types[0..2],
        type_args: raw output_type_args[0..2],
        type_arg_names: raw output_type_arg_names[0..1],
        struct_defs: raw output_struct_defs[0..1],
        struct_field_names: raw empty_string_ids[0..1],
        struct_field_types: raw empty_type_ids[0..1],
        struct_foreign_offsets: raw empty_offsets[0..1],
        struct_type_args: raw empty_type_ids[0..1],
