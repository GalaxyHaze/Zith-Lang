from ir/hir
from ir/hir-verify
from cache/cache
from cache/zirl-buffer
from cache/zirl-container
from cache/zirl-type-section

fn make_hir_module(
    strings: [][]char,
    types: []HirType,
    expressions: []HirExpr,
    functions: []HirFunction,
    proofs: []HirSafetyProof
): HirModule {
    let declarations: [0]HirDeclaration = [];
    let global_constants: [0]HirGlobalConst = [];
    let vtables: [0]HirVTable = [];
    let slot_attrs: [0]HirSlotAttrs = [];
    let call_attrs: [0]HirCallAttrs = [];
    let function_attrs: [0]HirFunctionAttrs = [];
    return HirModule {
        strings: strings,
        types: types,
        expressions: expressions,
        functions: functions,
        declarations: raw declarations[0..0],
        global_constants: raw global_constants[0..0],
        vtables: raw vtables[0..0],
        slot_attrs: raw slot_attrs[0..0],
        call_attrs: raw call_attrs[0..0],
        function_attrs: raw function_attrs[0..0],
        safety_attrs: HirSafetyAttrs { proofs: proofs },
    };
}

fn empty_hir_module(): HirModule {
    let strings: [0][]char = [];
    let types: [0]HirType = [];
    let expressions: [0]HirExpr = [];
    let functions: [0]HirFunction = [];
    let proofs: [0]HirSafetyProof = [];
    return make_hir_module(
        raw strings[0..0],
        raw types[0..0],
        raw expressions[0..0],
        raw functions[0..0],
        raw proofs[0..0]
    );
}

fn test_hir_literal_variant(): i32 {
    let literal: HirLiteral = HirLiteral {
        value_kind: HirLiteralKind.Integer,
        integer: 17,
        float: 0.0,
        boolean: false,
        string_id: invalidString,
        type_id: invalidType,
    };
    let payload: HirExpr = HirExpr { literal };
    if (payload is HirLiteral) {
        return 0;
    }
    return 2;
}

fn test_empty_hir_verifies(): i32 {
    let module = empty_hir_module();
    let result = verify_hir(&module);
    if (result.error == HirVerifyError.None) {
        return 0;
    }
    return 3;
}

fn test_nonempty_expression_table_verifies(): i32 {
    let jump_node = HirJump { target: 0 };
    let expression: HirExpr = HirExpr { jump_node };
    let expressions: [1]HirExpr = [expression];
    let strings: [0][]char = [];
    let types: [0]HirType = [];
    let functions: [0]HirFunction = [];
    let proofs: [0]HirSafetyProof = [];
    let module = make_hir_module(
        raw strings[0..0],
        raw types[0..0],
        raw expressions[0..1],
        raw functions[0..0],
        raw proofs[0..0]
    );
    let result = verify_hir(&module);
    if (result.error == HirVerifyError.None) {
        return 0;
    }
    return 4;
}

fn test_invalid_literal_type_is_rejected(): i32 {
    let literal: HirLiteral = HirLiteral {
