        raw strings[0..0],
        raw types[0..2],
        raw expressions[0..3],
        raw functions[0..0],
        raw proofs[0..0]
    );
    let result = verify_hir(&module);
    let raw_expression: HirExpr = raw module.expressions[2];
    if (result.error != HirVerifyError.None) {
        return 1;
    }
    if (raw_expression is HirIndex) {
        let raw_index: HirIndex = raw_expression;
        if (raw_index.safety == HirSafetyMode.Raw) {
            return 0;
        }
    }
    return 1;
}

fn test_negated_optional_guard(wrong_branch_offset: u32): i32 {
    let no_arguments: [1]HirTypeId = [invalidType];
    let no_names: [1]HirStringId = [invalidString];
    var void_type = HirType {
        kind: HirTypeKind.Void,
        width: 0,
        flags: 0,
        ref0: invalidType,
        ref1: 0,
        args: raw no_arguments[0..0],
        arg_names: raw no_names[0..0],
    };
    void_type.kind = HirTypeKind.Void;
    void_type.args = raw no_arguments[0..0];
    void_type.arg_names = raw no_names[0..0];
    var bool_type = HirType {
        kind: HirTypeKind.Bool,
        width: 0,
        flags: 0,
        ref0: invalidType,
        ref1: 0,
        args: raw no_arguments[0..0],
        arg_names: raw no_names[0..0],
    };
    bool_type.kind = HirTypeKind.Bool;
    bool_type.args = raw no_arguments[0..0];
    bool_type.arg_names = raw no_names[0..0];
    var optional_type = HirType {
        kind: HirTypeKind.Optional,
        width: 0,
        flags: 0,
        ref0: 1,
        ref1: 0,
        args: raw no_arguments[0..0],
        arg_names: raw no_names[0..0],
    };
    optional_type.kind = HirTypeKind.Optional;
    optional_type.args = raw no_arguments[0..0];
    optional_type.arg_names = raw no_names[0..0];
    let types: [3]HirType = [void_type, bool_type, optional_type];

    let slot_address = HirSlotAddr { slot: 0, type_id: 2 };
    let tag_field = HirField {
        object: 0,
        index: 1,
        type_id: 1,
        object_type: 2,
        safety: HirSafetyMode.Intrinsic,
    };
    let negated_tag = HirUnary {
        op: HirUnaryOp.Not,
        operand: 1,
        type_id: 1,
    };
    let branch = HirBranch {
        condition: 2,
        then_block: 1 + wrong_branch_offset,
        else_block: 2 - wrong_branch_offset,
    };
    let ret = HirRet { value: 0xFFFFFFFFu32 };
    let payload = HirField {
        object: 0,
        index: 0,
        type_id: 1,
        object_type: 2,
        safety: HirSafetyMode.Guarded,
    };
    let expressions: [7]HirExpr = [
        HirExpr { slot_address },
        HirExpr { tag_field },
        HirExpr { negated_tag },
        HirExpr { branch },
        HirExpr { ret },
        HirExpr { payload },
        HirExpr { ret },
    ];

    let no_instructions: [0]HirExprId = [];
    let guarded_instruction: [1]HirExprId = [5];
    let then_block = HirBasicBlock {
        instructions: raw no_instructions[0..0],
        terminator: 4,
    };
    let else_block = HirBasicBlock {
        instructions: raw guarded_instruction[0..1],
        terminator: 6,
    };
    let blocks: [3]HirBasicBlock = [
        HirBasicBlock {
            instructions: raw no_instructions[0..0],
            terminator: 3,
        },
        then_block,
        else_block,
    ];
    let no_parameter_types: [0]HirTypeId = [];
    let no_parameter_names: [0]HirStringId = [];
    let no_parameter_slots: [0]HirSlotId = [];
    let function = HirFunction {
        name_id: 0,
        parameter_types: raw no_parameter_types[0..0],
        parameter_name_ids: raw no_parameter_names[0..0],
        parameter_slots: raw no_parameter_slots[0..0],
        return_type: 0,
        state_function: false,
        uses_tail_calling_convention: false,
        machine_return_type: 0xFFFFFFFFu32,
        machine_id: 0,
        variadic: false,
        variadic_slice_param: 0,
        foreign_c: false,
        has_body: true,
        foreign_adapter_name_id: 0xFFFFFFFFu32,
        blocks: raw blocks[0..3],
    };
    let functions: [1]HirFunction = [function];
    let function_name: [1][]char = ["guarded"];
    let proofs: [0]HirSafetyProof = [];
    let module = make_hir_module(
        raw function_name[0..1],
        raw types[0..3],
        raw expressions[0..7],
        raw functions[0..1],
        raw proofs[0..0]
    );

    let result = verify_hir(&module);
    if (wrong_branch_offset == 0) {
        if (result.error == HirVerifyError.None) {
            return 0;
        }
        return 1;
    }
    if (result.error == HirVerifyError.InvalidSafetyGuard) {
        return 0;
    }
    return 1;
}

fn make_cache_identity(
    canonical_module: []char,
    semantic_profile: []char,
    profile_version: u32,
    hir_schema: u32,
    required_features: u64,
    optional_features: u64,
    frontend_dialect: []char
): HirCacheIdentity {
    var identity = HirCacheIdentity {
        canonical_module: "",
        semantic_profile: "",
        semantic_profile_version: 0u32,
        hir_schema_version: 0u32,
        required_features: 0u64,
        optional_features: 0u64,
        frontend_dialect: "",
        frontend_implementation: "fixture",
        frontend_version: "1",
    };
    identity.canonical_module = canonical_module;
    identity.semantic_profile = semantic_profile;
    identity.semantic_profile_version = profile_version;
    identity.hir_schema_version = hir_schema;
    identity.required_features = required_features;
    identity.optional_features = optional_features;
    identity.frontend_dialect = frontend_dialect;
    return identity;
}

fn test_cache_identity_ignores_producer(): i32 {
    let stored = make_cache_identity(
        "pkg/main.zith", "zith-shared-hir", 1u32, 1u32, 7u64, 0u64, "Zith--");
    let expected = make_cache_identity(
        "pkg/main.zith", "zith-shared-hir", 1u32, 1u32, 7u64,
        0xFFFFFFFFFFFFFFFFu64, "Zith");
    if (compare_hir_identity(&stored, &expected) == HirCacheDecision.Compatible) {
        return 0;
    }
    return 1;
}

fn test_cache_identity_rejects_semantic_mismatch(): i32 {
    let stored_module = make_cache_identity(
        "pkg/main.zith", "zith-shared-hir", 1u32, 1u32, 7u64, 0u64, "Zith--");
    let wrong_module = make_cache_identity(
        "pkg/other.zith", "zith-shared-hir", 1u32, 1u32, 7u64, 0u64, "Zith");
    let stored_profile = make_cache_identity(
        "pkg/main.zith", "zith-shared-hir", 1u32, 1u32, 7u64, 0u64, "Zith--");
    let wrong_profile = make_cache_identity(
        "pkg/main.zith", "zith--", 1u32, 1u32, 7u64, 0u64, "Zith");
    let stored_profile_version = make_cache_identity(
        "pkg/main.zith", "zith-shared-hir", 1u32, 1u32, 7u64, 0u64, "Zith--");
    let wrong_profile_version = make_cache_identity(
        "pkg/main.zith", "zith-shared-hir", 2u32, 1u32, 7u64, 0u64, "Zith");
    let stored_schema = make_cache_identity(
        "pkg/main.zith", "zith-shared-hir", 1u32, 1u32, 7u64, 0u64, "Zith--");
    let wrong_schema = make_cache_identity(
        "pkg/main.zith", "zith-shared-hir", 1u32, 2u32, 7u64, 0u64, "Zith");
    if (compare_hir_identity(&stored_module, &wrong_module) != HirCacheDecision.ModuleMismatch) {
        return 1;
    }
    if (compare_hir_identity(&stored_profile, &wrong_profile) !=
        HirCacheDecision.SemanticProfileMismatch) {
        return 2;
    }
    if (compare_hir_identity(&stored_profile_version, &wrong_profile_version) !=
        HirCacheDecision.SemanticProfileMismatch) {
        return 3;
    }
    if (compare_hir_identity(&stored_schema, &wrong_schema) != HirCacheDecision.HirSchemaMismatch) {
        return 4;
    }
    return 0;
}

fn test_cache_rejects_invalid_required_features(): i32 {
    let unknown_features = make_cache_identity(
        "pkg/main.zith", "zith-shared-hir", 1u32, 1u32, 15u64, 0u64, "Zith--");
    let missing = make_cache_identity(
        "pkg/main.zith", "zith-shared-hir", 1u32, 1u32, 3u64, 0u64, "Zith--");
    let expected_for_unknown = make_cache_identity(
        "pkg/main.zith", "zith-shared-hir", 1u32, 1u32, 7u64, 0u64, "Zith");
    if (compare_hir_identity(&unknown_features, &expected_for_unknown) !=
        HirCacheDecision.RequiredFeatureMismatch) {
        return 1;
    }
    let expected_for_missing = make_cache_identity(
        "pkg/main.zith", "zith-shared-hir", 1u32, 1u32, 7u64, 0u64, "Zith");
    if (compare_hir_identity(&missing, &expected_for_missing) !=
        HirCacheDecision.RequiredFeatureMismatch) {
        return 2;
    }
    return 0;
}

fn test_vir_version_compatibility(): i32 {
    if (can_reuse_vir(1, 1) == false) {
        return 1;
    }
    if (can_reuse_vir(2, 1)) {
        return 2;
    }
    if (can_reuse_vir(1, 2)) {
        return 3;
    }
    return 0;
}

fn test_zirl_little_endian_primitives(): i32 {
    var output: [8]u8 = [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8];
    let writer = ZirlByteWriter {
        bytes: raw output[0..8],
        position: 0,
        failed: false,
    };
    let after_u16 = write_u16(writer, 0x1234u16);
    let after_u32 = write_u32(after_u16, 0x89ABCDEFu32);
    if (after_u32.failed or after_u32.position != 6) {
        return 1;
    }
    if (raw output[0] != 0x34u8 or raw output[1] != 0x12u8 or
        raw output[2] != 0xEFu8 or raw output[3] != 0xCDu8 or
        raw output[4] != 0xABu8 or raw output[5] != 0x89u8) {
        return 2;
    }
    let reader = ZirlByteReader {
        bytes: raw output[0..6],
        position: 0,
        failed: false,
    };
    let read_u16_result = read_u16(reader);
    let first_value = read_u16_result.value;
    let read_u32_result = read_u32(read_u16_result.reader);
    if (read_u32_result.reader.failed or first_value != 0x1234u16 or
        read_u32_result.value != 0x89ABCDEFu32 or read_u32_result.reader.position != 6) {
        return 3;
    }
    let short_reader = ZirlByteReader {
        bytes: raw output[0..5],
        position: 0,
        failed: false,
    };
    let truncated = read_u64(short_reader);
    if (not truncated.reader.failed or truncated.reader.position != 5) {
        return 4;
    }
    var short_output: [2]u8 = [0u8, 0u8];
    let short_writer = ZirlByteWriter {
        bytes: raw short_output[0..2],
        position: 0,
        failed: false,
    };
    let short_write = write_u32(short_writer, 0x12345678u32);
    if (not short_write.failed or short_write.position != 2) {
        return 5;
    }
    let invalid_writer = ZirlByteWriter {
        bytes: raw short_output[0..2],
        position: 3,
        failed: false,
    };
    let invalid_write = write_u8(invalid_writer, 0xFFu8);
    if (not invalid_write.failed or invalid_write.position != 3) {
        return 6;
    }
    let invalid_reader = ZirlByteReader {
        bytes: raw short_output[0..2],
        position: 3,
        failed: false,
    };
    let invalid_read = read_u8(invalid_reader);
    if (not invalid_read.reader.failed or invalid_read.reader.position != 3) {
        return 7;
    }
    return 0;
}

fn test_zirl_signed_and_float_primitives(): i32 {
    var output: [20]u8 = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    ];
    let writer = ZirlByteWriter {
        bytes: raw output[0..20],
        position: 0,
        failed: false,
    };
    let after_i32 = write_i32(writer, -2i32);
    let after_i64 = write_i64(after_i32, -3i64);
    let after_f64 = write_f64(after_i64, 1.0);
    if (after_f64.failed or after_f64.position != 20u64) {
        return 1;
    }
    if (raw output[0] != 0xFEu8 or raw output[1] != 0xFFu8 or
        raw output[2] != 0xFFu8 or raw output[3] != 0xFFu8 or
        raw output[4] != 0xFDu8 or raw output[11] != 0xFFu8 or
        raw output[12] != 0u8 or raw output[13] != 0u8 or
        raw output[14] != 0u8 or raw output[15] != 0u8 or
        raw output[16] != 0u8 or raw output[17] != 0u8 or
        raw output[18] != 0xF0u8 or
        raw output[19] != 0x3Fu8) {
        return 2;
    }

    let reader = ZirlByteReader {
        bytes: raw output[0..20],
        position: 0,
        failed: false,
    };
    let decoded_i32 = read_i32(reader);
    let decoded_i64 = read_i64(decoded_i32.reader);
    let decoded_f64 = read_f64(decoded_i64.reader);
    if (decoded_f64.reader.failed or decoded_i32.value != -2i32 or
        decoded_i64.value != -3i64 or decoded_f64.value != 1.0 or
        decoded_f64.reader.position != 20u64) {
        return 3;
    }
    return 0;
}

fn test_zirl_type_entry_roundtrip_and_validation(): i32 {
    let type_args: [2]HirTypeId = [2u32, 0x01020304u32];
    let type_names: [1]HirStringId = [1u32];
    let expected: [32]u8 = [
        5u8, 64u8, 1u8, 0u8,
        0x78u8, 0x56u8, 0x34u8, 0x12u8,
        0xCDu8, 0xABu8, 0u8, 0u8,
        2u8, 0u8, 0u8, 0u8,
        2u8, 0u8, 0u8, 0u8,
        4u8, 3u8, 2u8, 1u8,
        1u8, 0u8, 0u8, 0u8,
        1u8, 0u8, 0u8, 0u8,
    ];
    let input = HirType {
        kind: HirTypeKind.Int,
        width: 64u8,
        flags: 1u8,
        ref0: 0x12345678u32,
        ref1: 0xABCDu32,
        args: raw type_args[0..2],
        arg_names: raw type_names[0..1],
    };
    var output: [32]u8 = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    ];
    let writer = ZirlByteWriter {
        bytes: raw output[0..32],
        position: 0u64,
        failed: false,
    };
    let encoded = write_type_entry(writer, &input);
    if (encoded.failed or encoded.position != 32u64) {
        return 1;
    }
    for (offset in 1u64..32u64) {
        let index = offset - 1;
        if (raw output[index] != raw expected[index]) {
            return 2;
        }
    }

    let reader = ZirlByteReader {
        bytes: raw output[0..32],
        position: 0u64,
        failed: false,
    };
    let no_args: [0]HirTypeId = [];
    let no_names: [0]HirStringId = [];
    var decoded_args: [2]HirTypeId = [0u32, 0u32];
    var decoded_names: [1]HirStringId = [0u32];
    let decoded = read_type_entry(
        reader,
        raw decoded_args[0..2],
        raw decoded_names[0..1]
    );
    if (decoded.reader.failed or decoded.reader.position != 32u64 or
        decoded.value.kind != HirTypeKind.Int or decoded.value.width != 64u8 or
        decoded.value.flags != 1u8 or decoded.value.ref0 != 0x12345678u32 or
        decoded.value.ref1 != 0xABCDu32 or
        @lengthOf(decoded.value.args) != 2u64 or
        raw decoded.value.args[0] != 2u32 or
        raw decoded.value.args[1] != 0x01020304u32 or
        @lengthOf(decoded.value.arg_names) != 1u64 or
        raw decoded.value.arg_names[0] != 1u32) {
        return 3;
    }

    let scalar_expected: [20]u8 = [
        3u8, 0u8, 0u8, 0u8,
        0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8,
        0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8,
    ];
    var scalar_args: [1]HirTypeId = [0u32];
    var scalar_names: [1]HirStringId = [0u32];
    let scalar_source_reader = ZirlByteReader {
        bytes: raw scalar_expected[0u64..20u64],
        position: 0u64,
        failed: false,
    };
    let scalar_decoded = read_type_entry(
        scalar_source_reader,
        raw scalar_args[0u64..1u64],
        raw scalar_names[0u64..1u64]
    );
    if (scalar_decoded.reader.failed or scalar_decoded.reader.position != 20u64 or
        scalar_decoded.value.kind != HirTypeKind.Bool or
        @lengthOf(scalar_decoded.value.args) != 0u64 or
        @lengthOf(scalar_decoded.value.arg_names) != 0u64) {
        return 4;
    }
    let scalar_value = scalar_decoded.value;
    var scalar_bytes: [20]u8 = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
        0u8, 0u8, 0u8, 0u8,
    ];
    let scalar_writer = ZirlByteWriter {
        bytes: raw scalar_bytes[0..20],
        position: 0u64,
        failed: false,
    };
    let scalar_encoded = write_type_entry(scalar_writer, &scalar_value);
    if (scalar_encoded.failed or scalar_encoded.position != 20u64) {
        return 5;
    }
    for (offset in 1u64..20u64) {
        let index = offset - 1;
        if (raw scalar_bytes[index] != raw scalar_expected[index]) {
            return 6;
        }
    }

    let insufficient_buffers = read_type_entry(reader, raw no_args[0..0], raw no_names[0..0]);
    if (not insufficient_buffers.reader.failed or insufficient_buffers.reader.position != 0u64) {
        return 5;
    }
    let truncated_reader = ZirlByteReader {
        bytes: raw output[0..31],
        position: 0u64,
        failed: false,
    };
    raw decoded_args[0] = 0xAAAAAAAAu32;
    raw decoded_args[1] = 0xBBBBBBBBu32;
    raw decoded_names[0] = 0xCCCCCCCCu32;
    let truncated = read_type_entry(
        truncated_reader,
        raw decoded_args[0..2],
        raw decoded_names[0..1]
    );
    if (not truncated.reader.failed or truncated.reader.position != 0u64 or
        raw decoded_args[0] != 0xAAAAAAAAu32 or
        raw decoded_args[1] != 0xBBBBBBBBu32 or
        raw decoded_names[0] != 0xCCCCCCCCu32) {
        return 6;
    }

    raw output[0] = 5u8;
    raw output[3] = 1u8;
    let reserved_reader = ZirlByteReader {
        bytes: raw output[0..32],
        position: 0u64,
        failed: false,
    };
    let reserved = read_type_entry(
        reserved_reader,
        raw decoded_args[0..2],
        raw decoded_names[0..1]
    );
    if (not reserved.reader.failed or reserved.reader.position != 0u64) {
        return 7;
    }

    raw output[0] = 0xFFu8;
    raw output[3] = 0u8;
    let unknown_kind_reader = ZirlByteReader {
        bytes: raw output[0..32],
        position: 0u64,
        failed: false,
    };
    let unknown_kind = read_type_entry(
        unknown_kind_reader,
        raw decoded_args[0..2],
        raw decoded_names[0..1]
    );
    if (not unknown_kind.reader.failed or unknown_kind.reader.position != 0u64) {
        return 8;
    }
    return 0;
}

fn test_zirl_blob_roundtrip_and_atomic_failures(): i32 {
    var output: [9]u8 = [
        0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8,
    ];
    let payload: [5]u8 = [0x10u8, 0x20u8, 0x30u8, 0x40u8, 0x50u8];
    let writer = ZirlByteWriter {
        bytes: raw output[0..9],
        position: 0,
        failed: false,
    };
    let written = write_blob(writer, raw payload[0..5]);
    if (written.failed or written.position != 9u64 or
        raw output[0] != 5u8 or raw output[1] != 0u8 or
        raw output[2] != 0u8 or raw output[3] != 0u8) {
        return 1;
    }

    var decoded: [5]u8 = [0u8, 0u8, 0u8, 0u8, 0u8];
    let reader = ZirlByteReader {
        bytes: raw output[0..9],
        position: 0,
        failed: false,
    };
    let decoded_writer = ZirlByteWriter {
        bytes: raw decoded[0..5],
        position: 0,
        failed: false,
    };
    let read_result = read_blob_into(reader, decoded_writer);
    if (read_result.reader.failed or read_result.length != 5u32 or
        read_result.reader.position != 9u64 or
        read_result.output.failed or read_result.output.position != 5u64) {
        return 2;
    }
    for (offset in 1u64..5u64) {
        let index = offset - 1;
        if (raw decoded[index] != raw payload[index]) {
            return 3;
        }
    }

    var truncated_bytes: [8]u8 = [
        5u8, 0u8, 0u8, 0u8, 0xA1u8, 0xA2u8, 0xA3u8, 0xA4u8,
    ];
    var unchanged: [5]u8 = [
        0xBBu8, 0xBBu8, 0xBBu8, 0xBBu8, 0xBBu8,
    ];
    let truncated_reader = ZirlByteReader {
        bytes: raw truncated_bytes[0..8],
        position: 0,
        failed: false,
    };
    let unchanged_writer = ZirlByteWriter {
        bytes: raw unchanged[0..5],
        position: 0,
        failed: false,
    };
    let truncated = read_blob_into(truncated_reader, unchanged_writer);
    if (not truncated.reader.failed or truncated.reader.position != 0u64 or
        truncated.output.position != 0u64 or
        raw unchanged[0] != 0xBBu8) {
        return 4;
    }

    var small_output: [8]u8 = [
        0xCCu8, 0xCCu8, 0xCCu8, 0xCCu8,
        0xCCu8, 0xCCu8, 0xCCu8, 0xCCu8,
    ];
    let small_writer = ZirlByteWriter {
        bytes: raw small_output[0..8],
        position: 0,
        failed: false,
    };
    let rejected_write = write_blob(small_writer, raw payload[0..5]);
    if (not rejected_write.failed or rejected_write.position != 0u64 or
        raw small_output[0] != 0xCCu8) {
        return 5;
    }

    var short_output: [4]u8 = [0xDDu8, 0xDDu8, 0xDDu8, 0xDDu8];
    let complete_reader = ZirlByteReader {
        bytes: raw output[0..9],
        position: 0,
        failed: false,
    };
    let short_writer = ZirlByteWriter {
        bytes: raw short_output[0..4],
        position: 0,
        failed: false,
    };
    let rejected_read = read_blob_into(complete_reader, short_writer);
    if (not rejected_read.reader.failed or rejected_read.reader.position != 0u64 or
        not rejected_read.output.failed or rejected_read.output.position != 0u64 or
        raw short_output[0] != 0xDDu8) {
        return 6;
    }
    return 0;
}

