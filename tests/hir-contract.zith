    let expression_arg_storage: [1]u32 = [0u32];
    let projected_block_instruction_storage: [1]u32 = [0u32];
    let projected_parameter_type_storage: [1]u32 = [0u32];
    let projected_parameter_name_storage: [1]u32 = [0u32];
    let decoded_expression_arg_storage: [1]u32 = [0u32];
    let decoded_block_instruction_storage: [1]u32 = [0u32];
    let decoded_parameter_type_storage: [1]u32 = [0u32];
    let decoded_parameter_name_storage: [1]u32 = [0u32];
    let output_globals: [0]ZirlCodeGlobal = [];
    let output_vtables: [0]ZirlCodeVTable = [];
    let output_mappings: [0]ZirlCanonicalMapping = [];
    var code_storage = ZirlCodeStorage {
        expressions: raw output_expressions[0u64..3u64],
        expression_args: raw no_parameter_types[0u64..0u64],
        expression_arg_types: raw no_parameter_types[0u64..0u64],
        expression_integers: raw no_u64s[0u64..0u64],
        functions: raw output_functions[0u64..1u64],
