        raw output_expressions_seed[1u64],
        raw output_expressions_seed[1u64],
    ];
    let output_functions: [1]ZirlCompactFunction = [
        ZirlCompactFunction {
            name_id: 0u32,
            signature_type_id: invalidZirlType,
            is_extern: false,
            is_foreign_c: false,
