    let no_declaration_members: [0]HirDeclarationId = [];
    let declaration_members: [2]HirDeclarationId = [2u32, 1u32];
    let declaration_methods: [2]HirDeclarationId = [1u32, 2u32];
    let template_bounds: [2]HirTypeId = [0u32, 4u32];
    let template_params: [2]HirGenericParam = [
