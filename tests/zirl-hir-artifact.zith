    let call_escapes: [1]HirCallEscape = [HirCallEscape.Borrow];
    var call_records: [1]ZirlCallAttrsRecord = [
        ZirlCallAttrsRecord {
            expr_id: 6u32,
            returns_argument: 0xFFFFFFFFu32,
            arg_escapes: raw call_escapes[0u64..1u64],
