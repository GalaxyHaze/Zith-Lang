{
  "version": "0.6.3",
  "description": "The Zith programming language toolchain",
  "homepage": "https://github.com/GalaxyHaze/Zith",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": [
        "https://github.com/GalaxyHaze/Zith/releases/download/v0.6.3/zithc-windows-amd64.exe",
        "https://github.com/GalaxyHaze/Zith/releases/download/v0.6.3/zithc-stdlib-v0.6.3.zip"
      ],
      "hash": [
        "",
        ""
      ]
    },
    "arm64": {
      "url": [
        "https://github.com/GalaxyHaze/Zith/releases/download/v0.6.3/zithc-windows-arm64.exe",
        "https://github.com/GalaxyHaze/Zith/releases/download/v0.6.3/zithc-stdlib-v0.6.3.zip"
      ],
      "hash": [
        "",
        ""
      ]
    }
  },
  "bin": "zithc.exe",
  "checkver": {
    "github": "GalaxyHaze/Zith"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": [
          "https://github.com/GalaxyHaze/Zith/releases/download/v$version/zithc-windows-amd64.exe",
          "https://github.com/GalaxyHaze/Zith/releases/download/v$version/zithc-stdlib-v$version.zip"
        ]
      },
      "arm64": {
        "url": [
          "https://github.com/GalaxyHaze/Zith/releases/download/v$version/zithc-windows-arm64.exe",
          "https://github.com/GalaxyHaze/Zith/releases/download/v$version/zithc-stdlib-v$version.zip"
        ]
      }
    }
  },
  "installer": {
    "script": [
      "if ($architecture -eq '64bit') { Rename-Item \"$dir\\zithc-windows-amd64.exe\" \"zithc.exe\" }",
      "if ($architecture -eq 'arm64') { Rename-Item \"$dir\\zithc-windows-arm64.exe\" \"zithc.exe\" }",
      "$StdlibRoot = Split-Path $dir -Parent",
      "$StdlibDir = Join-Path $StdlibRoot 'share\\zith\\stdlib'",
      "New-Item -ItemType Directory -Path $StdlibDir -Force | Out-Null",
      "Expand-Archive -Path \"$dir\\zithc-stdlib-*.zip\" -DestinationPath $StdlibDir -Force",
      "Remove-Item \"$dir\\zithc-stdlib-*.zip\" -Force"
    ]
  }
}
