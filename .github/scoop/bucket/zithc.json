      "64bit": {
        "url": [
          "https://github.com/GalaxyHaze/Zith-Lang/releases/download/v$version/zithc-windows-amd64.exe",
          "https://github.com/GalaxyHaze/Zith-Lang/releases/download/v$version/zithc-stdlib-v$version.zip"
