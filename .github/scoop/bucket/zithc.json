        ]
      }
    }
  },
  "installer": {
    "script": [
      "if ($architecture -eq '64bit') { Rename-Item \"$dir\\zithc-windows-amd64.exe\" \"zithc.exe\" }",
      "if ($architecture -eq 'arm64') { Rename-Item \"$dir\\zithc-windows-arm64.exe\" \"zithc.exe\" }",
      "$StdlibRoot = Split-Path $dir -Parent",
      "$StdlibDir = Join-Path $StdlibRoot 'share\\zith\\stdlib'",
      "New-Item -ItemType Directory -Path $StdlibDir -Force | Out-Null",
      "Get-ChildItem $StdlibDir -Force | Remove-Item -Recurse -Force",
      "Expand-Archive -Path \"$dir\\zithc-stdlib-*.zip\" -DestinationPath $StdlibDir -Force",
      "Remove-Item \"$dir\\zithc-stdlib-*.zip\" -Force"
    ]
  }
