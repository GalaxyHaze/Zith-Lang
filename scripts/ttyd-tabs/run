#!/bin/sh
set -eu

CREDENTIAL=$(cat "/home/diogo/.config/ttyd/credential")

exec chpst -u "diogo:diogo" env \
    HOME="/home/diogo" USER="diogo" LOGNAME="diogo" \
    ttyd --interface lo --port 7683 --check-origin --writable \
    --cwd "/home/diogo" --credential "$CREDENTIAL" \
    --base-path "/terminal" --url-arg \
    "/home/diogo/Zith/scripts/ttyd-tabs/session-command"
