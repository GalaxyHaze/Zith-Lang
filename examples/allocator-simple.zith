// Exercises: explicit `std/memory` allocation, alignment, and growth.
// Expected exit code: 42

from std/memory

fn main(): i32 {
    let heap = HeapAllocator {};
    let invalidAlignment = allocate(heap, 64u64, 3u64);
    if (invalidAlignment) {
        return 2;
    }
    let memory = allocate(heap, 64u64, 64u64);
    if (memory is null) {
        return 1;
    }
    let chars: ?*char = memory as ?*char;
    var bytes: []char = raw chars[0u64..64u64];
    raw bytes[0u64] = 42 as char;
    let resized = reallocate(heap, memory, 64u64, 64u64, 128u64, 64u64);
    if (resized is null) {
        deallocate(heap, memory, 64u64, 64u64);
        return 3;
    }
    let resizedChars: ?*char = resized as ?*char;
    var resizedBytes: []char = raw resizedChars[0u64..128u64];
    if (raw resizedBytes[0u64] != 42 as char) {
        deallocate(heap, resized, 128u64, 64u64);
        return 4;
    }
    deallocate(heap, resized, 128u64, 64u64);
    42
}
