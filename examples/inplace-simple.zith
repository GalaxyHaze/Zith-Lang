// Exercises: the `InPlace` construction/cleanup trait and allocator contract.
// Expected exit code: 42

from std/memory

struct Box {
    value: i64,
}

implement Box as InPlace {
    fn inplace(var self, args: opaque): bool {
        return true;
    }
    fn clean(var self) {}
}

fn main(): i32 {
    var box = Box { value: 42 };
    if not box.inplace(0) {
        return 1;
    }
    return 42;
}
