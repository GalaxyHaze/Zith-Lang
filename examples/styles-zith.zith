// Expected exit code: 0
// Expected output: bucket=1

from std/io/console
from soon/memory

fn classify(score: i32): i32 {
    when (score) {
        (0..49) 0,
        (50..79) 1,
        (_) 2
    }
}

fn main(): i32 {
    let heap = HeapAllocator {};
    let bucket = classify(73);
    println(heap, "bucket=#", bucket);
    0
}
