// Exercises: a raw macro that splices statements, including local bindings.
// Expected exit code: 9

raw macro sum(a: identifier, b: identifier, out: identifier) {
    out = a + b;
}

fn main(): i32 {
    var left = 4;
    var right = 5;
    var result = 0;
    @sum(left, right, result);
    result
}
