{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zith-lang.dev/schemas/lsp-ide-api.schema.json",
  "title": "Zith IDE API Contract",
  "description": "Stable C++ surface used by IDE-facing components such as zith-lsp.",
  "type": "object",
  "default": {
    "apiVersion": "1.0",
    "workspace": {},
    "documents": {},
    "features": {}
  },
  "required": [
    "apiVersion",
    "workspace",
    "documents",
    "features"
  ],
  "properties": {
    "apiVersion": {
      "const": "1.0",
      "description": "The only supported version for this contract revision."
    },
    "workspace": {
      "type": "object",
      "description": "Workspace lifecycle and analysis ownership. The C++ implementation MUST own its shared frontend context and MUST NOT expose compiler AST, TypedMap, or CompilationSession pointers.",
      "required": [
        "open",
        "close",
        "analyzeRevision"
      ],
      "properties": {
        "open": {
          "type": "object",
          "description": "Open a workspace root path.",
          "required": [
            "root"
          ],
          "properties": {
            "root": {
              "type": "string",
              "description": "Absolute workspace root path."
            }
          }
        },
        "close": {
          "type": "object",
          "description": "Close a workspace root and invalidate its snapshots."
        },
        "analyzeRevision": {
          "type": "object",
          "description": "Analyze an immutable document revision and return best-effort results tagged with the analyzed revision.",
          "required": [
            "documentUri",
            "text",
            "revision"
          ],
          "properties": {
            "documentUri": {
              "type": "string",
              "description": "Stable document URI."
            },
            "text": {
              "type": "string",
              "description": "Full in-memory text for the revision."
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "description": "Monotonically increasing document revision."
            }
          }
        }
      }
    },
    "documents": {
      "type": "object",
      "description": "Open document lifecycle. Each document has an immutable snapshot per revision.",
      "required": [
        "open",
        "change",
        "close"
      ],
      "properties": {
        "open": {
          "type": "object",
          "description": "Open a document with its initial in-memory content.",
          "required": [
            "uri",
            "text",
            "version"
          ],
          "properties": {
            "uri": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "version": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "change": {
          "type": "object",
          "description": "Replace an open document's content. No external consumer may observe partial edits.",
          "required": [
            "uri",
            "text",
            "version"
          ],
          "properties": {
            "uri": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "version": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "close": {
          "type": "object",
          "description": "Close a document and release its snapshots.",
          "required": [
            "uri"
          ],
          "properties": {
            "uri": {
              "type": "string"
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "description": "IDE feature capability status for zith::ide v1.0. Planned features are not announced by the LSP in v1.0.",
      "required": [
        "diagnostics",
        "completion",
        "completionResolve",
        "hover",
        "signatureHelp",
        "definition",
        "references",
        "documentSymbols",
        "workspaceSymbols",
        "semanticTokensFull",
        "semanticTokensDelta",
        "inlayHints",
        "highlights",
        "prepareRename",
        "rename",
        "formatting",
        "folding",
        "codeActions",
        "commands",
        "configuration"
      ],
      "properties": {
        "diagnostics": {
          "const": "stable",
          "description": "Diagnostics reported for the analyzed revision."
        },
        "completion": {
          "const": "stable",
          "description": "Completion items, including member completion filtered by static visibility."
        },
        "completionResolve": {
          "const": "stable",
          "description": "Completion item resolve/detail requests."
        },
        "hover": {
          "const": "stable",
          "description": "Hover content."
        },
        "signatureHelp": {
          "const": "stable",
          "description": "Signature help."
        },
        "definition": {
          "const": "stable",
          "description": "Go-to-definition locations."
        },
        "references": {
          "const": "stable",
          "description": "Reference locations."
        },
        "documentSymbols": {
          "const": "stable",
          "description": "Symbols within the open document."
        },
        "workspaceSymbols": {
          "const": "stable",
          "description": "Symbols across the workspace."
        },
        "semanticTokensFull": {
          "const": "stable",
          "description": "Full semantic token encoding."
        },
        "semanticTokensDelta": {
          "const": "experimental",
          "description": "Delta semantic tokens under cancellation."
        },
        "inlayHints": {
          "const": "stable",
          "description": "Inlay hints."
        },
        "highlights": {
          "const": "stable",
          "description": "Document highlights."
        },
        "prepareRename": {
          "const": "stable",
          "description": "Rename qualification."
        },
        "rename": {
          "const": "stable",
          "description": "Rename edits."
        },
        "formatting": {
          "const": "stable",
          "description": "Document formatting."
        },
        "folding": {
          "const": "stable",
          "description": "Folding ranges."
        },
        "codeActions": {
          "const": "stable",
          "description": "Code actions and commands."
        },
        "commands": {
          "const": "experimental",
          "description": "Workspace commands exposed by the facade."
        },
        "configuration": {
          "const": "planned",
          "description": "Runtime configuration subscriptions beyond static initialization options."
        }
      }
    }
  }
}
