from c/io

/// Reports a fatal message and does not recover.
///
/// `panic(message)` writes `message` and a trailing newline, then terminates
/// the program through a runtime panic (`R10004`). It is the standard-library
/// counterpart to the `@assert`/`@check` intrinsics outside a test: there is no
/// catch and no cleanup, so it is only for unrecoverable states such as
/// unwrapping the wrong `Result` case.
///
/// The message is written one byte at a time through `putchar` so the same
/// path works on the native and the VM v2 backends. The native runtime panic
/// helper flushes the C streams before trapping, so the message survives even
/// when the program's output is a pipe.
pub fn panic(message: []char): void {
    let length = @lengthOf(message);
    var index: u64 = 0u64;
    for (index < length) {
        _ = putchar((raw message[index]) as i32);
        index = index + 1u64;
    }
    _ = putchar(10);
    @assert(false);
}

mod fn test() {
    // panic is fatal; only the compile-time path is validated here.
    @assert(true);
}
