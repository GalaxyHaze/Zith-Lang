import "string.h"

from std/memory/allocators/allocator

pub struct string {
    data: ?*char = null,
    length: u64 = 0,
    allocator: dyn Allocator,
}

pub struct End {}

pub union stringCharStep { End, char }

pub struct stringIterator {
    data: *char,
    length: u64,
    index: u64,
}

implement string {
    pub fn init(allocator: dyn Allocator, str: *char): ?Self {
        let len = strlen(str)
        let memory = allocate(allocator, len + 1, 1u64)
        if (memory is null) { return null; }
        var data: ?*char = memory as ?*char
        if (data is null) { return null; }
        strcpy(data, str)
        string { data, len, allocator }
    }

    pub fn get(self: view string): view []char {
        raw self.data[0u64..self.length]
    }

    pub fn ptr(self: view string): ?*char {
        self.data
    }

    pub fn len(self: view string): u64 {
        self.length
    }

    pub fn empty(self: view string): bool {
        self.length == 0
    }

    pub fn iter(self: view string): stringIterator {
        stringIterator { self.data, self.length, 0u64 }
    }

    pub fn at(self: view string, index: u64): ?char {
        let chars = self.get()
        if (index >= self.length) { return null; }
        chars[index]
    }

    pub fn slice(self: view string, start: u64, end: u64): view []char {
        raw self.data[start..end]
    }

    pub fn equalsCString(self: view string, other: *char): bool {
        strcmp(self.data, other) == 0
    }

    pub fn startsWith(self: view string, other: *char): bool {
        let plen = strlen(other)
        if (plen > self.length) { return false }
        memcmp(self.data, other, plen) == 0
    }

    pub fn concat(self: view string, other: *char): ?Self {
        let olen = strlen(other)
        let max = 18446744073709551615u64
        if (self.length == max or olen > max - self.length - 1u64) { return null }
        let memory = allocate(self.allocator, self.length + olen + 1u64, 1u64)
        if (memory is null) { return null; }
        var data: ?*char = memory as ?*char
        if (data is null) { return null }
        strcpy(data, self.data)
        strcat(data, other)
        string { data, self.length + olen, self.allocator }
    }

    pub fn destroy(self: lend string) {
        let data = self.data
        if (data is null) { return }
        deallocate(self.allocator, data as raw opaque, self.length + 1u64, 1u64)
        self.data = null
        self.length = 0
    }
}

implement stringIterator {
    pub fn next(var self): stringCharStep {
        if (self.index >= self.length) {
            return stringCharStep { End {} };
        }
        let c = self.data[self.index]
        self.index = self.index + 1
        stringCharStep { c };
    }
}
