from soon/memory/in-place
from soon/memory/allocators/heap
from soon/memory/allocators/allocator

/// Convenience heap pair. `new` reserves the layout for `T` from the default
/// heap allocator, constructs it in place through `T.inplace`, and returns the
/// owning pointer; `delete` runs `T.clean` and frees the block. The result-only
/// parameter `T` binds from the expected result type at the call site, so
/// `let p: ?*Box = new(0 as opaque);` needs no explicit `<Box>`.
pub fn new<T: InPlace>(args: opaque): ?*T {
    let size: u64 = @sizeOf(T) as u64;
    let align: u64 = @alignOf(T) as u64;
    let mem = allocate(HeapAllocator{}, size, align);
    if (mem is null) {
        return null;
    }
    let p: ?*T = mem as ?*T;
    if (p is null) {
        return null;
    }
    let q = raw p;
    if not (*q).inplace(args) {
        deallocate(HeapAllocator{}, mem, size, align);
        return null;
    }
    return p;
}

pub fn delete<T: InPlace>(ptr: *T) {
    let size: u64 = @sizeOf(T) as u64;
    let align: u64 = @alignOf(T) as u64;
    (*ptr).clean();
    deallocate(HeapAllocator{}, raw ptr as raw opaque, size, align);
}
