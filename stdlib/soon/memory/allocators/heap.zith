from c/stdlib
from c/string

from soon/memory/allocators/allocator

pub struct HeapAllocator {}

fn heapAllocate(size: u64, align: u64): ?raw opaque {
    if (size == 0u64 or align == 0u64 or (align &. (align - 1u64)) != 0u64) {
        return null;
    }
    let remainder = size % align;
    var rounded = size;
    if (remainder != 0u64) {
        let padding = align - remainder;
        if (size > 18446744073709551615u64 - padding) {
            return null;
        }
        rounded = size + padding;
    }
    return aligned_alloc(align, rounded) as ?raw opaque;
}

implement HeapAllocator as Allocator {
    pub fn alloc(self, size: u64, align: u64): ?raw opaque {
        return heapAllocate(size, align);
    }
    pub fn free(self, mem: raw opaque, size: u64, align: u64) {
        free(mem);
    }
    pub fn realloc(self, old: raw opaque, old_size: u64, old_align: u64,
                   new_size: u64, new_align: u64): ?raw opaque {
        let next = heapAllocate(new_size, new_align);
        if (next is null) {
            return null;
        }
        var copy_size = old_size;
        if (new_size < copy_size) {
            copy_size = new_size;
        }
        _ = memcpy(next as ?*char, old as ?*char, copy_size);
        free(old);
        return next;
    }
}
