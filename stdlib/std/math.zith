import c/math as cm

pub const pi: f64 = 3.1415926535897932384626433832795;

/// Sine of `radians`.
pub fn sin(radians: f64): f64 {
    return cm.sin(radians);
}

/// Cosine of `radians`.
pub fn cos(radians: f64): f64 {
    return cm.cos(radians);
}

/// Tangent of `radians`.
pub fn tan(radians: f64): f64 {
    return cm.tan(radians);
}

/// Arcsine of `value` in radians.
pub fn asin(value: f64): f64 {
    return cm.asin(value);
}

/// Arccosine of `value` in radians.
pub fn acos(value: f64): f64 {
    return cm.acos(value);
}

/// Arctangent of `value` in radians, or of `(y, x)` when both are provided.
pub fn atan(x: f64): f64 {
    return cm.atan(x);
}

pub fn atan(y: f64, x: f64): f64 {
    return cm.atan2(y, x);
}

/// Euclidean distance from the origin to `(x, y)`.
pub fn hypot(x: f64, y: f64): f64 {
    return cm.hypot(x, y);
}

/// Square root.
pub fn sqrt(x: f64): f64 {
    return cm.sqrt(x);
}

/// Absolute value.
pub fn fabs(x: f64): f64 {
    return cm.fabs(x);
}
