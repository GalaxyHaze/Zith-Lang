from std/memory/allocators/allocator
from std/memory/in-place

struct DynArraySlot<T> {
    value: T,
}

/// Growable array whose backing storage is owned by its allocator.
pub struct DynArray<T> {
    allocator: dyn Allocator,
    data: ?*T = null,
    length: u64 = 0,
    capacity: u64 = 0,
}

/// Constructs an empty array and records the allocator that will own its storage.
pub fn create<T>(allocator: dyn Allocator): DynArray<T> {
    return DynArray<T> { allocator: allocator };
}

pub fn len<T>(self: view DynArray<T>): u64 {
    return self.length;
}

pub fn capacity<T>(self: view DynArray<T>): u64 {
    return self.capacity;
}

/// Ensures `capacity` slots are available. Failure leaves the array unchanged.
pub fn reserve<T>(var self: lend DynArray<T>, capacity: u64): bool {
    if (capacity <= self->capacity) {
        return true;
    }

    let elementSize = @sizeOf(T);
    if (elementSize == 0u64 or capacity > 18446744073709551615u64 / elementSize) {
        return false;
    }

    let bytes = capacity * elementSize;
    let alignment = @alignOf(DynArraySlot<T>) as u64;
    let oldBytes = self->capacity * elementSize;
    var memory: ?raw opaque = null;
    var oldData = self->data;

    if (oldData is null) {
        memory = allocate(self.allocator, bytes, alignment);
    } else {
        memory = reallocate(self.allocator, oldData as raw opaque,
                            oldBytes, alignment, bytes, alignment);
    }

    if (memory is null) {
        return false;
    }

    self->data = memory as ?*T;
    self->capacity = capacity;
    return true;
}

fn grow<T>(var self: lend DynArray<T>): bool {
    let max = 18446744073709551615u64;
    if (self->capacity == max) {
        return false;
    }
    var next = 8u64;
    if (self->capacity != 0u64) {
        if (self->capacity > max / 2u64) {
            next = max;
        } else {
            next = self->capacity * 2u64;
        }
    }
    return reserve<T>(lend self, next);
}

/// Appends one value. Returns false without changing the array if growth fails.
pub fn push<T>(var self: lend DynArray<T>, value: T): bool {
    if (self->length == self->capacity) {
        if not(grow<T>(lend self)) {
            return false;
        }
    }
    var items: []T = raw self->data[0u64..self->capacity];
    items[self->length] = value;
    self->length = self->length + 1u64;
    return true;
}

pub fn get<T>(self: view DynArray<T>, index: u64): ?T {
    if (index >= self.length or self.data is null) {
        return null;
    }
    var items: []T = raw self.data[0u64..self.length];
    return items[index];
}

pub fn pop<T>(var self: lend DynArray<T>): ?T {
    if (self->length == 0u64 or self->data is null) {
        return null;
    }
    self->length = self->length - 1u64;
    var items: []T = raw self->data[0u64..self->capacity];
    return items[self->length];
}

/// Removes and returns an element, preserving the relative order of the rest.
pub fn remove<T>(var self: lend DynArray<T>, index: u64): ?T {
    if (index >= self->length or self->data is null) {
        return null;
    }
    var items: []T = raw self->data[0u64..self->capacity];
    let value = items[index];
    var next = index + 1u64;
    for (next < self->length) {
        items[next - 1u64] = raw items[next];
        next = next + 1u64;
    }
    self->length = self->length - 1u64;
    return value;
}

/// Calls `InPlace.clean` on live elements, then keeps the allocated capacity.
pub fn cleanElements<T: InPlace>(var self: lend DynArray<T>) {
    if (self->data is null) {
        self->length = 0u64;
        return;
    }
    var items: []T = raw self->data[0u64..self->length];
    var index = 0u64;
    for (index < self->length) {
        items[index].clean();
        index = index + 1u64;
    }
    self->length = 0u64;
}

/// Frees only the backing storage. Call `cleanElements` first when elements
/// own resources that require `InPlace.clean`.
pub fn destroy<T>(var self: lend DynArray<T>) {
    var data = self->data;
    if (not (data is null)) {
        let bytes = self->capacity * @sizeOf(T);
        deallocate(self->allocator, data as raw opaque, bytes,
                   @alignOf(DynArraySlot<T>) as u64);
    }
    self->data = null;
    self->length = 0u64;
    self->capacity = 0u64;
}
