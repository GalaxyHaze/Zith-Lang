from c/io
from c/stdlib
from c/string

from soon/memory/allocators/allocator

/// Feeble standard-library formatting contract. Instances append their
/// textual representation to a reusable buffer and return a plain I/O status.
pub trait Formatable {
    fn format(self, dest: lend FormatBuffer): IoError;
}

/// Plain failable status for the I/O and formatting modules. The `f` prefix is
/// the standard-library convention for failed variants.
pub enum IoError {
    Ok = 0,
    fAllocation = 1,
    fWrite = 2,
}

/// Owned formatting result. The combined return replaces a speculative
/// `Result<T, E>` before generic union helpers and tuple returns are usable.
pub struct FormatResult {
    buffer: FormatBuffer,
    status: IoError,

    fn text(self: view FormatResult): view []char {
        return self.buffer.text();
    }

    fn error(self: view FormatResult): IoError {
        return self.status;
    }

    fn destroy(var self) {
        destroyBuffer(lend self.buffer);
        self.status = IoError.Ok;
    }
}

/// Reusable byte buffer used by `print` and `println`. It owns its heap
/// storage and must be destroyed with `destroyBuffer` or `destroy`.
pub struct FormatBuffer {
    allocator: dyn Allocator,
    data: ?*char = null,
    capacity: u64 = 0,
    length: u64 = 0,

    fn ensure(var self, extra: u64): IoError {
        return ensureBuffer(lend self, extra);
    }

    fn appendRaw(var self, src: *char, count: u64): IoError {
        return appendRawBuffer(lend self, src, count);
    }

    fn appendChar(var self, ch: char): IoError {
        return appendCharBuffer(lend self, ch);
    }

    fn appendMark(var self, ch: char): IoError {
        return appendMarkBuffer(lend self, ch);
    }

    fn appendU32(var self, value: u32): IoError {
        return appendNumberBuffer(lend self, value);
    }

    fn text(self: view FormatBuffer): view []char {
        return raw self.data[0u64..self.length];
    }

    fn len(self: view FormatBuffer): u64 {
        return self.length;
    }

    fn destroy(var self) {
        destroyBuffer(lend self);
    }
}

pub fn emptyFormatBuffer(allocator: dyn Allocator): FormatBuffer {
    return FormatBuffer { allocator };
}

fn formatNext(value: dyn Formatable, buffer: lend FormatBuffer): IoError {
    return value.format(lend buffer);
}

pub fn format(dest: lend FormatBuffer, msg: []char, values: [...]dyn Formatable): IoError {
    var index: u64 = 0;
    var next: u64 = 0;
    let length = @lengthOf(msg);
    var status = IoError.Ok;
    for (index < length) {
        let ch = raw msg[index];
        if (ch == '#') {
            if (index + 1 < length) {
                if (raw msg[index + 1] == '\x1f') {
                    status = appendCharBuffer(lend dest, '#');
                    index = index + 2;
                    continue;
                }
            }
            if (next < @lengthOf(values)) {
                status = formatNext(raw values[next], lend dest);
            } else {
                status = appendRawBuffer(lend dest, "{absent}", 8);
            }
            next = next + 1;
            index = index + 1;
            continue;
        }
        if (ch == '\x1f') {
            status = appendCharBuffer(lend dest, '#');
            index = index + 1;
            continue;
        }
        status = appendCharBuffer(lend dest, ch);
        index = index + 1;
    }
    return status;
}

pub fn format(allocator: dyn Allocator, msg: []char,
              values: [...]dyn Formatable): FormatResult {
    var buffer = emptyFormatBuffer(allocator);
    var index: u64 = 0;
    var next: u64 = 0;
    let length = @lengthOf(msg);
    var status = IoError.Ok;
    for (index < length) {
        let ch = raw msg[index];
        if (ch == '#') {
            if (index + 1 < length) {
                if (raw msg[index + 1] == '\x1f') {
                    status = appendCharBuffer(lend buffer, '#');
                    index = index + 2;
                    continue;
                }
            }
            if (next < @lengthOf(values)) {
                status = formatNext(raw values[next], lend buffer);
            } else {
                status = appendRawBuffer(lend buffer, "{absent}", 8);
            }
            next = next + 1;
            index = index + 1;
            continue;
        }
        if (ch == '\x1f') {
            status = appendCharBuffer(lend buffer, '#');
            index = index + 1;
            continue;
        }
        status = appendCharBuffer(lend buffer, ch);
        index = index + 1;
    }
    return FormatResult { buffer, status };
}

pub fn ensureBuffer(self: lend FormatBuffer, extra: u64): IoError {
    let max = 18446744073709551615u64;
    if (extra > max - self.length) {
        return IoError.fAllocation;
    }
    let needed = self.length + extra;
    if (needed <= self.capacity) {
        return IoError.Ok;
    }
    if (self.capacity > max - 64u64 or extra > max - self.capacity - 64u64) {
        return IoError.fAllocation;
    }
    let desired = self.capacity + extra + 64;
    var next: ?raw opaque = allocate(self.allocator, desired as u64, 1u64);
    if (next is null) {
        return IoError.fAllocation;
    }
    if (self.length > 0 and not (self.data is null)) {
        _ = memcpy(next as ?*char, self.data, self.length);
    }
    let old = self.data;
    if (not (old is null)) {
        deallocate(self.allocator, old as raw opaque, self.capacity, 1u64);
    }
    self.data = next as ?*char;
    self.capacity = desired;
    return IoError.Ok;
}

pub fn appendRawBuffer(self: lend FormatBuffer, src: *char, count: u64): IoError {
    let status = ensureBuffer(lend self, count);
    if (status != IoError.Ok) {
        return status;
    }
    if (count > 0 and not (self.data is null)) {
        var chars: []char = raw self.data[0u64..self.capacity];
        var bytes: []char = raw src[0u64..count];
        var index: u64 = 0;
        for (index < count) {
            chars[self.length + index] = raw bytes[index];
            index = index + 1;
        }
        self.length = self.length + count;
    }
    return IoError.Ok;
}

pub fn appendCharBuffer(self: lend FormatBuffer, ch: char): IoError {
    let status = ensureBuffer(lend self, 1);
    if (status != IoError.Ok) {
        return status;
    }
    if (not (self.data is null)) {
        var chars: []char = raw self.data[0u64..self.capacity];
        chars[self.length] = ch;
        self.length = self.length + 1;
    }
    return IoError.Ok;
}

pub fn appendMarkBuffer(self: lend FormatBuffer, ch: char): IoError {
    if (ch == '#') {
        return appendCharBuffer(lend self, '\x1f');
    }
    return appendCharBuffer(lend self, ch);
}

pub fn appendNumberBuffer(self: lend FormatBuffer, value: u32): IoError {
    let status = ensureBuffer(lend self, 32);
    if (status != IoError.Ok) {
        return status;
    }
    var scratch: ?raw opaque = allocate(self.allocator, 64u64, 1u64);
    if (scratch is null) {
        return IoError.fAllocation;
    }
    let chars: ?*char = scratch as ?*char;
    let written = snprintf(chars, 64, "%u", value);
    if (written < 0) {
        deallocate(self.allocator, scratch, 64u64, 1u64);
        return IoError.fWrite;
    }
    let status2 = appendRawBuffer(lend self, raw chars, written as u64);
    deallocate(self.allocator, scratch, 64u64, 1u64);
    return status2;
}

pub fn destroyBuffer(self: lend FormatBuffer): void {
    let data = self.data;
    if (not (data is null)) {
        deallocate(self.allocator, data as raw opaque, self.capacity, 1u64);
    }
    self.data = null;
    self.capacity = 0;
    self.length = 0;
}

pub fn formatString(self: []char, dest: lend FormatBuffer): IoError {
    var chars: []char = self;
    if (@lengthOf(chars) > 0) {
        return appendRawBuffer(lend dest, @ptrOf(chars), @lengthOf(chars));
    }
    return IoError.Ok;
}

pub fn formatBool(self: bool, dest: lend FormatBuffer): IoError {
    if (self) {
        return appendRawBuffer(lend dest, "true", 4);
    }
    return appendRawBuffer(lend dest, "false", 5);
}

fn appendFloat(self: f64, dest: lend FormatBuffer): IoError {
    var scratch: ?raw opaque = allocate(dest.allocator, 64u64, 1u64);
    if (scratch is null) {
        return IoError.fAllocation;
    }
    let chars: ?*char = scratch as ?*char;
    let written = snprintf(chars, 64, "%g", self);
    if (written < 0) {
        deallocate(dest.allocator, scratch, 64u64, 1u64);
        return IoError.fWrite;
    }
    let status = appendRawBuffer(lend dest, raw chars, written as u64);
    deallocate(dest.allocator, scratch, 64u64, 1u64);
    return status;
}

pub fn formatF32(self: f32, dest: lend FormatBuffer): IoError {
    return appendFloat(self as f64, lend dest);
}

pub fn formatF64(self: f64, dest: lend FormatBuffer): IoError {
    return appendFloat(self, lend dest);
}

pub fn formatU32(self: u32, dest: lend FormatBuffer): IoError {
    return appendNumberBuffer(lend dest, self);
}

pub fn formatI32(self: i32, dest: lend FormatBuffer): IoError {
    var scratch: ?raw opaque = allocate(dest.allocator, 64u64, 1u64);
    if (scratch is null) {
        return IoError.fAllocation;
    }
    let chars: ?*char = scratch as ?*char;
    let written = snprintf(chars, 64, "%d", self);
    if (written < 0) {
        deallocate(dest.allocator, scratch, 64u64, 1u64);
        return IoError.fWrite;
    }
    let status = appendRawBuffer(lend dest, raw chars, written as u64);
    deallocate(dest.allocator, scratch, 64u64, 1u64);
    return status;
}

pub fn formatPtr(self: *char, dest: lend FormatBuffer): IoError {
    let length = strlen(self);
    return appendRawBuffer(lend dest, self, length);
}

implement []char as Formatable {
    fn format(self: []char, dest: lend FormatBuffer): IoError {
        return formatString(self, lend dest);
    }
}

implement bool as Formatable {
    fn format(self: bool, dest: lend FormatBuffer): IoError {
        return formatBool(self, lend dest);
    }
}

implement f32 as Formatable {
    fn format(self: f32, dest: lend FormatBuffer): IoError {
        return formatF32(self, lend dest);
    }
}

implement f64 as Formatable {
    fn format(self: f64, dest: lend FormatBuffer): IoError {
        return formatF64(self, lend dest);
    }
}

implement u32 as Formatable {
    fn format(self: u32, dest: lend FormatBuffer): IoError {
        return formatU32(self, lend dest);
    }
}

implement i32 as Formatable {
    fn format(self: i32, dest: lend FormatBuffer): IoError {
        return formatI32(self, lend dest);
    }
}

implement *char as Formatable {
    fn format(self, dest: lend FormatBuffer): IoError {
        return formatPtr(self, lend dest);
    }
}
