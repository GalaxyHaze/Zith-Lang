from c/io
from c/string
from std/io/format
from soon/memory/allocators/allocator

/// Parsing contract used by `InputLine.cast<T>`. Implementations parse one
/// whole primitive value from a view of the line and return `null` on failure.
pub trait ParseInput {
    fn parse(self: view InputLine): ?Self;
}

/// Owned single-line input. `ok` is false only when the stream ended or a
/// read failed; `text` is then empty.
pub struct InputLine {
    allocator: dyn Allocator,
    data: ?*char = null,
    length: u64 = 0,
    ok: bool = false,

    fn text(self: view InputLine): view []char {
        return raw self.data[0u64..self.length];
    }

    fn len(self: view InputLine): u64 {
        return self.length;
    }

    fn good(self: view InputLine): bool {
        return self.ok;
    }

    fn cast<T: ParseInput>(self: view InputLine): ?T {
        return T.parse(view self);
    }

    fn destroy(var self) {
        let data = self.data;
        if (not (data is null)) {
            deallocate(self.allocator, data as raw opaque, 256u64, 1u64);
        }
        self.data = null;
        self.length = 0;
        self.ok = false;
    }
}

fn inputLineAllocate(allocator: dyn Allocator): ?*char {
    let data = allocate(allocator, 256u64, 1u64);
    if (data is null) {
        return null;
    }
    return data as ?*char;
}

fn parseSliceCopy(src: ?*char, len: u64, dest: ?*char, capacity: u64): u64 {
    if (len >= capacity) {
        return 0;
    }
    var bytes: []char = raw dest[0u64..capacity];
    var index: u64 = 0;
    var chars: []char = raw src[0u64..len];
    for (index < len) {
        bytes[index] = raw chars[index];
        index = index + 1;
    }
    bytes[len] = 0 as char;
    return len;
}

fn parseI32(self: view InputLine): ?i32 {
    var scratch: ?raw opaque = allocate(self.allocator, 64u64, 1u64);
    if (scratch is null) {
        return null;
    }
    let chars: ?*char = scratch as ?*char;
    if (self.data is null) {
        deallocate(self.allocator, scratch, 64u64, 1u64);
        return null;
    }
    let len = parseSliceCopy(self.data, self.length, chars, 64u64);
    if (len == 0) {
        deallocate(self.allocator, scratch, 64u64, 1u64);
        return null;
    }
    var value: i32 = 0;
    var count: i32 = 0;
    let status = sscanf(chars, "%d%n", lend value, lend count);
    deallocate(self.allocator, scratch, 64u64, 1u64);
    if (status == 1 and count == len as i32) {
        return value;
    }
    return null;
}

fn parseBool(self: view InputLine): ?bool {
    if (self.data is null) {
        return null;
    }
    if (self.length == 4 and strncmp(self.data, "true", 4) == 0) {
        return true;
    }
    if (self.length == 5 and strncmp(self.data, "false", 5) == 0) {
        return false;
    }
    return null;
}

fn parseDouble(self: view InputLine): ?f64 {
    var scratch: ?raw opaque = allocate(self.allocator, 64u64, 1u64);
    if (scratch is null) {
        return null;
    }
    let chars: ?*char = scratch as ?*char;
    if (self.data is null) {
        deallocate(self.allocator, scratch, 64u64, 1u64);
        return null;
    }
    let len = parseSliceCopy(self.data, self.length, chars, 64u64);
    if (len == 0) {
        deallocate(self.allocator, scratch, 64u64, 1u64);
        return null;
    }
    var value: f64 = 0;
    var count: i32 = 0;
    let status = sscanf(chars, "%lf%n", lend value, lend count);
    deallocate(self.allocator, scratch, 64u64, 1u64);
    if (status == 1 and count == len as i32) {
        return value;
    }
    return null;
}

fn parseF32(self: view InputLine): ?f32 {
    let value = parseDouble(view self);
    let n = value;
    if (n is null) {
        return null;
    }
    var ok = n;
    let f = ok?;
    return f as f32;
}

fn parseU32(self: view InputLine): ?u32 {
    var scratch: ?raw opaque = allocate(self.allocator, 64u64, 1u64);
    if (scratch is null) {
        return null;
    }
    let chars: ?*char = scratch as ?*char;
    if (self.data is null) {
        deallocate(self.allocator, scratch, 64u64, 1u64);
        return null;
    }
    let len = parseSliceCopy(self.data, self.length, chars, 64u64);
    if (len == 0) {
        deallocate(self.allocator, scratch, 64u64, 1u64);
        return null;
    }
    var value: u32 = 0;
    var count: i32 = 0;
    let status = sscanf(chars, "%u%n", lend value, lend count);
    deallocate(self.allocator, scratch, 64u64, 1u64);
    if (status == 1 and count == len as i32) {
        return value as u32;
    }
    return null;
}

fn parseF64(self: view InputLine): ?f64 {
    return parseDouble(view self);
}

implement i32 as ParseInput {
    fn parse(self: view InputLine): ?i32 {
        return parseI32(view self);
    }
}

implement bool as ParseInput {
    fn parse(self: view InputLine): ?bool {
        return parseBool(view self);
    }
}

implement f32 as ParseInput {
    fn parse(self: view InputLine): ?f32 {
        return parseF32(view self);
    }
}

implement f64 as ParseInput {
    fn parse(self: view InputLine): ?f64 {
        return parseF64(view self);
    }
}

implement u32 as ParseInput {
    fn parse(self: view InputLine): ?u32 {
        return parseU32(view self);
    }
}

pub fn input(allocator: dyn Allocator): InputLine {
    var data: ?*char = inputLineAllocate(allocator);
    if (data is null) {
        return InputLine { allocator, null, 0, false };
    }
    var length: u64 = 0;
    var ch = getchar();
    var ok = ch != -1;
    for (ok and ch != 10 and length + 1 < 256) {
        var chars: []char = raw data[0u64..256u64];
        chars[length] = ch as char;
        length = length + 1;
        let next = getchar();
        ok = next != -1;
        ch = next;
    }
    var line = InputLine { allocator, data, length, ok };
    return line;
}

fn formatNext(value: dyn Formatable, buffer: lend FormatBuffer): IoError {
    return value.format(lend buffer);
}

fn writeBuffer(allocator: dyn Allocator, msg: []char, newline: bool,
               values: [...]dyn Formatable): IoError {
    var buffer = emptyFormatBuffer(allocator);
    var index: u64 = 0;
    var next: u64 = 0;
    let length = @lengthOf(msg);
    var status = IoError.Ok;
    for (index < length) {
        let ch = raw msg[index];
        if (ch == '#') {
            if (index + 1 < length and raw msg[index + 1] == '\x1f') {
                status = appendCharBuffer(lend buffer, '#');
                index = index + 2;
                continue;
            }
            if (next < @lengthOf(values)) {
                status = formatNext(raw values[next], lend buffer);
            } else {
                status = appendRawBuffer(lend buffer, "{absent}", 8);
            }
            next = next + 1;
            index = index + 1;
            continue;
        }
        if (ch == '\x1f') {
            status = appendCharBuffer(lend buffer, '#');
            index = index + 1;
            continue;
        }
        status = appendCharBuffer(lend buffer, ch);
        index = index + 1;
    }
    if (newline) {
        status = appendCharBuffer(lend buffer, '\n');
    }
    if (status == IoError.Ok) {
        let text = buffer.text();
        var index: u64 = 0;
        let length = @lengthOf(text);
        for (index < length) {
            _ = putchar((raw text[index]) as i32);
            index = index + 1;
        }
    }
    destroyBuffer(lend buffer);
    return status;
}

#[discardable]
pub fn print(allocator: dyn Allocator, msg: []char,
             values: [...]dyn Formatable): IoError {
    return writeBuffer(allocator, msg, false, values);
}

#[discardable]
pub fn println(allocator: dyn Allocator, msg: []char,
               values: [...]dyn Formatable): IoError {
    return writeBuffer(allocator, msg, true, values);
}
