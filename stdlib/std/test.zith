from std/io/format
from soon/memory/allocators/heap

fn logBuffer(var buffer: lend FormatBuffer): void {
    let status = appendCharBuffer(lend buffer, 0 as char);
    if (status != IoError.Ok) {
        @log("assertion failed (message allocation failed)");
        return;
    }
    @log(buffer.text());
}

pub fn reportAssertionFailure(message: []char): void {
    let allocator = HeapAllocator {};
    var buffer = emptyFormatBuffer(allocator);
    let status = format(lend buffer, "#", message);
    if (status == IoError.Ok) {
        logBuffer(lend buffer);
    } else {
        @log("assertion failed (message formatting failed)");
    }
    destroyBuffer(lend buffer);
}

pub fn reportEqualityFailure(actual: dyn Formatable, expected: dyn Formatable): void {
    let allocator = HeapAllocator {};
    var buffer = emptyFormatBuffer(allocator);
    let status = format(lend buffer, "assertEq failed: actual #, expected #", actual, expected);
    if (status == IoError.Ok) {
        logBuffer(lend buffer);
    } else {
        @log("assertEq failed (message formatting failed)");
    }
    destroyBuffer(lend buffer);
}

pub fn reportInequalityFailure(actual: dyn Formatable, unexpected: dyn Formatable): void {
    let allocator = HeapAllocator {};
    var buffer = emptyFormatBuffer(allocator);
    let status =
        format(lend buffer, "assertNe failed: actual # equals unexpected #", actual, unexpected);
    if (status == IoError.Ok) {
        logBuffer(lend buffer);
    } else {
        @log("assertNe failed (message formatting failed)");
    }
    destroyBuffer(lend buffer);
}

pub fn reportCheckEqualityFailure(actual: dyn Formatable, expected: dyn Formatable): void {
    let allocator = HeapAllocator {};
    var buffer = emptyFormatBuffer(allocator);
    let status = format(lend buffer, "checkEq failed: actual #, expected #", actual, expected);
    if (status == IoError.Ok) {
        logBuffer(lend buffer);
    } else {
        @log("checkEq failed (message formatting failed)");
    }
    destroyBuffer(lend buffer);
}

pub fn reportCheckInequalityFailure(actual: dyn Formatable, unexpected: dyn Formatable): void {
    let allocator = HeapAllocator {};
    var buffer = emptyFormatBuffer(allocator);
    let status =
        format(lend buffer, "checkNe failed: actual # equals unexpected #", actual, unexpected);
    if (status == IoError.Ok) {
        logBuffer(lend buffer);
    } else {
        @log("checkNe failed (message formatting failed)");
    }
    destroyBuffer(lend buffer);
}

fn appendCheckEachOneOfIndex(buffer: lend FormatBuffer, value: u64): IoError {
    if (value < 1000000000u64) {
        return appendNumberBuffer(lend buffer, value as u32);
    }
    let high = value / 1000000000u64;
    var low = value % 1000000000u64;
    var status = appendCheckEachOneOfIndex(lend buffer, high);
    var divisor = 100000000u64;
    for (divisor > 0u64) {
        if (status == IoError.Ok) {
            let digit = (low / divisor) as u32;
            status = appendCharBuffer(lend buffer, (digit + 48u32) as char);
            low = low % divisor;
        }
        divisor = divisor / 10u64;
    }
    return status;
}

pub fn reportCheckEachOneOfFailure(index: u64, actual: dyn Formatable): void {
    let allocator = HeapAllocator {};
    var buffer = emptyFormatBuffer(allocator);
    var status = appendRawBuffer(
        lend buffer, "checkEachOneOf failed at index ", @lengthOf("checkEachOneOf failed at index "));
    if (status == IoError.Ok) {
        status = appendCheckEachOneOfIndex(lend buffer, index);
    }
    if (status == IoError.Ok) {
        status = format(lend buffer, ": actual #; expected one of:", actual);
    }
    if (status == IoError.Ok) {
        logBuffer(lend buffer);
    } else {
        @log("checkEachOneOf failed (message formatting failed)");
    }
    destroyBuffer(lend buffer);
}

pub fn reportCheckEachOneOfAllowedValue(value: dyn Formatable): void {
    let allocator = HeapAllocator {};
    var buffer = emptyFormatBuffer(allocator);
    let status = format(lend buffer, "  allowed value: #", value);
    if (status == IoError.Ok) {
        logBuffer(lend buffer);
    } else {
        @log("checkEachOneOf failed (message formatting failed)");
    }
    destroyBuffer(lend buffer);
}

pub fn valuesAreNear(actual: f64, expected: f64, tolerance: f64): bool {
    if (not (tolerance >= 0)) {
        return false;
    }
    if (actual == expected) {
        return true;
    }
    if (actual > expected) {
        return actual - expected <= tolerance;
    }
    return expected - actual <= tolerance;
}

pub macro assertTrue(condition: expr) {
    let testCondition = condition;
    if (not testCondition) {
        reportAssertionFailure("assertTrue failed");
    }
    @assert(testCondition);
}

pub macro assertFalse(condition: expr) {
    let testCondition = condition;
    if (testCondition) {
        reportAssertionFailure("assertFalse failed");
    }
    @assert(not testCondition);
}

pub macro assertEq(actual: expr, expected: expr) {
    let actualValue = actual;
    let expectedValue = expected;
    if (actualValue != expectedValue) {
        reportEqualityFailure(actualValue, expectedValue);
    }
    @assert(actualValue == expectedValue);
}

pub macro assertNe(actual: expr, unexpected: expr) {
    let actualValue = actual;
    let unexpectedValue = unexpected;
    if (actualValue == unexpectedValue) {
        reportInequalityFailure(actualValue, unexpectedValue);
    }
    @assert(actualValue != unexpectedValue);
}

pub macro assertNear(actual: expr, expected: expr, tolerance: expr) {
    let actualValue = actual;
    let expectedValue = expected;
    let toleranceValue = tolerance;
    let testCondition =
        valuesAreNear(actualValue as f64, expectedValue as f64, toleranceValue as f64);
    if (not testCondition) {
        reportAssertionFailure("assertNear failed: values are outside tolerance");
    }
    @assert(testCondition);
}

pub macro assertIn(value: expr, container: expr) {
    if (value in container) {
        @assert(true);
    } else {
        reportAssertionFailure("assertIn failed: value is not contained");
        @assert(false);
    }
}

pub macro assertNotIn(value: expr, container: expr) {
    if (value in container) {
        reportAssertionFailure("assertNotIn failed: value is contained");
        @assert(false);
    } else {
        @assert(true);
    }
}

pub macro assertOneOf(value: expr, expectedValues: expr) {
    let actualValue = value;
    let values = expectedValues;
    let valueCount = @lengthOf(values);
    var index = 0u64;
    var found = false;
    for (index < valueCount) {
        if (actualValue == raw values[index]) {
            found = true;
        }
        index = index + 1u64;
    }
    if (not found) {
        reportAssertionFailure("assertOneOf failed: value is not in the expected values");
    }
    @assert(found);
}

pub macro assertSome(value: expr) {
    if (value is null) {
        reportAssertionFailure("assertSome failed: value is null");
        @assert(false);
    } else {
        @assert(true);
    }
}

pub macro assertNone(value: expr) {
    if (value is null) {
        @assert(true);
    } else {
        reportAssertionFailure("assertNone failed: value is present");
        @assert(false);
    }
}

pub macro checkTrue(condition: expr) {
    let testCondition = condition;
    if (not testCondition) {
        reportAssertionFailure("checkTrue failed");
    }
    @check(testCondition);
}

pub macro checkFalse(condition: expr) {
    let testCondition = condition;
    if (testCondition) {
        reportAssertionFailure("checkFalse failed");
    }
    @check(not testCondition);
}

pub macro checkEq(actual: expr, expected: expr) {
    let actualValue = actual;
    let expectedValue = expected;
    if (actualValue != expectedValue) {
        reportCheckEqualityFailure(actualValue, expectedValue);
    }
    @check(actualValue == expectedValue);
}

pub macro checkNe(actual: expr, unexpected: expr) {
    let actualValue = actual;
    let unexpectedValue = unexpected;
    if (actualValue == unexpectedValue) {
        reportCheckInequalityFailure(actualValue, unexpectedValue);
    }
    @check(actualValue != unexpectedValue);
}

pub macro checkNear(actual: expr, expected: expr, tolerance: expr) {
    let actualValue = actual;
    let expectedValue = expected;
    let toleranceValue = tolerance;
    let testCondition =
        valuesAreNear(actualValue as f64, expectedValue as f64, toleranceValue as f64);
    if (not testCondition) {
        reportAssertionFailure("checkNear failed: values are outside tolerance");
    }
    @check(testCondition);
}

pub macro checkIn(value: expr, container: expr) {
    let actualValue = value;
    let actualContainer = container;
    let found = actualValue in actualContainer;
    if (not found) {
        reportAssertionFailure("checkIn failed: value is not contained");
    }
    @check(found);
}

pub macro checkNotIn(value: expr, container: expr) {
    let actualValue = value;
    let actualContainer = container;
    let found = not (actualValue in actualContainer);
    if (not found) {
        reportAssertionFailure("checkNotIn failed: value is contained");
    }
    @check(found);
}

pub macro checkOneOf(value: expr, expectedValues: expr) {
    let actualValue = value;
    let values = expectedValues;
    let valueCount = @lengthOf(values);
    var index = 0u64;
    var found = false;
    for (index < valueCount) {
        if (actualValue == raw values[index]) {
            found = true;
        }
        index = index + 1u64;
    }
    if (not found) {
        reportAssertionFailure("checkOneOf failed: value is not in the expected values");
    }
    @check(found);
}

pub macro checkEachOneOf(actualValues: expr, expectedValues: expr) {
    let actualItems = actualValues;
    let expectedItems = expectedValues;
    let actualCount = @lengthOf(actualItems);
    let expectedCount = @lengthOf(expectedItems);
    var actualIndex = 0u64;
    for (actualIndex < actualCount) {
        let actualValue = raw actualItems[actualIndex];
        var expectedIndex = 0u64;
        var found = false;
        for (expectedIndex < expectedCount) {
            if (actualValue == raw expectedItems[expectedIndex]) {
                found = true;
            }
            expectedIndex = expectedIndex + 1u64;
        }
        if (not found) {
            reportCheckEachOneOfFailure(actualIndex, actualValue);
            var valueIndex = 0u64;
            for (valueIndex < expectedCount) {
                reportCheckEachOneOfAllowedValue(raw expectedItems[valueIndex]);
                valueIndex = valueIndex + 1u64;
            }
        }
        @check(found);
        actualIndex = actualIndex + 1u64;
    }
}

pub macro checkSome(value: expr) {
    let actualValue = value;
    let present = not (actualValue is null);
    if (not present) {
        reportAssertionFailure("checkSome failed: value is null");
    }
    @check(present);
}

pub macro checkNone(value: expr) {
    let actualValue = value;
    let absent = actualValue is null;
    if (not absent) {
        reportAssertionFailure("checkNone failed: value is present");
    }
    @check(absent);
}

pub macro checkFail(message: expr) {
    reportAssertionFailure(message);
    @check(false);
}

pub macro fail(message: expr) {
    reportAssertionFailure(message);
    @assert(false);
}
