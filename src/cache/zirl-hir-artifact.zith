from cache/zirl-artifact
from cache/zirl-attrs-section
from cache/zirl-code-section
from cache/zirl-canonical-types
from cache/zirl-container
from cache/zirl-decl-section
from cache/zirl-hir-code
from cache/zirl-metadata
from cache/zirl-template-section
from cache/zirl-buffer
from ir/hir
from ir/hir-verify

pub const zirlHirMetadataSectionId: u16 = 1u16
pub const zirlHirDeclsSectionId: u16 = 2u16
pub const zirlHirTemplatesSectionId: u16 = 3u16
pub const zirlHirCodeSectionId: u16 = 4u16
pub const zirlHirAttrsSectionId: u16 = 5u16

pub struct ZirlHirArtifactSource {
    pub identity: ZirlArtifactIdentity,
    pub paths: [][]char,
    pub module: HirModule,
}

pub struct ZirlHirArtifactWriteStorage {
    pub metadata_bytes: []u8,
    pub decls_bytes: []u8,
    pub templates_bytes: []u8,
    pub code_bytes: []u8,
    pub attrs_bytes: []u8,
    pub sections: []ZirlArtifactSection,
    pub canonical_types: ZirlCanonicalTypeStorage,
    pub declarations: ZirlDeclStorage,
    pub templates: ZirlTemplateStorage,
    pub code: ZirlCodeStorage,
    pub attrs: ZirlAttrsStorage,
}

pub enum ZirlHirArtifactProjectionError {
    None = 0,
    InvalidHir = 1,
    UnsupportedDeclarationsOrTemplates = 2,
    InvalidCanonicalTypes = 3,
    CodeProjectionFailed = 4,
    AttrsProjectionFailed = 5,
    InvalidIdentity = 6,
    InsufficientDeclarationStorage = 7,
    InsufficientTemplateStorage = 8,
    InvalidDeclarationProjection = 9,
    InvalidTemplateProjection = 10,
}

pub struct ZirlHirArtifactSections {
    pub declarations: ZirlDeclSection,
    pub templates: ZirlTemplateSection,
    pub code: ZirlCodeSection,
    pub attrs: ZirlAttrsSection,
}

pub struct ZirlHirArtifactProjectionResult {
    pub value: ZirlHirArtifactSections,
    pub error: ZirlHirArtifactProjectionError,
    pub canonical_error: ZirlCanonicalTypeError,
    pub code_error: ZirlHirCodeError,
    pub attrs_error: ZirlHirAttrsError,
}

struct ZirlHirArtifactDeclarationProjection {
    value: ZirlDeclSection,
    error: ZirlHirArtifactProjectionError,
}

struct ZirlHirArtifactTemplateProjection {
    value: ZirlTemplateSection,
    error: ZirlHirArtifactProjectionError,
}

struct ZirlHirArtifactProjectionCounts {
    declaration_fields: u64,
    declaration_methods: u64,
    template_params: u64,
    template_bounds: u64,
    template_param_types: u64,
    template_param_names: u64,
    template_fields: u64,
    template_field_order: u64,
    template_methods: u64,
    template_traits: u64,
    failed: bool,
}

pub enum ZirlHirArtifactReadError {
    None = 0,
    InvalidArtifact = 1,
    InvalidSectionPayload = 2,
    TrailingSectionPayload = 3,
    IdentityMismatch = 4,
    UnsupportedDeclarationsOrTemplates = 5,
    InvalidCanonicalReference = 6,
    InsufficientHydrationStorage = 7,
    InvalidHydratedHir = 8,
}

pub struct ZirlHirArtifactReadStorage {
    pub artifact: ZirlArtifactStorage,
    pub metadata: ZirlMetadataStorage,
    pub declarations: ZirlDeclStorage,
    pub templates: ZirlTemplateStorage,
    pub code: ZirlCodeStorage,
    pub attrs: ZirlAttrsStorage,
}

pub struct ZirlHirArtifactReadResult {
    pub identity: ZirlArtifactIdentity,
    pub metadata: ZirlMetadataSection,
    pub declarations: ZirlDeclSection,
    pub templates: ZirlTemplateSection,
    pub code: ZirlCodeSection,
    pub attrs: ZirlAttrsSection,
    pub error: ZirlHirArtifactReadError,
}

pub struct ZirlHirArtifactHydrationStorage {
    pub module: HirModule,
    pub expression_argument_types: []HirTypeId,
    pub function_parameter_types: []HirTypeId,
    pub blocks: []HirBasicBlock,
    pub vtable_slot_functions: []HirFunctionId,
    pub call_attr_arguments: []HirCallArgAttrs,
}

pub struct ZirlHirArtifactModuleReadResult {
    pub identity: ZirlArtifactIdentity,
    pub paths: [][]char,
    pub module: HirModule,
    pub error: ZirlHirArtifactReadError,
}

struct ZirlHirArtifactFunctionReference {
    value: HirFunctionId,
    failed: bool,
}

struct ZirlHirArtifactExpressionDecode {
    value: HirExpr,
    error: ZirlHirArtifactReadError,
}

struct ZirlHirArtifactCallDecode {
    value: HirCall,
    error: ZirlHirArtifactReadError,
}

struct ZirlHirArtifactBinaryOpDecode {
    value: HirBinaryOp,
    valid: bool,
}

struct ZirlHirArtifactUnaryOpDecode {
    value: HirUnaryOp,
    valid: bool,
}

struct ZirlHirArtifactSafetyDecode {
    value: HirSafetyMode,
    valid: bool,
}

struct ZirlHirArtifactLayoutDecode {
    value: HirLayoutIntrinsicKind,
    valid: bool,
}

fn artifact_hir_binary_op(value: u8): ZirlHirArtifactBinaryOpDecode {
    if (value == 0u8) {
        return ZirlHirArtifactBinaryOpDecode { value: HirBinaryOp.Add, valid: true };
    }
    if (value == 1u8) {
        return ZirlHirArtifactBinaryOpDecode { value: HirBinaryOp.Sub, valid: true };
    }
    if (value == 2u8) {
        return ZirlHirArtifactBinaryOpDecode { value: HirBinaryOp.Mul, valid: true };
    }
    if (value == 3u8) {
        return ZirlHirArtifactBinaryOpDecode { value: HirBinaryOp.Div, valid: true };
    }
    if (value == 4u8) {
        return ZirlHirArtifactBinaryOpDecode { value: HirBinaryOp.Rem, valid: true };
    }
    if (value == 5u8) {
        return ZirlHirArtifactBinaryOpDecode { value: HirBinaryOp.Eq, valid: true };
    }
    if (value == 6u8) {
        return ZirlHirArtifactBinaryOpDecode { value: HirBinaryOp.Ne, valid: true };
    }
    if (value == 7u8) {
        return ZirlHirArtifactBinaryOpDecode { value: HirBinaryOp.Lt, valid: true };
    }
    if (value == 8u8) {
        return ZirlHirArtifactBinaryOpDecode { value: HirBinaryOp.Le, valid: true };
    }
    if (value == 9u8) {
        return ZirlHirArtifactBinaryOpDecode { value: HirBinaryOp.Gt, valid: true };
    }
    if (value == 10u8) {
        return ZirlHirArtifactBinaryOpDecode { value: HirBinaryOp.Ge, valid: true };
    }
    if (value == 11u8) {
        return ZirlHirArtifactBinaryOpDecode { value: HirBinaryOp.And, valid: true };
    }
    if (value == 12u8) {
        return ZirlHirArtifactBinaryOpDecode { value: HirBinaryOp.Or, valid: true };
    }
    if (value == 13u8) {
        return ZirlHirArtifactBinaryOpDecode { value: HirBinaryOp.Xor, valid: true };
    }
    if (value == 14u8) {
        return ZirlHirArtifactBinaryOpDecode { value: HirBinaryOp.Shl, valid: true };
    }
    if (value == 15u8) {
        return ZirlHirArtifactBinaryOpDecode { value: HirBinaryOp.Shr, valid: true };
    }
    return ZirlHirArtifactBinaryOpDecode { value: HirBinaryOp.Add, valid: false };
}

fn artifact_hir_unary_op(value: u8): ZirlHirArtifactUnaryOpDecode {
    if (value == 0u8) {
        return ZirlHirArtifactUnaryOpDecode { value: HirUnaryOp.Neg, valid: true };
    }
    if (value == 1u8) {
        return ZirlHirArtifactUnaryOpDecode { value: HirUnaryOp.Not, valid: true };
    }
    if (value == 2u8) {
        return ZirlHirArtifactUnaryOpDecode { value: HirUnaryOp.BitNot, valid: true };
    }
    if (value == 3u8) {
        return ZirlHirArtifactUnaryOpDecode { value: HirUnaryOp.Ref, valid: true };
    }
    if (value == 4u8) {
        return ZirlHirArtifactUnaryOpDecode { value: HirUnaryOp.Deref, valid: true };
    }
    return ZirlHirArtifactUnaryOpDecode { value: HirUnaryOp.Neg, valid: false };
}

fn artifact_hir_safety_mode(
    value: ZirlCompactSafetyMode
): ZirlHirArtifactSafetyDecode {
    if (value == ZirlCompactSafetyMode.RequiredCheck) {
        return ZirlHirArtifactSafetyDecode {
            value: HirSafetyMode.RequiredCheck,
            valid: true,
        };
    }
    if (value == ZirlCompactSafetyMode.Guarded) {
        return ZirlHirArtifactSafetyDecode {
            value: HirSafetyMode.Guarded,
            valid: true,
        };
    }
    if (value == ZirlCompactSafetyMode.Intrinsic) {
        return ZirlHirArtifactSafetyDecode {
            value: HirSafetyMode.Intrinsic,
            valid: true,
        };
    }
    if (value == ZirlCompactSafetyMode.Raw) {
        return ZirlHirArtifactSafetyDecode {
            value: HirSafetyMode.Raw,
            valid: true,
        };
    }
    return ZirlHirArtifactSafetyDecode {
        value: HirSafetyMode.RequiredCheck,
        valid: false,
    };
}

fn artifact_hir_layout_intrinsic(
    value: u32
): ZirlHirArtifactLayoutDecode {
    if (value == 0u32) {
        return ZirlHirArtifactLayoutDecode {
            value: HirLayoutIntrinsicKind.OffsetOf,
            valid: true,
        };
    }
    if (value == 1u32) {
        return ZirlHirArtifactLayoutDecode {
            value: HirLayoutIntrinsicKind.AlignOf,
            valid: true,
        };
    }
    if (value == 2u32) {
        return ZirlHirArtifactLayoutDecode {
            value: HirLayoutIntrinsicKind.SizeOf,
            valid: true,
        };
    }
    if (value == 3u32) {
        return ZirlHirArtifactLayoutDecode {
            value: HirLayoutIntrinsicKind.LengthOf,
            valid: true,
        };
    }
    if (value == 4u32) {
        return ZirlHirArtifactLayoutDecode {
            value: HirLayoutIntrinsicKind.PtrOf,
            valid: true,
        };
    }
    return ZirlHirArtifactLayoutDecode {
        value: HirLayoutIntrinsicKind.OffsetOf,
        valid: false,
    };
}

fn failed_hir_artifact_write(): ZirlArtifactWriteResult {
    return ZirlArtifactWriteResult {
        size: 0u64,
        error: ZirlArtifactError.InvalidSections,
    };
}

fn empty_hir_artifact_read(
    error: ZirlHirArtifactReadError,
    storage: *ZirlHirArtifactReadStorage
): ZirlHirArtifactReadResult {
    let no_text: [0]char = [];
    let no_dependencies: [0]ZirlArtifactDependency = [];
    return ZirlHirArtifactReadResult {
        identity: ZirlArtifactIdentity {
            canonical_path: raw no_text[0u64..0u64],
            module_name: raw no_text[0u64..0u64],
            semantic_profile_name: raw no_text[0u64..0u64],
            semantic_profile_version: 0u32,
            source_fingerprint_primary: 0u64,
            source_fingerprint_secondary: 0u64,
            public_abi_hi: 0u32,
            public_abi_lo: 0u32,
            optional_features: 0u64,
            declaration_count: 0u32,
            template_count: 0u32,
            function_count: 0u32,
            dependencies: raw no_dependencies[0u64..0u64],
        },
        metadata: ZirlMetadataSection {
            module_name: raw storage->metadata.module_name[0u64..0u64],
            paths: raw storage->metadata.paths[0u64..0u64],
            strings: raw storage->metadata.strings[0u64..0u64],
            types: raw storage->metadata.types[0u64..0u64],
            struct_defs: raw storage->metadata.struct_defs[0u64..0u64],
            enum_defs: raw storage->metadata.enum_defs[0u64..0u64],
            union_defs: raw storage->metadata.union_defs[0u64..0u64],
        },
        declarations: ZirlDeclSection {
            declarations: raw storage->declarations.declarations[0u64..0u64],
        },
        templates: ZirlTemplateSection {
            templates: raw storage->templates.templates[0u64..0u64],
        },
        code: ZirlCodeSection {
            expressions: raw storage->code.expressions[0u64..0u64],
            functions: raw storage->code.functions[0u64..0u64],
            globals: raw storage->code.globals[0u64..0u64],
            vtables: raw storage->code.vtables[0u64..0u64],
            canonical_mappings:
                raw storage->code.canonical_mappings[0u64..0u64],
        },
        attrs: ZirlAttrsSection {
            slots: raw storage->attrs.slots[0u64..0u64],
            calls: raw storage->attrs.calls[0u64..0u64],
            functions: raw storage->attrs.functions[0u64..0u64],
            safety_proofs:
                raw storage->attrs.safety_proofs[0u64..0u64],
        },
        error: error,
    };
}

fn hir_artifact_find_section(
    sections: []ZirlArtifactSection,
    section_id: u16
): ZirlArtifactSection {
    let no_bytes: [0]u8 = [];
    for (offset in 1u64..@lengthOf(sections)) {
        let index = offset - 1;
        let section: ZirlArtifactSection = raw sections[index];
        if (section.id == section_id) {
            return section;
        }
    }
    return ZirlArtifactSection {
        id: section_id,
        flags: 0u16,
        schema_version: 0u16,
        payload: raw no_bytes[0u64..0u64],
    };
}

fn hir_artifact_text_matches(left: []char, right: []char): bool {
    if (@lengthOf(left) != @lengthOf(right)) {
        return false;
    }
    for (offset in 1u64..@lengthOf(left)) {
        let index = offset - 1;
        if (raw left[index] != raw right[index]) {
            return false;
        }
    }
    return true;
}

pub fn read_zirl_hir_artifact_sections(
    bytes: []u8,
    storage: *ZirlHirArtifactReadStorage
): ZirlHirArtifactReadResult {
    let artifact = read_zirl_artifact(bytes, &raw storage->artifact);
    if (artifact.error != ZirlArtifactError.None) {
        return empty_hir_artifact_read(
            ZirlHirArtifactReadError.InvalidArtifact,
            storage
        );
    }

    let metadata_section =
        hir_artifact_find_section(artifact.sections, zirlHirMetadataSectionId);
    let declarations_section =
        hir_artifact_find_section(artifact.sections, zirlHirDeclsSectionId);
    let templates_section =
        hir_artifact_find_section(artifact.sections, zirlHirTemplatesSectionId);
    let code_section =
        hir_artifact_find_section(artifact.sections, zirlHirCodeSectionId);
    let attrs_section =
        hir_artifact_find_section(artifact.sections, zirlHirAttrsSectionId);

    let metadata = read_metadata_section(
        ZirlByteReader {
            bytes: metadata_section.payload,
            position: 0u64,
            failed: false,
        },
        &raw storage->metadata
    );
    if (metadata.reader.failed) {
        return empty_hir_artifact_read(
            ZirlHirArtifactReadError.InvalidSectionPayload,
            storage
        );
    }
    if (metadata.reader.position != @lengthOf(metadata_section.payload)) {
        return empty_hir_artifact_read(
            ZirlHirArtifactReadError.TrailingSectionPayload,
            storage
        );
    }

    let declarations = read_decls_section(
        ZirlByteReader {
            bytes: declarations_section.payload,
            position: 0u64,
            failed: false,
        },
        &raw storage->declarations
    );
    if (declarations.reader.failed) {
        return empty_hir_artifact_read(
            ZirlHirArtifactReadError.InvalidSectionPayload,
            storage
        );
    }
    if (declarations.reader.position !=
        @lengthOf(declarations_section.payload)) {
        return empty_hir_artifact_read(
            ZirlHirArtifactReadError.TrailingSectionPayload,
            storage
        );
    }

    let templates = read_templates_section(
        ZirlByteReader {
            bytes: templates_section.payload,
            position: 0u64,
            failed: false,
        },
        &raw storage->templates
    );
    if (templates.reader.failed) {
        return empty_hir_artifact_read(
            ZirlHirArtifactReadError.InvalidSectionPayload,
            storage
        );
    }
    if (templates.reader.position != @lengthOf(templates_section.payload)) {
        return empty_hir_artifact_read(
            ZirlHirArtifactReadError.TrailingSectionPayload,
            storage
        );
    }

    let code = read_code_section(
        ZirlByteReader {
            bytes: code_section.payload,
            position: 0u64,
            failed: false,
        },
        &raw storage->code
    );
    if (code.reader.failed) {
        return empty_hir_artifact_read(
            ZirlHirArtifactReadError.InvalidSectionPayload,
            storage
        );
    }
    if (code.reader.position != @lengthOf(code_section.payload)) {
        return empty_hir_artifact_read(
            ZirlHirArtifactReadError.TrailingSectionPayload,
            storage
        );
    }

    let attrs = read_attrs_section(
        ZirlByteReader {
            bytes: attrs_section.payload,
            position: 0u64,
            failed: false,
        },
        &raw storage->attrs
    );
    if (attrs.reader.failed) {
        return empty_hir_artifact_read(
            ZirlHirArtifactReadError.InvalidSectionPayload,
            storage
        );
    }
    if (attrs.reader.position != @lengthOf(attrs_section.payload)) {
        return empty_hir_artifact_read(
            ZirlHirArtifactReadError.TrailingSectionPayload,
            storage
        );
    }

    if (not hir_artifact_text_matches(
            artifact.module_name,
            metadata.value.module_name
        ) or
        (artifact.header.declaration_count as u64) !=
            @lengthOf(declarations.value.declarations) or
        (artifact.header.template_count as u64) !=
            @lengthOf(templates.value.templates) or
        (artifact.header.function_count as u64) !=
            @lengthOf(code.value.functions)) {
        return empty_hir_artifact_read(
            ZirlHirArtifactReadError.IdentityMismatch,
            storage
        );
    }

    return ZirlHirArtifactReadResult {
        identity: ZirlArtifactIdentity {
            canonical_path: artifact.canonical_path,
            module_name: artifact.module_name,
            semantic_profile_name: artifact.semantic_profile_name,
            semantic_profile_version: artifact.header.semantic_profile_version,
            source_fingerprint_primary:
                artifact.header.source_fingerprint_primary,
            source_fingerprint_secondary:
                artifact.header.source_fingerprint_secondary,
            public_abi_hi: artifact.header.public_abi_hi,
            public_abi_lo: artifact.header.public_abi_lo,
            optional_features: artifact.header.optional_features,
            declaration_count: artifact.header.declaration_count,
            template_count: artifact.header.template_count,
            function_count: artifact.header.function_count,
            dependencies: artifact.dependencies,
        },
        metadata: metadata.value,
        declarations: declarations.value,
        templates: templates.value,
        code: code.value,
        attrs: attrs.value,
        error: ZirlHirArtifactReadError.None,
    };
}

fn empty_hir_artifact_module_result(
    error: ZirlHirArtifactReadError,
    read_storage: *ZirlHirArtifactReadStorage,
    hydration_storage: *ZirlHirArtifactHydrationStorage
): ZirlHirArtifactModuleReadResult {
    let empty = empty_hir_artifact_read(error, read_storage);
    return ZirlHirArtifactModuleReadResult {
        identity: empty.identity,
        paths: empty.metadata.paths,
        module: HirModule {
            strings: raw read_storage->metadata.strings[0u64..0u64],
            types: raw read_storage->metadata.types[0u64..0u64],
            struct_defs: raw read_storage->metadata.struct_defs[0u64..0u64],
            enum_defs: raw read_storage->metadata.enum_defs[0u64..0u64],
            union_defs: raw read_storage->metadata.union_defs[0u64..0u64],
            expressions:
                raw hydration_storage->module.expressions[0u64..0u64],
            functions: raw hydration_storage->module.functions[0u64..0u64],
            declarations:
                raw hydration_storage->module.declarations[0u64..0u64],
            templates:
                raw hydration_storage->module.templates[0u64..0u64],
            global_constants:
                raw hydration_storage->module.global_constants[0u64..0u64],
            vtables: raw hydration_storage->module.vtables[0u64..0u64],
            slot_attrs: raw hydration_storage->module.slot_attrs[0u64..0u64],
            call_attrs: raw hydration_storage->module.call_attrs[0u64..0u64],
            function_attrs:
                raw hydration_storage->module.function_attrs[0u64..0u64],
            safety_attrs: HirSafetyAttrs {
                proofs: raw hydration_storage->module.safety_attrs.proofs[
                    0u64..0u64
                ],
            },
        },
        error: error,
    };
}

fn artifact_function_reference(
    signature_type_id: u32,
    function_name_id: u32,
    type_count: u64,
    functions: []ZirlCompactFunction
): ZirlHirArtifactFunctionReference {
    if (signature_type_id == invalidZirlType and
        function_name_id == invalidString) {
        return ZirlHirArtifactFunctionReference {
            value: invalidFunction,
            failed: false,
        };
    }
    if (signature_type_id == invalidZirlType or
        function_name_id == invalidString or
        (signature_type_id as u64) < type_count) {
        return ZirlHirArtifactFunctionReference {
            value: invalidFunction,
            failed: true,
        };
    }
    let function_index = (signature_type_id as u64) - type_count;
    if (function_index >= @lengthOf(functions)) {
        return ZirlHirArtifactFunctionReference {
            value: invalidFunction,
            failed: true,
        };
    }
    let function: ZirlCompactFunction = raw functions[function_index];
    if (function.signature_type_id != signature_type_id or
        function.name_id != function_name_id) {
        return ZirlHirArtifactFunctionReference {
            value: invalidFunction,
            failed: true,
        };
    }
    return ZirlHirArtifactFunctionReference {
        value: function_index as HirFunctionId,
        failed: false,
    };
}

fn artifact_hir_call(
    expression: *ZirlCompactExpr,
    argument_types: []HirTypeId,
    type_count: u64,
    functions: []ZirlCompactFunction
): ZirlHirArtifactCallDecode {
    let resolved = artifact_function_reference(
        expression->resolved_function_signature_type_id,
        expression->resolved_function_name_id,
        type_count,
        functions
    );
    if (expression->flags > 3u8) {
        return ZirlHirArtifactCallDecode {
            value: HirCall {
                callee: invalidExpr,
                args: raw expression->args[0u64..0u64],
                argument_types: raw argument_types[0u64..0u64],
                function_type: invalidType,
                resolved_function: invalidFunction,
                variadic_slice_param: 0xFFFFFFFFu32,
                is_variadic_slice: false,
                auto_collect_tail: false,
                uses_tail_calling_convention: false,
                must_tail: false,
            },
            error: ZirlHirArtifactReadError.InvalidSectionPayload,
        };
    }
    if (resolved.failed) {
        return ZirlHirArtifactCallDecode {
            value: HirCall {
                callee: invalidExpr,
                args: raw expression->args[0u64..0u64],
                argument_types: raw argument_types[0u64..0u64],
                function_type: invalidType,
                resolved_function: invalidFunction,
                variadic_slice_param: 0xFFFFFFFFu32,
                is_variadic_slice: false,
                auto_collect_tail: false,
                uses_tail_calling_convention: false,
                must_tail: false,
            },
            error: ZirlHirArtifactReadError.InvalidCanonicalReference,
        };
    }
    return ZirlHirArtifactCallDecode {
        value: HirCall {
            callee: expression->ref_a,
            args: expression->args,
            argument_types: argument_types,
            function_type: expression->ref_e,
            resolved_function: resolved.value,
            variadic_slice_param: expression->variadic_slice_param,
            is_variadic_slice: expression->is_variadic_slice,
            auto_collect_tail: expression->auto_collect_tail,
            uses_tail_calling_convention:
                expression->flags == 2u8 or expression->flags == 3u8,
            must_tail:
                expression->flags == 1u8 or expression->flags == 3u8,
        },
        error: ZirlHirArtifactReadError.None,
    };
}

fn failed_hir_artifact_expression(
    error: ZirlHirArtifactReadError
): ZirlHirArtifactExpressionDecode {
    return ZirlHirArtifactExpressionDecode {
        value: HirExpr { HirRuntimePanic { code: 0u32 } },
        error: error,
    };
}

fn decode_hir_artifact_expression(
    expression: *ZirlCompactExpr,
    argument_types: []HirTypeId,
    type_count: u64,
    functions: []ZirlCompactFunction
): ZirlHirArtifactExpressionDecode {
    if (expression->kind == (ZirlCompactExprKind.Literal as u8)) {
        if (expression->flags > 3u8) {
            return failed_hir_artifact_expression(
                ZirlHirArtifactReadError.InvalidSectionPayload
            );
        }
        var literal = HirLiteral {
            value_kind: HirLiteralKind.Integer,
            integer: expression->int_value,
            float: expression->float_value,
            boolean: expression->int_value != 0i64,
            string_id: expression->name_id,
            type_id: expression->type_id,
        };
        if (expression->flags == 1u8) {
            literal.value_kind = HirLiteralKind.Float;
        } else if (expression->flags == 2u8) {
            if (expression->int_value != 0i64 and
                expression->int_value != 1i64) {
                return failed_hir_artifact_expression(
                    ZirlHirArtifactReadError.InvalidSectionPayload
                );
            }
            literal.value_kind = HirLiteralKind.Boolean;
            literal.boolean = expression->int_value == 1i64;
        } else if (expression->flags == 3u8) {
            literal.value_kind = HirLiteralKind.String;
        }
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr { literal },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.Binary as u8)) {
        let op = artifact_hir_binary_op(expression->op);
        if (not op.valid) {
            return failed_hir_artifact_expression(
                ZirlHirArtifactReadError.InvalidSectionPayload
            );
        }
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirBinary {
                    lhs: expression->ref_a,
                    rhs: expression->ref_b,
                    op: op.value,
                    type_id: expression->type_id,
                    operand_type: expression->ref_e,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.Unary as u8)) {
        let op = artifact_hir_unary_op(expression->op);
        if (not op.valid) {
            return failed_hir_artifact_expression(
                ZirlHirArtifactReadError.InvalidSectionPayload
            );
        }
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirUnary {
                    op: op.value,
                    operand: expression->ref_a,
                    type_id: expression->type_id,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.Let as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirLet {
                    name_id: expression->name_id,
                    type_id: expression->type_id,
                    init: expression->ref_a,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.Var as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirVar {
                    name_id: expression->name_id,
                    version: expression->ref_c,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.Call as u8) or
        expression->kind == (ZirlCompactExprKind.StateTailCall as u8)) {
        let call = artifact_hir_call(
            expression,
            argument_types,
            type_count,
            functions
        );
        if (call.error != ZirlHirArtifactReadError.None) {
            return failed_hir_artifact_expression(call.error);
        }
        if (expression->kind == (ZirlCompactExprKind.StateTailCall as u8)) {
            return ZirlHirArtifactExpressionDecode {
                value: HirExpr { HirStateTailCall { call: call.value } },
                error: ZirlHirArtifactReadError.None,
            };
        }
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr { call.value },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.Ret as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr { HirRet { value: expression->ref_a } },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.Branch as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirBranch {
                    condition: expression->ref_a,
                    then_block: expression->ref_c,
                    else_block: expression->ref_d,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.Jump as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr { HirJump { target: expression->ref_c } },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.Phi as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr { HirPhi { incoming: expression->args } },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.Assign as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirAssign {
                    target: expression->ref_a,
                    value: expression->ref_b,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.Index as u8)) {
        let safety = artifact_hir_safety_mode(expression->safety);
        if (expression->flags > 1u8 or not safety.valid) {
            return failed_hir_artifact_expression(
                ZirlHirArtifactReadError.InvalidSectionPayload
            );
        }
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirIndex {
                    object: expression->ref_a,
                    index: expression->ref_b,
                    type_id: expression->type_id,
                    object_type: expression->ref_e,
                    is_array: expression->flags == 1u8,
                    safety: safety.value,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.Field as u8)) {
        let safety = artifact_hir_safety_mode(expression->safety);
        if (not safety.valid) {
            return failed_hir_artifact_expression(
                ZirlHirArtifactReadError.InvalidSectionPayload
            );
        }
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirField {
                    object: expression->ref_a,
                    index: expression->ref_c,
                    type_id: expression->type_id,
                    object_type: expression->ref_e,
                    safety: safety.value,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.StructLiteral as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirStructLiteral {
                    values: expression->args,
                    type_id: expression->type_id,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.ArrayLiteral as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirArrayLiteral {
                    elements: expression->args,
                    type_id: expression->type_id,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.EnumValue as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirEnumValue {
                    value: expression->int_value,
                    type_id: expression->type_id,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.SlotAlloca as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirSlotAlloca {
                    slot: expression->ref_a,
                    type_id: expression->type_id,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.SlotStore as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirSlotStore {
                    slot: expression->ref_a,
                    value: expression->ref_b,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.SlotLoad as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirSlotLoad {
                    slot: expression->ref_a,
                    type_id: expression->type_id,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.SlotAddr as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirSlotAddr {
                    slot: expression->ref_a,
                    type_id: expression->type_id,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.MakeNone as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr { HirMakeNone { type_id: expression->type_id } },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.MakeSome as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirMakeSome {
                    value: expression->ref_a,
                    type_id: expression->type_id,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.MakeSlice as u8)) {
        let safety = artifact_hir_safety_mode(expression->safety);
        if ((expression->flags != 0u8 and expression->flags != 1u8 and
             expression->flags != 4u8 and expression->flags != 5u8) or
            not safety.valid) {
            return failed_hir_artifact_expression(
                ZirlHirArtifactReadError.InvalidSectionPayload
            );
        }
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirMakeSlice {
                    object: expression->ref_a,
                    lo: expression->ref_b,
                    hi: expression->ref_c,
                    type_id: expression->type_id,
                    object_type: expression->ref_e,
                    bound_type: expression->ref_f,
                    is_array: expression->flags == 1u8 or
                        expression->flags == 5u8,
                    is_pointer: expression->flags == 4u8 or
                        expression->flags == 5u8,
                    safety: safety.value,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.Cast as u8)) {
        if (expression->flags > 1u8) {
            return failed_hir_artifact_expression(
                ZirlHirArtifactReadError.InvalidSectionPayload
            );
        }
        if (expression->flags == 1u8 or
            expression->ref_c != invalidZirlType) {
            let safety = artifact_hir_safety_mode(expression->safety);
            if (not safety.valid) {
                return failed_hir_artifact_expression(
                    ZirlHirArtifactReadError.InvalidSectionPayload
                );
            }
            return ZirlHirArtifactExpressionDecode {
                value: HirExpr {
                    HirUnionCast {
                        value: expression->ref_a,
                        from_type: expression->ref_e,
                        to_type: expression->ref_b,
                        member_index: expression->ref_c,
                        safety: safety.value,
                    }
                },
                error: ZirlHirArtifactReadError.None,
            };
        }
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirCast {
                    value: expression->ref_a,
                    from_type: expression->ref_e,
                    to_type: expression->ref_b,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.UnionCheck as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirUnionCheck {
                    value: expression->ref_a,
                    union_type: expression->ref_b,
                    member_index: expression->ref_c,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.LayoutIntrinsic as u8)) {
        let intrinsic = artifact_hir_layout_intrinsic(expression->ref_e);
        if (not intrinsic.valid) {
            return failed_hir_artifact_expression(
                ZirlHirArtifactReadError.InvalidSectionPayload
            );
        }
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirLayoutIntrinsic {
                    kind: intrinsic.value,
                    type_id: expression->type_id,
                    field_index: expression->ref_f,
                    operand: expression->ref_a,
                    operand_type: expression->ref_b,
                    string_length: expression->int_value as u64,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.CanonicalType as u8)) {
        if (@lengthOf(expression->integers) != 2u64) {
            return failed_hir_artifact_expression(
                ZirlHirArtifactReadError.InvalidSectionPayload
            );
        }
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirCanonicalType {
                    canonical_hi: must expression->integers[0u64],
                    canonical_lo: must expression->integers[1u64],
                    type_id: expression->type_id,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.Cleanup as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirCleanup { expressions: expression->args }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.GlobalConstLoad as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirGlobalConstLoad {
                    name_id: expression->name_id,
                    type_id: expression->type_id,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.ExternalGlobalAddr as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirExternalGlobalAddr {
                    name_id: expression->name_id,
                    type_id: expression->type_id,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.MakeDyn as u8)) {
        if (expression->flags > 1u8) {
            return failed_hir_artifact_expression(
                ZirlHirArtifactReadError.InvalidSectionPayload
            );
        }
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirMakeDyn {
                    value: expression->ref_a,
                    source_type: expression->ref_b,
                    dyn_type: expression->type_id,
                    vtable_name_id: expression->name_id,
                    value_is_place: expression->flags == 1u8,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.DynCall as u8)) {
        if (expression->flags > 1u8) {
            return failed_hir_artifact_expression(
                ZirlHirArtifactReadError.InvalidSectionPayload
            );
        }
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirDynCall {
                    receiver: expression->ref_a,
                    vtable_name_id: expression->name_id,
                    slot_index: expression->ref_c,
                    has_receiver: expression->flags == 1u8,
                    result_type: expression->type_id,
                    function_type: expression->ref_e,
                    args: expression->args,
                    argument_types: argument_types,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.MakeOpaque as u8)) {
        if (@lengthOf(expression->integers) != 2u64) {
            return failed_hir_artifact_expression(
                ZirlHirArtifactReadError.InvalidSectionPayload
            );
        }
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirMakeOpaque {
                    value: expression->ref_a,
                    source_type: expression->ref_b,
                    opaque_type: expression->type_id,
                    runtime_type_id: expression->ref_c,
                    canonical_hi: must expression->integers[0u64],
                    canonical_lo: must expression->integers[1u64],
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.OpaqueCast as u8)) {
        let safety = artifact_hir_safety_mode(expression->safety);
        if ((expression->flags != 0u8 and expression->flags != 2u8) or
            not safety.valid or
            @lengthOf(expression->integers) != 2u64) {
            return failed_hir_artifact_expression(
                ZirlHirArtifactReadError.InvalidSectionPayload
            );
        }
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirOpaqueCast {
                    value: expression->ref_a,
                    from_type: expression->ref_b,
                    to_type: expression->ref_c,
                    opaque_type: expression->ref_d,
                    result_type: expression->type_id,
                    runtime_type_id: expression->ref_e,
                    canonical_hi: must expression->integers[0u64],
                    canonical_lo: must expression->integers[1u64],
                    safety: safety.value,
                    returns_pointer: expression->flags == 2u8,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.OpaqueCheck as u8)) {
        if (@lengthOf(expression->integers) != 2u64) {
            return failed_hir_artifact_expression(
                ZirlHirArtifactReadError.InvalidSectionPayload
            );
        }
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirOpaqueCheck {
                    value: expression->ref_a,
                    opaque_type: expression->type_id,
                    runtime_type_id: expression->ref_e,
                    canonical_hi: must expression->integers[0u64],
                    canonical_lo: must expression->integers[1u64],
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.RuntimePanic as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirRuntimePanic { code: expression->int_value as u32 }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.Pipe as u8) or
        expression->kind == (ZirlCompactExprKind.PipeDo as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirPipe {
                    source_slot: expression->ref_b,
                    source_type: expression->ref_e,
                    stage: expression->ref_a,
                    type_id: expression->type_id,
                    is_effect:
                        expression->kind == (ZirlCompactExprKind.PipeDo as u8),
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    if (expression->kind == (ZirlCompactExprKind.PipeCurrent as u8)) {
        return ZirlHirArtifactExpressionDecode {
            value: HirExpr {
                HirPipeCurrent {
                    slot: expression->ref_a,
                    type_id: expression->type_id,
                }
            },
            error: ZirlHirArtifactReadError.None,
        };
    }
    return failed_hir_artifact_expression(
        ZirlHirArtifactReadError.InvalidSectionPayload
    );
}

fn failed_hir_artifact_projection(
    error: ZirlHirArtifactProjectionError,
    declaration_storage: *ZirlDeclStorage,
    template_storage: *ZirlTemplateStorage,
    code_storage: *ZirlCodeStorage,
    attrs_storage: *ZirlAttrsStorage
): ZirlHirArtifactProjectionResult {
    return ZirlHirArtifactProjectionResult {
        value: ZirlHirArtifactSections {
            declarations: ZirlDeclSection {
                declarations:
                    raw declaration_storage->declarations[0u64..0u64],
            },
            templates: ZirlTemplateSection {
                templates: raw template_storage->templates[0u64..0u64],
            },
            code: ZirlCodeSection {
                expressions: raw code_storage->expressions[0u64..0u64],
                functions: raw code_storage->functions[0u64..0u64],
                globals: raw code_storage->globals[0u64..0u64],
                vtables: raw code_storage->vtables[0u64..0u64],
                canonical_mappings:
                    raw code_storage->canonical_mappings[0u64..0u64],
            },
            attrs: ZirlAttrsSection {
                slots: raw attrs_storage->slots[0u64..0u64],
                calls: raw attrs_storage->calls[0u64..0u64],
                functions: raw attrs_storage->functions[0u64..0u64],
                safety_proofs:
                    raw attrs_storage->safety_proofs[0u64..0u64],
            },
        },
        error: error,
        canonical_error: ZirlCanonicalTypeError.None,
        code_error: ZirlHirCodeError.None,
        attrs_error: ZirlHirAttrsError.None,
    };
}

fn hir_artifact_canonical_type_id(
    canonical: *ZirlCanonicalTypes,
    local_type_id: HirTypeId
): ZirlTypeId {
    if (local_type_id == invalidType) {
        return invalidZirlType;
    }
    if ((local_type_id as u64) >= @lengthOf(canonical->local_type_ids)) {
        return invalidZirlType;
    }
    return raw canonical->local_type_ids[local_type_id as u64];
}

fn hir_artifact_projection_counts(
    module: *HirModule
): ZirlHirArtifactProjectionCounts {
    var counts = ZirlHirArtifactProjectionCounts {
        declaration_fields: 0u64,
        declaration_methods: 0u64,
        template_params: 0u64,
        template_bounds: 0u64,
        template_param_types: 0u64,
        template_param_names: 0u64,
        template_fields: 0u64,
        template_field_order: 0u64,
        template_methods: 0u64,
        template_traits: 0u64,
        failed: false,
    };
    for (offset in 1u64..@lengthOf(module->declarations)) {
        let index = offset - 1u64;
        let declaration: HirDeclaration = raw module->declarations[index];
        if (@lengthOf(declaration.method_declaration_ids) >
            0xFFFFFFFFu64 - counts.declaration_methods) {
            counts.failed = true;
            return counts;
        }
        counts.declaration_methods =
            counts.declaration_methods +
            @lengthOf(declaration.method_declaration_ids);
        if (declaration.kind == HirDeclarationKind.Struct) {
            if ((declaration.type_id as u64) >= @lengthOf(module->types)) {
                counts.failed = true;
                return counts;
            }
            let struct_type: HirType = raw module->types[declaration.type_id as u64];
            if (struct_type.kind != HirTypeKind.Struct or
                (struct_type.ref0 as u64) >= @lengthOf(module->struct_defs)) {
                counts.failed = true;
                return counts;
            }
            let definition: HirStructDef =
                raw module->struct_defs[struct_type.ref0 as u64];
            if (@lengthOf(definition.field_name_ids) >
                0xFFFFFFFFu64 - counts.declaration_fields) {
                counts.failed = true;
                return counts;
            }
            counts.declaration_fields =
                counts.declaration_fields +
                @lengthOf(definition.field_name_ids);
        }
    }

    for (offset in 1u64..@lengthOf(module->templates)) {
        let index = offset - 1u64;
        let template: HirTemplate = raw module->templates[index];
        if (@lengthOf(template.params) >
                0xFFFFFFFFu64 - counts.template_params or
            @lengthOf(template.param_type_ids) >
                0xFFFFFFFFu64 - counts.template_param_types or
            @lengthOf(template.param_name_ids) >
                0xFFFFFFFFu64 - counts.template_param_names or
            @lengthOf(template.field_name_ids) >
                0xFFFFFFFFu64 - counts.template_fields or
            @lengthOf(template.canonical_field_order) >
                0xFFFFFFFFu64 - counts.template_field_order or
            @lengthOf(template.method_declaration_indices) >
                0xFFFFFFFFu64 - counts.template_methods or
            @lengthOf(template.trait_type_ids) >
                0xFFFFFFFFu64 - counts.template_traits) {
            counts.failed = true;
            return counts;
        }
        counts.template_params =
            counts.template_params + @lengthOf(template.params);
        counts.template_param_types =
            counts.template_param_types + @lengthOf(template.param_type_ids);
        counts.template_param_names =
            counts.template_param_names + @lengthOf(template.param_name_ids);
        counts.template_fields =
            counts.template_fields + @lengthOf(template.field_name_ids);
        counts.template_field_order =
            counts.template_field_order +
            @lengthOf(template.canonical_field_order);
        counts.template_methods =
            counts.template_methods +
            @lengthOf(template.method_declaration_indices);
        counts.template_traits =
            counts.template_traits + @lengthOf(template.trait_type_ids);
        for (param_offset in 1u64..@lengthOf(template.params)) {
            let param_index = param_offset - 1u64;
            let parameter: HirGenericParam = raw template.params[param_index];
            if (@lengthOf(parameter.bound_type_ids) >
                0xFFFFFFFFu64 - counts.template_bounds) {
                counts.failed = true;
                return counts;
            }
            counts.template_bounds =
                counts.template_bounds +
                @lengthOf(parameter.bound_type_ids);
        }
    }
    return counts;
}

fn project_hir_declarations(
    module: *HirModule,
    canonical: *ZirlCanonicalTypes,
    storage: *ZirlDeclStorage,
    counts: ZirlHirArtifactProjectionCounts
): ZirlHirArtifactDeclarationProjection {
    if (@lengthOf(module->declarations) > @lengthOf(storage->declarations) or
        counts.declaration_fields > @lengthOf(storage->field_name_ids) or
        counts.declaration_fields > @lengthOf(storage->field_type_ids) or
        counts.declaration_methods >
            @lengthOf(storage->method_declaration_indices)) {
        return ZirlHirArtifactDeclarationProjection {
            value: ZirlDeclSection {
                declarations: raw storage->declarations[0u64..0u64],
            },
            error: ZirlHirArtifactProjectionError.InsufficientDeclarationStorage,
        };
    }

    var field_offset = 0u64;
    var method_offset = 0u64;
    for (offset in 1u64..@lengthOf(module->declarations)) {
        let index = offset - 1u64;
        let source: HirDeclaration = raw module->declarations[index];
        let canonical_type_id =
            hir_artifact_canonical_type_id(canonical, source.type_id);
        if (source.type_id != invalidType and
            canonical_type_id == invalidZirlType) {
            return ZirlHirArtifactDeclarationProjection {
                value: ZirlDeclSection {
                    declarations: raw storage->declarations[0u64..0u64],
                },
                error: ZirlHirArtifactProjectionError.InvalidDeclarationProjection,
            };
        }
        var field_names: []HirStringId =
            raw storage->field_name_ids[field_offset..field_offset];
        var field_types: []HirTypeId =
            raw storage->field_type_ids[field_offset..field_offset];
        if (source.kind == HirDeclarationKind.Struct) {
            let struct_type: HirType = raw module->types[source.type_id as u64];
            if (struct_type.kind != HirTypeKind.Struct or
                (struct_type.ref0 as u64) >= @lengthOf(module->struct_defs)) {
                return ZirlHirArtifactDeclarationProjection {
                    value: ZirlDeclSection {
                        declarations: raw storage->declarations[0u64..0u64],
                    },
                    error: ZirlHirArtifactProjectionError.InvalidDeclarationProjection,
                };
            }
            let definition: HirStructDef =
                raw module->struct_defs[struct_type.ref0 as u64];
            let next_field_offset =
                field_offset + @lengthOf(definition.field_name_ids);
            field_names =
                raw storage->field_name_ids[field_offset..next_field_offset];
            field_types =
                raw storage->field_type_ids[field_offset..next_field_offset];
            for (field_offset_in_record in
                1u64..@lengthOf(definition.field_name_ids)) {
                let field_index = field_offset_in_record - 1u64;
                let local_type_id: HirTypeId =
                    raw definition.field_type_ids[field_index];
                let mapped =
                    hir_artifact_canonical_type_id(canonical, local_type_id);
                if (mapped == invalidZirlType) {
                    return ZirlHirArtifactDeclarationProjection {
                        value: ZirlDeclSection {
                            declarations:
                                raw storage->declarations[0u64..0u64],
                        },
                        error: ZirlHirArtifactProjectionError.InvalidDeclarationProjection,
                    };
                }
                raw field_names[field_index] =
                    raw definition.field_name_ids[field_index];
                raw field_types[field_index] = mapped as HirTypeId;
            }
            field_offset = next_field_offset;
        }
        let next_method_offset =
            method_offset + @lengthOf(source.method_declaration_ids);
        var methods = raw storage->method_declaration_indices[
            method_offset..next_method_offset
        ];
        for (method_offset_in_record in
            1u64..@lengthOf(source.method_declaration_ids)) {
            let method_index = method_offset_in_record - 1u64;
            raw methods[method_index] =
                raw source.method_declaration_ids[method_index];
        }
        let template_index = if (source.template_id == invalidTemplate) {
            invalidZirlType
        } else {
            source.template_id
        };
        let body_function_index =
            if (source.body_function_id == invalidFunction) {
                invalidZirlType
            } else {
                source.body_function_id
            };
        raw storage->declarations[index] = ZirlDeclarationRecord {
            kind: source.kind,
            visibility: source.visibility,
            is_extern: source.is_extern,
            discardable: source.discardable,
            module_depth: source.module_depth,
            name_id: source.name_id,
            type_id: canonical_type_id,
            template_index: template_index,
            body_function_index: body_function_index,
            field_name_ids: field_names,
            field_type_ids: field_types,
            method_declaration_indices: methods,
        };
        method_offset = next_method_offset;
    }
    return ZirlHirArtifactDeclarationProjection {
        value: ZirlDeclSection {
            declarations:
                raw storage->declarations[0u64..@lengthOf(module->declarations)],
        },
        error: ZirlHirArtifactProjectionError.None,
    };
}

fn template_function_signature_matches(
    template: HirTemplate,
    function: HirFunction
): bool {
    if (template.return_type_id != function.return_type or
        @lengthOf(template.param_type_ids) !=
            @lengthOf(function.parameter_types) or
        @lengthOf(template.param_name_ids) !=
            @lengthOf(function.parameter_name_ids)) {
        return false;
    }
    for (offset in 1u64..@lengthOf(template.param_type_ids)) {
        let index = offset - 1u64;
        if (raw template.param_type_ids[index] !=
                raw function.parameter_types[index] or
            raw template.param_name_ids[index] !=
                raw function.parameter_name_ids[index]) {
            return false;
        }
    }
    return true;
}

fn project_hir_templates(
    module: *HirModule,
    canonical: *ZirlCanonicalTypes,
    storage: *ZirlTemplateStorage,
    counts: ZirlHirArtifactProjectionCounts
): ZirlHirArtifactTemplateProjection {
    if (@lengthOf(module->templates) > @lengthOf(storage->templates) or
        counts.template_params > @lengthOf(storage->params) or
        counts.template_bounds > @lengthOf(storage->param_bound_type_ids) or
        counts.template_param_types > @lengthOf(storage->param_type_ids) or
        counts.template_param_names > @lengthOf(storage->param_name_ids) or
        counts.template_fields > @lengthOf(storage->field_name_ids) or
        counts.template_fields > @lengthOf(storage->field_type_ids) or
        counts.template_field_order > @lengthOf(storage->canonical_field_order) or
        counts.template_methods >
            @lengthOf(storage->method_declaration_indices) or
        counts.template_traits > @lengthOf(storage->trait_type_ids)) {
        return ZirlHirArtifactTemplateProjection {
            value: ZirlTemplateSection {
                templates: raw storage->templates[0u64..0u64],
            },
            error: ZirlHirArtifactProjectionError.InsufficientTemplateStorage,
        };
    }

    var param_offset = 0u64;
    var bound_offset = 0u64;
    var param_type_offset = 0u64;
    var param_name_offset = 0u64;
    var field_offset = 0u64;
    var field_order_offset = 0u64;
    var method_offset = 0u64;
    var trait_offset = 0u64;
    for (offset in 1u64..@lengthOf(module->templates)) {
        let index = offset - 1u64;
        let source: HirTemplate = raw module->templates[index];
        if (source.function_id != invalidFunction) {
            if ((source.function_id as u64) >= @lengthOf(module->functions)) {
                return ZirlHirArtifactTemplateProjection {
                    value: ZirlTemplateSection {
                        templates: raw storage->templates[0u64..0u64],
                    },
                    error: ZirlHirArtifactProjectionError.InvalidTemplateProjection,
                };
            }
            let function: HirFunction =
                raw module->functions[source.function_id as u64];
            if (not template_function_signature_matches(source, function)) {
                return ZirlHirArtifactTemplateProjection {
                    value: ZirlTemplateSection {
                        templates: raw storage->templates[0u64..0u64],
                    },
                    error: ZirlHirArtifactProjectionError.InvalidTemplateProjection,
                };
            }
        }

        let mapped_return =
            hir_artifact_canonical_type_id(canonical, source.return_type_id);
        if (mapped_return == invalidZirlType) {
            return ZirlHirArtifactTemplateProjection {
                value: ZirlTemplateSection {
                    templates: raw storage->templates[0u64..0u64],
                },
                error: ZirlHirArtifactProjectionError.InvalidTemplateProjection,
            };
        }
        let template_param_start = param_offset;
        for (param_iteration in 1u64..@lengthOf(source.params)) {
            let param_index = param_iteration - 1u64;
            let parameter: HirGenericParam = raw source.params[param_index];
            let next_bound_offset =
                bound_offset + @lengthOf(parameter.bound_type_ids);
            var bounds =
                raw storage->param_bound_type_ids[bound_offset..next_bound_offset];
            for (bound_iteration in 1u64..@lengthOf(parameter.bound_type_ids)) {
                let bound_index = bound_iteration - 1u64;
                let mapped = hir_artifact_canonical_type_id(
                    canonical,
                    raw parameter.bound_type_ids[bound_index]
                );
                if (mapped == invalidZirlType) {
                    return ZirlHirArtifactTemplateProjection {
                        value: ZirlTemplateSection {
                            templates: raw storage->templates[0u64..0u64],
                        },
                        error: ZirlHirArtifactProjectionError.InvalidTemplateProjection,
                    };
                }
                raw bounds[bound_index] = mapped as HirTypeId;
            }
            raw storage->params[param_offset] = ZirlGenericParamRecord {
                name_id: parameter.name_id,
                bound_type_ids: bounds,
            };
            param_offset = param_offset + 1u64;
            bound_offset = next_bound_offset;
        }

        let next_param_type_offset =
            param_type_offset + @lengthOf(source.param_type_ids);
        var param_types = raw storage->param_type_ids[
            param_type_offset..next_param_type_offset
        ];
        for (param_iteration in 1u64..@lengthOf(source.param_type_ids)) {
            let param_index = param_iteration - 1u64;
            let mapped = hir_artifact_canonical_type_id(
                canonical,
                raw source.param_type_ids[param_index]
            );
            if (mapped == invalidZirlType) {
                return ZirlHirArtifactTemplateProjection {
                    value: ZirlTemplateSection {
                        templates: raw storage->templates[0u64..0u64],
                    },
                    error: ZirlHirArtifactProjectionError.InvalidTemplateProjection,
                };
            }
            raw param_types[param_index] = mapped as HirTypeId;
        }
        let next_param_name_offset =
            param_name_offset + @lengthOf(source.param_name_ids);
        var param_names = raw storage->param_name_ids[
            param_name_offset..next_param_name_offset
        ];
        for (name_iteration in 1u64..@lengthOf(source.param_name_ids)) {
            let name_index = name_iteration - 1u64;
            raw param_names[name_index] = raw source.param_name_ids[name_index];
        }

        let next_field_offset = field_offset + @lengthOf(source.field_name_ids);
        var field_names =
            raw storage->field_name_ids[field_offset..next_field_offset];
        var field_types =
            raw storage->field_type_ids[field_offset..next_field_offset];
        for (field_iteration in 1u64..@lengthOf(source.field_name_ids)) {
            let field_index = field_iteration - 1u64;
            let mapped = hir_artifact_canonical_type_id(
                canonical,
                raw source.field_type_ids[field_index]
            );
            if (mapped == invalidZirlType) {
                return ZirlHirArtifactTemplateProjection {
                    value: ZirlTemplateSection {
                        templates: raw storage->templates[0u64..0u64],
                    },
                    error: ZirlHirArtifactProjectionError.InvalidTemplateProjection,
                };
            }
            raw field_names[field_index] = raw source.field_name_ids[field_index];
            raw field_types[field_index] = mapped as HirTypeId;
        }
        let next_field_order_offset =
            field_order_offset + @lengthOf(source.canonical_field_order);
        var field_order = raw storage->canonical_field_order[
            field_order_offset..next_field_order_offset
        ];
        for (order_iteration in 1u64..@lengthOf(source.canonical_field_order)) {
            let order_index = order_iteration - 1u64;
            raw field_order[order_index] =
                raw source.canonical_field_order[order_index];
        }
        let next_method_offset =
            method_offset + @lengthOf(source.method_declaration_indices);
        var methods = raw storage->method_declaration_indices[
            method_offset..next_method_offset
        ];
        for (method_iteration in
            1u64..@lengthOf(source.method_declaration_indices)) {
            let method_index = method_iteration - 1u64;
            raw methods[method_index] =
                raw source.method_declaration_indices[method_index];
        }
        let next_trait_offset = trait_offset + @lengthOf(source.trait_type_ids);
        var traits = raw storage->trait_type_ids[trait_offset..next_trait_offset];
        for (trait_iteration in 1u64..@lengthOf(source.trait_type_ids)) {
            let trait_index = trait_iteration - 1u64;
            let mapped = hir_artifact_canonical_type_id(
                canonical,
                raw source.trait_type_ids[trait_index]
            );
            if (mapped == invalidZirlType) {
                return ZirlHirArtifactTemplateProjection {
                    value: ZirlTemplateSection {
                        templates: raw storage->templates[0u64..0u64],
                    },
                    error: ZirlHirArtifactProjectionError.InvalidTemplateProjection,
                };
            }
            raw traits[trait_index] = mapped as HirTypeId;
        }

        let function_index =
            if (source.function_id == invalidFunction) {
                invalidFunction
            } else {
                source.function_id
            };
        raw storage->templates[index] = ZirlTemplateRecord {
            kind: source.kind,
            is_extern: source.is_extern,
            name_id: source.name_id,
            declaration_index: source.declaration_id,
            function_index: function_index,
            return_type_id: mapped_return as HirTypeId,
            params: raw storage->params[
                template_param_start..param_offset
            ],
            param_type_ids: param_types,
            param_name_ids: param_names,
            field_name_ids: field_names,
            field_type_ids: field_types,
            canonical_field_order: field_order,
            method_declaration_indices: methods,
            trait_type_ids: traits,
        };
        param_type_offset = next_param_type_offset;
        param_name_offset = next_param_name_offset;
        field_offset = next_field_offset;
        field_order_offset = next_field_order_offset;
        method_offset = next_method_offset;
        trait_offset = next_trait_offset;
    }
    return ZirlHirArtifactTemplateProjection {
        value: ZirlTemplateSection {
            templates: raw storage->templates[0u64..@lengthOf(module->templates)],
        },
        error: ZirlHirArtifactProjectionError.None,
    };
}

pub fn project_zirl_hir_artifact_sections(
    source: *ZirlHirArtifactSource,
    canonical_storage: *ZirlCanonicalTypeStorage,
    declaration_storage: *ZirlDeclStorage,
    template_storage: *ZirlTemplateStorage,
    code_storage: *ZirlCodeStorage,
    attrs_storage: *ZirlAttrsStorage
): ZirlHirArtifactProjectionResult {
    let verified = verify_hir(&raw source->module);
    if (verified.error != HirVerifyError.None) {
        return failed_hir_artifact_projection(
            ZirlHirArtifactProjectionError.InvalidHir,
            declaration_storage,
            template_storage,
            code_storage,
            attrs_storage
        );
    }
    if ((source->identity.declaration_count as u64) !=
            @lengthOf(source->module.declarations) or
        (source->identity.template_count as u64) !=
            @lengthOf(source->module.templates) or
        (source->identity.function_count as u64) !=
            @lengthOf(source->module.functions)) {
        return failed_hir_artifact_projection(
            ZirlHirArtifactProjectionError.InvalidIdentity,
            declaration_storage,
            template_storage,
            code_storage,
            attrs_storage
        );
    }

    let canonical = build_zirl_canonical_types(
        &raw source->module,
        canonical_storage
    );
    if (canonical.failed) {
        var failed = failed_hir_artifact_projection(
            ZirlHirArtifactProjectionError.InvalidCanonicalTypes,
            declaration_storage,
            template_storage,
            code_storage,
            attrs_storage
        );
        failed.canonical_error = canonical.error;
        return failed;
    }

    let counts = hir_artifact_projection_counts(&raw source->module);
    if (counts.failed) {
        return failed_hir_artifact_projection(
            ZirlHirArtifactProjectionError.InvalidDeclarationProjection,
            declaration_storage,
            template_storage,
            code_storage,
            attrs_storage
        );
    }
    if (@lengthOf(source->module.declarations) >
            @lengthOf(declaration_storage->declarations) or
        counts.declaration_fields >
            @lengthOf(declaration_storage->field_name_ids) or
        counts.declaration_fields >
            @lengthOf(declaration_storage->field_type_ids) or
        counts.declaration_methods >
            @lengthOf(declaration_storage->method_declaration_indices)) {
        return failed_hir_artifact_projection(
            ZirlHirArtifactProjectionError.InsufficientDeclarationStorage,
            declaration_storage,
            template_storage,
            code_storage,
            attrs_storage
        );
    }
    if (@lengthOf(source->module.templates) >
            @lengthOf(template_storage->templates) or
        counts.template_params > @lengthOf(template_storage->params) or
        counts.template_bounds >
            @lengthOf(template_storage->param_bound_type_ids) or
        counts.template_param_types >
            @lengthOf(template_storage->param_type_ids) or
        counts.template_param_names >
            @lengthOf(template_storage->param_name_ids) or
        counts.template_fields > @lengthOf(template_storage->field_name_ids) or
        counts.template_fields > @lengthOf(template_storage->field_type_ids) or
        counts.template_field_order >
            @lengthOf(template_storage->canonical_field_order) or
        counts.template_methods >
            @lengthOf(template_storage->method_declaration_indices) or
        counts.template_traits > @lengthOf(template_storage->trait_type_ids)) {
        return failed_hir_artifact_projection(
            ZirlHirArtifactProjectionError.InsufficientTemplateStorage,
            declaration_storage,
            template_storage,
            code_storage,
            attrs_storage
        );
    }

    let declarations = project_hir_declarations(
        &raw source->module,
        &raw canonical,
        declaration_storage,
        counts
    );
    if (declarations.error != ZirlHirArtifactProjectionError.None) {
        return failed_hir_artifact_projection(
            declarations.error,
            declaration_storage,
            template_storage,
            code_storage,
            attrs_storage
        );
    }
    let templates = project_hir_templates(
        &raw source->module,
        &raw canonical,
        template_storage,
        counts
    );
    if (templates.error != ZirlHirArtifactProjectionError.None) {
        return failed_hir_artifact_projection(
            templates.error,
            declaration_storage,
            template_storage,
            code_storage,
            attrs_storage
        );
    }

    let code = build_zirl_hir_code_section(
        &raw source->module,
        &raw canonical,
        code_storage
    );
    if (code.error != ZirlHirCodeError.None) {
        var failed = failed_hir_artifact_projection(
            ZirlHirArtifactProjectionError.CodeProjectionFailed,
            declaration_storage,
            template_storage,
            code_storage,
            attrs_storage
        );
        failed.code_error = code.error;
        return failed;
    }

    let attrs = build_zirl_hir_attrs_section(
        &raw source->module,
        attrs_storage
    );
    if (attrs.error != ZirlHirAttrsError.None) {
        var failed = failed_hir_artifact_projection(
            ZirlHirArtifactProjectionError.AttrsProjectionFailed,
            declaration_storage,
            template_storage,
            code_storage,
            attrs_storage
        );
        failed.attrs_error = attrs.error;
        return failed;
    }

    if (@lengthOf(code.value.functions) !=
        @lengthOf(source->module.functions)) {
        return failed_hir_artifact_projection(
            ZirlHirArtifactProjectionError.InvalidIdentity,
            declaration_storage,
            template_storage,
            code_storage,
            attrs_storage
        );
    }

    return ZirlHirArtifactProjectionResult {
        value: ZirlHirArtifactSections {
            declarations: declarations.value,
            templates: templates.value,
            code: code.value,
            attrs: attrs.value,
        },
        error: ZirlHirArtifactProjectionError.None,
        canonical_error: ZirlCanonicalTypeError.None,
        code_error: ZirlHirCodeError.None,
        attrs_error: ZirlHirAttrsError.None,
    };
}

pub fn write_zirl_hir_artifact(
    source: *ZirlHirArtifactSource,
    storage: *ZirlHirArtifactWriteStorage,
    output: []u8
): ZirlArtifactWriteResult {
    let verified = verify_hir(&raw source->module);
    if (verified.error != HirVerifyError.None or
        @lengthOf(storage->sections) < 5u64) {
        return failed_hir_artifact_write();
    }

    let projected = project_zirl_hir_artifact_sections(
        source,
        &raw storage->canonical_types,
        &raw storage->declarations,
        &raw storage->templates,
        &raw storage->code,
        &raw storage->attrs
    );
    if (projected.error != ZirlHirArtifactProjectionError.None) {
        return failed_hir_artifact_write();
    }

    let metadata_writer = write_metadata_section(
        ZirlByteWriter {
            bytes: storage->metadata_bytes,
            position: 0u64,
            failed: false,
        },
        source->identity.module_name,
        source->paths,
        &raw source->module
    );
    let decls_writer = write_decls_section(
        ZirlByteWriter {
            bytes: storage->decls_bytes,
            position: 0u64,
            failed: false,
        },
        &raw projected.value.declarations
    );
    let templates_writer = write_templates_section(
        ZirlByteWriter {
            bytes: storage->templates_bytes,
            position: 0u64,
            failed: false,
        },
        &raw projected.value.templates
    );
    let code_writer = write_code_section(
        ZirlByteWriter {
            bytes: storage->code_bytes,
            position: 0u64,
            failed: false,
        },
        &raw projected.value.code
    );
    let attrs_writer = write_attrs_section(
        ZirlByteWriter {
            bytes: storage->attrs_bytes,
            position: 0u64,
            failed: false,
        },
        &raw projected.value.attrs
    );
    if (metadata_writer.failed or decls_writer.failed or templates_writer.failed or
        code_writer.failed or attrs_writer.failed) {
        return failed_hir_artifact_write();
    }

    raw storage->sections[0] = ZirlArtifactSection {
        id: zirlHirMetadataSectionId,
        flags: 1u16,
        schema_version: zirlMetadataSectionSchemaVersion,
        payload: raw storage->metadata_bytes[0u64..metadata_writer.position],
    };
    raw storage->sections[1] = ZirlArtifactSection {
        id: zirlHirDeclsSectionId,
        flags: 1u16,
        schema_version: zirlDeclsSectionSchemaVersion,
        payload: raw storage->decls_bytes[0u64..decls_writer.position],
    };
    raw storage->sections[2] = ZirlArtifactSection {
        id: zirlHirTemplatesSectionId,
        flags: 1u16,
        schema_version: zirlTemplatesSectionSchemaVersion,
        payload: raw storage->templates_bytes[0u64..templates_writer.position],
    };
    raw storage->sections[3] = ZirlArtifactSection {
        id: zirlHirCodeSectionId,
        flags: 1u16,
        schema_version: zirlSectionSchemaVersion,
        payload: raw storage->code_bytes[0u64..code_writer.position],
    };
    raw storage->sections[4] = ZirlArtifactSection {
        id: zirlHirAttrsSectionId,
        flags: 1u16,
        schema_version: zirlAttrsSectionSchemaVersion,
        payload: raw storage->attrs_bytes[0u64..attrs_writer.position],
    };

    return write_zirl_artifact(
        &raw source->identity,
        raw storage->sections[0u64..5u64],
        output
    );
}

fn artifact_type_reference_valid(type_id: HirTypeId, type_count: u64): bool {
    return type_id == invalidType or (type_id as u64) < type_count;
}

fn artifact_type_values_valid(
    type_ids: []HirTypeId,
    type_count: u64
): bool {
    for (offset in 1u64..@lengthOf(type_ids)) {
        let index = offset - 1u64;
        if (not artifact_type_reference_valid(raw type_ids[index], type_count)) {
            return false;
        }
    }
    return true;
}

fn artifact_call_types_valid(call: HirCall, type_count: u64): bool {
    return artifact_type_reference_valid(call.function_type, type_count) and
        artifact_type_values_valid(call.argument_types, type_count);
}

fn artifact_expression_types_valid(
    expression: HirExpr,
    type_count: u64
): bool {
    if (expression is HirLiteral) {
        return artifact_type_reference_valid(expression.type_id, type_count);
    } else if (expression is HirBinary) {
        return artifact_type_reference_valid(expression.type_id, type_count) and
            artifact_type_reference_valid(expression.operand_type, type_count);
    } else if (expression is HirUnary) {
        return artifact_type_reference_valid(expression.type_id, type_count);
    } else if (expression is HirLet) {
        return artifact_type_reference_valid(expression.type_id, type_count);
    } else if (expression is HirCall) {
        return artifact_call_types_valid(expression, type_count);
    } else if (expression is HirIndex) {
        return artifact_type_reference_valid(expression.type_id, type_count) and
            artifact_type_reference_valid(expression.object_type, type_count);
    } else if (expression is HirField) {
        return artifact_type_reference_valid(expression.type_id, type_count) and
            artifact_type_reference_valid(expression.object_type, type_count);
    } else if (expression is HirStructLiteral) {
        return artifact_type_reference_valid(expression.type_id, type_count);
    } else if (expression is HirArrayLiteral) {
        return artifact_type_reference_valid(expression.type_id, type_count);
    } else if (expression is HirEnumValue) {
        return artifact_type_reference_valid(expression.type_id, type_count);
    } else if (expression is HirSlotAlloca) {
        return artifact_type_reference_valid(expression.type_id, type_count);
    } else if (expression is HirSlotLoad) {
        return artifact_type_reference_valid(expression.type_id, type_count);
    } else if (expression is HirSlotAddr) {
        return artifact_type_reference_valid(expression.type_id, type_count);
    } else if (expression is HirMakeNone) {
        return artifact_type_reference_valid(expression.type_id, type_count);
    } else if (expression is HirMakeSome) {
        return artifact_type_reference_valid(expression.type_id, type_count);
    } else if (expression is HirMakeSlice) {
        return artifact_type_reference_valid(expression.type_id, type_count) and
            artifact_type_reference_valid(expression.object_type, type_count) and
            artifact_type_reference_valid(expression.bound_type, type_count);
    } else if (expression is HirCast) {
        return artifact_type_reference_valid(expression.from_type, type_count) and
            artifact_type_reference_valid(expression.to_type, type_count);
    } else if (expression is HirUnionCast) {
        return artifact_type_reference_valid(expression.from_type, type_count) and
            artifact_type_reference_valid(expression.to_type, type_count);
    } else if (expression is HirUnionCheck) {
        return artifact_type_reference_valid(expression.union_type, type_count);
    } else if (expression is HirLayoutIntrinsic) {
        return artifact_type_reference_valid(expression.type_id, type_count) and
            artifact_type_reference_valid(expression.operand_type, type_count);
    } else if (expression is HirStateTailCall) {
        return artifact_call_types_valid(expression.call, type_count);
    } else if (expression is HirCanonicalType) {
        return artifact_type_reference_valid(expression.type_id, type_count);
    } else if (expression is HirGlobalConstLoad) {
        return artifact_type_reference_valid(expression.type_id, type_count);
    } else if (expression is HirExternalGlobalAddr) {
        return artifact_type_reference_valid(expression.type_id, type_count);
    } else if (expression is HirMakeDyn) {
        return artifact_type_reference_valid(expression.source_type, type_count) and
            artifact_type_reference_valid(expression.dyn_type, type_count);
    } else if (expression is HirDynCall) {
        return artifact_type_reference_valid(expression.result_type, type_count) and
            artifact_type_reference_valid(expression.function_type, type_count) and
            artifact_type_values_valid(expression.argument_types, type_count);
    } else if (expression is HirMakeOpaque) {
        return artifact_type_reference_valid(expression.source_type, type_count) and
            artifact_type_reference_valid(expression.opaque_type, type_count);
    } else if (expression is HirOpaqueCast) {
        return artifact_type_reference_valid(expression.from_type, type_count) and
            artifact_type_reference_valid(expression.to_type, type_count) and
            artifact_type_reference_valid(expression.opaque_type, type_count) and
            artifact_type_reference_valid(expression.result_type, type_count);
    } else if (expression is HirOpaqueCheck) {
        return artifact_type_reference_valid(expression.opaque_type, type_count);
    } else if (expression is HirPipe) {
        return artifact_type_reference_valid(expression.source_type, type_count) and
            artifact_type_reference_valid(expression.type_id, type_count);
    } else if (expression is HirPipeCurrent) {
        return artifact_type_reference_valid(expression.type_id, type_count);
    }
    return true;
}

struct ZirlHirArtifactSlotExtent {
    count: u64,
    valid: bool,
}

fn artifact_include_slot(
    slot: u32,
    current_count: u64
): ZirlHirArtifactSlotExtent {
    if (slot == invalidSlot) {
        return ZirlHirArtifactSlotExtent {
            count: current_count,
            valid: false,
        };
    }
    let count = (slot as u64) + 1u64;
    if (count > current_count) {
        return ZirlHirArtifactSlotExtent { count: count, valid: true };
    }
    return ZirlHirArtifactSlotExtent {
        count: current_count,
        valid: true,
    };
}

fn artifact_expression_slots(
    expression: HirExpr,
    current_count: u64
): ZirlHirArtifactSlotExtent {
    if (expression is HirSlotAlloca) {
        return artifact_include_slot(expression.slot, current_count);
    } else if (expression is HirSlotStore) {
        return artifact_include_slot(expression.slot, current_count);
    } else if (expression is HirSlotLoad) {
        return artifact_include_slot(expression.slot, current_count);
    } else if (expression is HirSlotAddr) {
        return artifact_include_slot(expression.slot, current_count);
    } else if (expression is HirPipe) {
        return artifact_include_slot(expression.source_slot, current_count);
    } else if (expression is HirPipeCurrent) {
        return artifact_include_slot(expression.slot, current_count);
    }
    return ZirlHirArtifactSlotExtent {
        count: current_count,
        valid: true,
    };
}

fn artifact_compact_expr_is_opaque(expression: ZirlCompactExpr): bool {
    return expression.kind == (ZirlCompactExprKind.MakeOpaque as u8) or
        expression.kind == (ZirlCompactExprKind.OpaqueCast as u8) or
        expression.kind == (ZirlCompactExprKind.OpaqueCheck as u8);
}

fn artifact_compact_expr_runtime_id(expression: ZirlCompactExpr): u32 {
    if (expression.kind == (ZirlCompactExprKind.MakeOpaque as u8)) {
        return expression.ref_c;
    }
    return expression.ref_e;
}

fn artifact_compact_expr_mapping_equal(
    left: ZirlCompactExpr,
    right: ZirlCompactExpr
): bool {
    if (not artifact_compact_expr_is_opaque(left) or
        not artifact_compact_expr_is_opaque(right) or
        @lengthOf(left.integers) != 2u64 or
        @lengthOf(right.integers) != 2u64) {
        return false;
    }
    return raw left.integers[0u64] == raw right.integers[0u64] and
        raw left.integers[1u64] == raw right.integers[1u64];
}

fn artifact_canonical_mappings_match(code: *ZirlCodeSection): bool {
    var expected_mapping = 0u64;
    for (offset in 1u64..@lengthOf(code->expressions)) {
        let expression_index = offset - 1u64;
        let expression: ZirlCompactExpr =
            raw code->expressions[expression_index];
        if (not artifact_compact_expr_is_opaque(expression)) {
            continue;
        }
        if (@lengthOf(expression.integers) != 2u64) {
            return false;
        }
        var already_seen = false;
        for (prior_offset in 1u64..expression_index) {
            let prior_index = prior_offset - 1u64;
            let prior: ZirlCompactExpr = raw code->expressions[prior_index];
            if (artifact_compact_expr_mapping_equal(expression, prior)) {
                if (artifact_compact_expr_runtime_id(expression) !=
                    artifact_compact_expr_runtime_id(prior)) {
                    return false;
                }
                already_seen = true;
                break;
            }
        }
        if (not already_seen) {
            if (expected_mapping >= @lengthOf(code->canonical_mappings)) {
                return false;
            }
            let mapping: ZirlCanonicalMapping =
                raw code->canonical_mappings[expected_mapping];
            if (mapping.canonical_hi != raw expression.integers[0u64] or
                mapping.canonical_lo != raw expression.integers[1u64] or
                mapping.runtime_id != artifact_compact_expr_runtime_id(expression)) {
                return false;
            }
            expected_mapping = expected_mapping + 1u64;
        }
    }
    return expected_mapping == @lengthOf(code->canonical_mappings);
}

fn artifact_function_attrs_default(
    discardable: bool
): HirFunctionAttrs {
    return HirFunctionAttrs {
        return_consumed: HirConsumedState.Unknown,
        non_null: false,
        no_alias: false,
        read_only: false,
        no_capture: false,
        discardable: discardable,
    };
}

pub fn read_zirl_hir_artifact_module(
    bytes: []u8,
    read_storage: *ZirlHirArtifactReadStorage,
    hydration_storage: *ZirlHirArtifactHydrationStorage
): ZirlHirArtifactModuleReadResult {
    let sections = read_zirl_hir_artifact_sections(bytes, read_storage);
    if (sections.error != ZirlHirArtifactReadError.None) {
        return empty_hir_artifact_module_result(
            sections.error,
            read_storage,
            hydration_storage
        );
    }
    if (@lengthOf(sections.declarations.declarations) != 0u64 or
        @lengthOf(sections.templates.templates) != 0u64) {
        return empty_hir_artifact_module_result(
            ZirlHirArtifactReadError.UnsupportedDeclarationsOrTemplates,
            read_storage,
            hydration_storage
        );
    }

    let type_count = @lengthOf(sections.metadata.types);
    let expression_count = @lengthOf(sections.code.expressions);
    let function_count = @lengthOf(sections.code.functions);
    var total_blocks = 0u64;
    var total_parameter_types = 0u64;
    var total_expression_argument_types = 0u64;
    var total_vtable_functions = 0u64;
    var total_call_attr_arguments = 0u64;
    for (offset in 1u64..expression_count) {
        let index = offset - 1u64;
        let expression: ZirlCompactExpr = raw sections.code.expressions[index];
        if (@lengthOf(expression.arg_types) >
            0xFFFFFFFFFFFFFFFFu64 - total_expression_argument_types) {
            return empty_hir_artifact_module_result(
                ZirlHirArtifactReadError.InsufficientHydrationStorage,
                read_storage,
                hydration_storage
            );
        }
        total_expression_argument_types =
            total_expression_argument_types + @lengthOf(expression.arg_types);
    }
    for (offset in 1u64..function_count) {
        let index = offset - 1u64;
        let function: ZirlCompactFunction = raw sections.code.functions[index];
        if (@lengthOf(function.blocks) > 0xFFFFFFFFFFFFFFFFu64 - total_blocks or
            @lengthOf(function.parameter_type_ids) >
                0xFFFFFFFFFFFFFFFFu64 - total_parameter_types) {
            return empty_hir_artifact_module_result(
                ZirlHirArtifactReadError.InsufficientHydrationStorage,
                read_storage,
                hydration_storage
            );
        }
        total_blocks = total_blocks + @lengthOf(function.blocks);
        total_parameter_types =
            total_parameter_types + @lengthOf(function.parameter_type_ids);
    }
    for (offset in 1u64..@lengthOf(sections.code.vtables)) {
        let index = offset - 1u64;
        let vtable: ZirlCodeVTable = raw sections.code.vtables[index];
        if (@lengthOf(vtable.slot_function_name_ids) >
            0xFFFFFFFFFFFFFFFFu64 - total_vtable_functions) {
            return empty_hir_artifact_module_result(
                ZirlHirArtifactReadError.InsufficientHydrationStorage,
                read_storage,
                hydration_storage
            );
        }
        total_vtable_functions =
            total_vtable_functions + @lengthOf(vtable.slot_function_name_ids);
    }
    for (offset in 1u64..@lengthOf(sections.attrs.calls)) {
        let index = offset - 1u64;
        let call: ZirlCallAttrsRecord = raw sections.attrs.calls[index];
        if (@lengthOf(call.arg_escapes) >
            0xFFFFFFFFFFFFFFFFu64 - total_call_attr_arguments) {
            return empty_hir_artifact_module_result(
                ZirlHirArtifactReadError.InsufficientHydrationStorage,
                read_storage,
                hydration_storage
            );
        }
        total_call_attr_arguments =
            total_call_attr_arguments + @lengthOf(call.arg_escapes);
    }

    if (expression_count > @lengthOf(hydration_storage->module.expressions) or
        function_count > @lengthOf(hydration_storage->module.functions) or
        @lengthOf(sections.code.globals) >
            @lengthOf(hydration_storage->module.global_constants) or
        @lengthOf(sections.code.vtables) >
            @lengthOf(hydration_storage->module.vtables) or
        expression_count > @lengthOf(hydration_storage->module.call_attrs) or
        function_count > @lengthOf(hydration_storage->module.function_attrs) or
        @lengthOf(sections.attrs.safety_proofs) >
            @lengthOf(hydration_storage->module.safety_attrs.proofs) or
        total_blocks > @lengthOf(hydration_storage->blocks) or
        total_parameter_types >
            @lengthOf(hydration_storage->function_parameter_types) or
        total_expression_argument_types >
            @lengthOf(hydration_storage->expression_argument_types) or
        total_vtable_functions >
            @lengthOf(hydration_storage->vtable_slot_functions) or
        total_call_attr_arguments >
            @lengthOf(hydration_storage->call_attr_arguments)) {
        return empty_hir_artifact_module_result(
            ZirlHirArtifactReadError.InsufficientHydrationStorage,
            read_storage,
            hydration_storage
        );
    }
    if (type_count > 0xFFFFFFFFu64 - function_count) {
        return empty_hir_artifact_module_result(
            ZirlHirArtifactReadError.InvalidCanonicalReference,
            read_storage,
            hydration_storage
        );
    }
    if (not artifact_canonical_mappings_match(&raw sections.code)) {
        return empty_hir_artifact_module_result(
            ZirlHirArtifactReadError.InvalidCanonicalReference,
            read_storage,
            hydration_storage
        );
    }

    var expression_argument_type_offset = 0u64;
    var module = hydration_storage->module;
    for (offset in 1u64..expression_count) {
        let index = offset - 1u64;
        let compact: ZirlCompactExpr = raw sections.code.expressions[index];
        let argument_types_start = expression_argument_type_offset;
        for (arg_offset in 1u64..@lengthOf(compact.arg_types)) {
            let arg_index = arg_offset - 1u64;
            let type_id: HirTypeId = raw compact.arg_types[arg_index];
            if (not artifact_type_reference_valid(type_id, type_count)) {
                return empty_hir_artifact_module_result(
                    ZirlHirArtifactReadError.InvalidCanonicalReference,
                    read_storage,
                    hydration_storage
                );
            }
            raw hydration_storage->expression_argument_types[
                expression_argument_type_offset
            ] = type_id;
            expression_argument_type_offset =
                expression_argument_type_offset + 1u64;
        }
        let argument_types = raw hydration_storage->expression_argument_types[
            argument_types_start..expression_argument_type_offset
        ];
        let decoded = decode_hir_artifact_expression(
            &raw compact,
            argument_types,
            type_count,
            sections.code.functions
        );
        if (decoded.error != ZirlHirArtifactReadError.None) {
            return empty_hir_artifact_module_result(
                decoded.error,
                read_storage,
                hydration_storage
            );
        }
        if (not artifact_expression_types_valid(decoded.value, type_count)) {
            return empty_hir_artifact_module_result(
                ZirlHirArtifactReadError.InvalidCanonicalReference,
                read_storage,
                hydration_storage
            );
        }
        raw module.expressions[index] = decoded.value;
    }
    module.expressions = raw hydration_storage->module.expressions[
        0u64..expression_count
    ];

    var required_slot_count = 0u64;
    var parameter_type_offset = 0u64;
    var block_offset = 0u64;
    for (offset in 1u64..function_count) {
        let index = offset - 1u64;
        let compact: ZirlCompactFunction = raw sections.code.functions[index];
        if (compact.signature_type_id !=
                (type_count + index) as u32 or
            compact.instance_index != 0xFFFFFFFFu32 or
            not artifact_type_reference_valid(
                compact.return_type_id,
                type_count
            ) or
            not artifact_type_reference_valid(
                compact.machine_return_type_id,
                type_count
            ) or
            (@lengthOf(compact.parameter_name_ids) != 0u64 and
             @lengthOf(compact.parameter_name_ids) !=
                @lengthOf(compact.parameter_type_ids)) or
            (@lengthOf(compact.parameter_slot_ids) != 0u64 and
             @lengthOf(compact.parameter_slot_ids) !=
                @lengthOf(compact.parameter_type_ids))) {
            return empty_hir_artifact_module_result(
                ZirlHirArtifactReadError.InvalidCanonicalReference,
                read_storage,
                hydration_storage
            );
        }
        let parameter_type_start = parameter_type_offset;
        for (param_offset in 1u64..@lengthOf(compact.parameter_type_ids)) {
            let param_index = param_offset - 1u64;
            let type_id: HirTypeId =
                raw compact.parameter_type_ids[param_index];
            if (not artifact_type_reference_valid(type_id, type_count)) {
                return empty_hir_artifact_module_result(
                    ZirlHirArtifactReadError.InvalidCanonicalReference,
                    read_storage,
                    hydration_storage
                );
            }
            raw hydration_storage->function_parameter_types[
                parameter_type_offset
            ] = type_id;
            parameter_type_offset = parameter_type_offset + 1u64;
        }
        for (param_offset in 1u64..@lengthOf(compact.parameter_slot_ids)) {
            let param_index = param_offset - 1u64;
            let slot: HirSlotId = raw compact.parameter_slot_ids[param_index];
            if (slot != invalidSlot) {
                let slot_extent =
                    artifact_include_slot(slot, required_slot_count);
                if (not slot_extent.valid) {
                    return empty_hir_artifact_module_result(
                        ZirlHirArtifactReadError.InvalidHydratedHir,
                        read_storage,
                        hydration_storage
                    );
                }
                required_slot_count = slot_extent.count;
            }
        }
        let blocks_start = block_offset;
        for (block_iteration in 1u64..@lengthOf(compact.blocks)) {
            let compact_block_index = block_iteration - 1u64;
            let compact_block: ZirlCompactBasicBlock =
                raw compact.blocks[compact_block_index];
            raw hydration_storage->blocks[block_offset] = HirBasicBlock {
                instructions: compact_block.instructions,
                terminator: compact_block.terminator,
            };
            block_offset = block_offset + 1u64;
        }
        raw module.functions[index] = HirFunction {
            name_id: compact.name_id,
            parameter_types: raw hydration_storage->function_parameter_types[
                parameter_type_start..parameter_type_offset
            ],
            parameter_name_ids: compact.parameter_name_ids,
            parameter_slots: compact.parameter_slot_ids,
            return_type: compact.return_type_id,
            state_function: compact.is_state,
            uses_tail_calling_convention:
                compact.uses_tail_calling_convention,
            machine_return_type: compact.machine_return_type_id,
            machine_id: compact.machine_id,
            variadic: compact.is_variadic,
            variadic_slice_param: compact.variadic_slice_param,
            foreign_c: compact.is_foreign_c,
            has_body: not compact.is_extern,
            foreign_adapter_name_id: compact.foreign_adapter_name_id,
            blocks: raw hydration_storage->blocks[blocks_start..block_offset],
        };
    }
    module.functions = raw hydration_storage->module.functions[
        0u64..function_count
    ];

    for (offset in 1u64..expression_count) {
        let index = offset - 1u64;
        let expression: HirExpr = raw module.expressions[index];
        let slot_extent = artifact_expression_slots(
            expression,
            required_slot_count
        );
        if (not slot_extent.valid) {
            return empty_hir_artifact_module_result(
                ZirlHirArtifactReadError.InvalidHydratedHir,
                read_storage,
                hydration_storage
            );
        }
        required_slot_count = slot_extent.count;
    }
    for (offset in 1u64..@lengthOf(sections.attrs.slots)) {
        let index = offset - 1u64;
        let record: ZirlSlotAttrsRecord = raw sections.attrs.slots[index];
        if (record.slot_id == invalidSlot) {
            return empty_hir_artifact_module_result(
                ZirlHirArtifactReadError.InvalidCanonicalReference,
                read_storage,
                hydration_storage
            );
        }
        let next_slot_count = (record.slot_id as u64) + 1u64;
        if (next_slot_count > required_slot_count) {
            required_slot_count = next_slot_count;
        }
        for (prior_offset in 1u64..index) {
            let prior_index = prior_offset - 1u64;
            let prior: ZirlSlotAttrsRecord =
                raw sections.attrs.slots[prior_index];
            if (prior.slot_id == record.slot_id) {
                return empty_hir_artifact_module_result(
                    ZirlHirArtifactReadError.InvalidSectionPayload,
                    read_storage,
                    hydration_storage
                );
            }
        }
    }
    if (required_slot_count > @lengthOf(hydration_storage->module.slot_attrs)) {
        return empty_hir_artifact_module_result(
            ZirlHirArtifactReadError.InsufficientHydrationStorage,
            read_storage,
            hydration_storage
        );
    }

    for (offset in 1u64..@lengthOf(sections.attrs.calls)) {
        let index = offset - 1u64;
        let record: ZirlCallAttrsRecord = raw sections.attrs.calls[index];
        if ((record.expr_id as u64) >= expression_count) {
            return empty_hir_artifact_module_result(
                ZirlHirArtifactReadError.InvalidCanonicalReference,
                read_storage,
                hydration_storage
            );
        }
        for (prior_offset in 1u64..index) {
            let prior_index = prior_offset - 1u64;
            let prior: ZirlCallAttrsRecord = raw sections.attrs.calls[prior_index];
            if (prior.expr_id == record.expr_id) {
                return empty_hir_artifact_module_result(
                    ZirlHirArtifactReadError.InvalidSectionPayload,
                    read_storage,
                    hydration_storage
                );
            }
        }
    }
    for (offset in 1u64..@lengthOf(sections.attrs.functions)) {
        let index = offset - 1u64;
        let record: ZirlFunctionAttrsRecord =
            raw sections.attrs.functions[index];
        if ((record.function_index as u64) >= function_count) {
            return empty_hir_artifact_module_result(
                ZirlHirArtifactReadError.InvalidCanonicalReference,
                read_storage,
                hydration_storage
            );
        }
        let compact: ZirlCompactFunction =
            raw sections.code.functions[record.function_index as u64];
        if (record.discardable != compact.discardable) {
            return empty_hir_artifact_module_result(
                ZirlHirArtifactReadError.InvalidSectionPayload,
                read_storage,
                hydration_storage
            );
        }
        for (prior_offset in 1u64..index) {
            let prior_index = prior_offset - 1u64;
            let prior: ZirlFunctionAttrsRecord =
                raw sections.attrs.functions[prior_index];
            if (prior.function_index == record.function_index) {
                return empty_hir_artifact_module_result(
                    ZirlHirArtifactReadError.InvalidSectionPayload,
                    read_storage,
                    hydration_storage
                );
            }
        }
    }
    for (offset in 1u64..@lengthOf(sections.attrs.safety_proofs)) {
        let index = offset - 1u64;
        let record: ZirlSafetyProofRecord =
            raw sections.attrs.safety_proofs[index];
        if (record.expr_id != index as u32 or
            (record.expr_id as u64) >= expression_count) {
            return empty_hir_artifact_module_result(
                ZirlHirArtifactReadError.InvalidCanonicalReference,
                read_storage,
                hydration_storage
            );
        }
    }

    let no_call_attr_arguments: [0]HirCallArgAttrs = [];
    let default_slot_attrs = HirSlotAttrs {
        ownership: HirOwnership.Default,
        consumed: HirConsumedState.Unknown,
        non_null: false,
        volatile_slot: false,
    };
    for (offset in 1u64..required_slot_count) {
        let index = offset - 1u64;
        raw module.slot_attrs[index] = default_slot_attrs;
    }
    module.slot_attrs = raw hydration_storage->module.slot_attrs[
        0u64..required_slot_count
    ];
    for (offset in 1u64..@lengthOf(sections.attrs.slots)) {
        let index = offset - 1u64;
        let record: ZirlSlotAttrsRecord = raw sections.attrs.slots[index];
        raw module.slot_attrs[record.slot_id as u64] = HirSlotAttrs {
            ownership: record.ownership,
            consumed: record.consumed,
            non_null: record.non_null,
            volatile_slot: record.volatile_slot,
        };
    }

    var call_attr_argument_offset = 0u64;
    for (offset in 1u64..expression_count) {
        let index = offset - 1u64;
        raw module.call_attrs[index] = HirCallAttrs {
            args: raw no_call_attr_arguments[0u64..0u64],
            returns_argument: 0xFFFFFFFFu32,
        };
    }
    for (offset in 1u64..@lengthOf(sections.attrs.calls)) {
        let index = offset - 1u64;
        let record: ZirlCallAttrsRecord = raw sections.attrs.calls[index];
        let args_start = call_attr_argument_offset;
        for (arg_offset in 1u64..@lengthOf(record.arg_escapes)) {
            let arg_index = arg_offset - 1u64;
            raw hydration_storage->call_attr_arguments[
                call_attr_argument_offset
            ] = HirCallArgAttrs {
                escape: raw record.arg_escapes[arg_index],
            };
            call_attr_argument_offset = call_attr_argument_offset + 1u64;
        }
        module.call_attrs[record.expr_id as u64] = HirCallAttrs {
            args: raw hydration_storage->call_attr_arguments[
                args_start..call_attr_argument_offset
            ],
            returns_argument: record.returns_argument,
        };
    }
    module.call_attrs = raw hydration_storage->module.call_attrs[
        0u64..expression_count
    ];

    for (offset in 1u64..function_count) {
        let index = offset - 1u64;
        let compact: ZirlCompactFunction = raw sections.code.functions[index];
        raw module.function_attrs[index] =
            artifact_function_attrs_default(compact.discardable);
    }
    for (offset in 1u64..@lengthOf(sections.attrs.functions)) {
        let index = offset - 1u64;
        let record: ZirlFunctionAttrsRecord =
            raw sections.attrs.functions[index];
        raw module.function_attrs[record.function_index as u64] =
            HirFunctionAttrs {
                return_consumed: record.return_consumed,
                non_null: record.non_null,
                no_alias: record.no_alias,
                read_only: record.read_only,
                no_capture: record.no_capture,
                discardable: record.discardable,
            };
    }
    module.function_attrs = raw hydration_storage->module.function_attrs[
        0u64..function_count
    ];

    for (offset in 1u64..@lengthOf(sections.attrs.safety_proofs)) {
        let index = offset - 1u64;
        let record: ZirlSafetyProofRecord =
            raw sections.attrs.safety_proofs[index];
        raw module.safety_attrs.proofs[index] = HirSafetyProof {
            kind: record.kind,
            operand_a: record.operand_a,
            operand_b: record.operand_b,
            operand_c: record.operand_c,
            present: record.present,
        };
    }
    module.safety_attrs = HirSafetyAttrs {
        proofs: raw hydration_storage->module.safety_attrs.proofs[
            0u64..@lengthOf(sections.attrs.safety_proofs)
        ],
    };

    var global_index = 0u64;
    for (offset in 1u64..@lengthOf(sections.code.globals)) {
        let index = offset - 1u64;
        let global_record: ZirlCodeGlobal =
            raw sections.code.globals[index];
        if (not artifact_type_reference_valid(
                global_record.type_id,
                type_count
            )) {
            return empty_hir_artifact_module_result(
                ZirlHirArtifactReadError.InvalidCanonicalReference,
                read_storage,
                hydration_storage
            );
        }
        raw module.global_constants[global_index] = HirGlobalConst {
            name_id: global_record.name_id,
            type_id: global_record.type_id,
            initializer: global_record.initializer,
        };
        global_index = global_index + 1u64;
    }
    module.global_constants = raw hydration_storage->module.global_constants[
        0u64..global_index
    ];

    var vtable_slot_offset = 0u64;
    for (offset in 1u64..@lengthOf(sections.code.vtables)) {
        let index = offset - 1u64;
        let compact: ZirlCodeVTable = raw sections.code.vtables[index];
        let slots_start = vtable_slot_offset;
        for (slot_offset in 1u64..@lengthOf(compact.slot_function_name_ids)) {
            let slot_index = slot_offset - 1u64;
            let function = artifact_function_reference(
                raw compact.slot_function_signature_type_ids[slot_index],
                raw compact.slot_function_name_ids[slot_index],
                type_count,
                sections.code.functions
            );
            if (function.failed) {
                return empty_hir_artifact_module_result(
                    ZirlHirArtifactReadError.InvalidCanonicalReference,
                    read_storage,
                    hydration_storage
                );
            }
            raw hydration_storage->vtable_slot_functions[vtable_slot_offset] =
                function.value;
            vtable_slot_offset = vtable_slot_offset + 1u64;
        }
        raw module.vtables[index] = HirVTable {
            name_id: compact.name_id,
            slot_functions: raw hydration_storage->vtable_slot_functions[
                slots_start..vtable_slot_offset
            ],
        };
    }
    module.vtables = raw hydration_storage->module.vtables[
        0u64..@lengthOf(sections.code.vtables)
    ];

    module.strings = sections.metadata.strings;
    module.types = sections.metadata.types;
    module.struct_defs = sections.metadata.struct_defs;
    module.enum_defs = sections.metadata.enum_defs;
    module.union_defs = sections.metadata.union_defs;
    module.declarations = raw hydration_storage->module.declarations[0u64..0u64];

    let verified = verify_hir(&raw module);
    if (verified.error != HirVerifyError.None) {
        return empty_hir_artifact_module_result(
            ZirlHirArtifactReadError.InvalidHydratedHir,
            read_storage,
            hydration_storage
        );
    }
    hydration_storage->module = module;
    return ZirlHirArtifactModuleReadResult {
        identity: sections.identity,
        paths: sections.metadata.paths,
        module: module,
        error: ZirlHirArtifactReadError.None,
    };
}
