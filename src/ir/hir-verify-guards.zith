from ir/hir
from ir/hir-verify-common

extern fn calloc(count: u64, size: u64): raw opaque
extern fn free(ptr: raw opaque): void

fn slot_of_value(module_owner: *HirModule, expression_id: HirExprId): HirSlotId {
    let module: *HirModule = &*module_owner;
    if (not valid_expr_id(module, expression_id, false)) {
        return 0xFFFFFFFFu64 as HirSlotId;
    }
    let expression: HirExpr = raw module_owner->expressions[expression_id];
    if (expression is HirSlotAddr) {
        return expression.slot;
    }
    if (expression is HirSlotLoad) {
        return expression.slot;
    }
    return 0xFFFFFFFFu64 as HirSlotId;
}

fn optional_slot(module_owner: *HirModule, expression_id: HirExprId): HirSlotId {
    let module: *HirModule = &*module_owner;
    if (not valid_expr_id(module, expression_id, false)) {
        return 0xFFFFFFFFu64 as HirSlotId;
    }
    let expression: HirExpr = raw module_owner->expressions[expression_id];
    if (expression is HirSlotAddr) {
        return expression.slot;
    }
    return 0xFFFFFFFFu64 as HirSlotId;
}

fn same_value(module_owner: *HirModule, left: HirExprId, right: HirExprId): bool {
    if (left == right) {
        return true;
    }
    let left_slot = slot_of_value(module_owner, left);
    let right_slot = slot_of_value(module_owner, right);
    return (left_slot as u64) != 0xFFFFFFFFu64 and left_slot == right_slot;
}

fn is_slot_load(module_owner: *HirModule, expression_id: HirExprId, slot: HirSlotId): bool {
    let module: *HirModule = &*module_owner;
    if (not valid_expr_id(module, expression_id, false) or
        (slot as u64) == 0xFFFFFFFFu64) {
        return false;
    }
    let expression: HirExpr = raw module_owner->expressions[expression_id];
    if (expression is HirSlotLoad) {
        return expression.slot == slot;
    }
    return false;
}

fn is_zero_literal(module_owner: *HirModule, expression_id: HirExprId): bool {
    let module: *HirModule = &*module_owner;
    if (not valid_expr_id(module, expression_id, false)) {
        return false;
    }
    let expression: HirExpr = raw module_owner->expressions[expression_id];
    if (expression is HirLiteral) {
        return expression.value_kind == HirLiteralKind.Integer and expression.integer == 0;
    }
    return false;
}

fn is_binary_operation(
    module_owner: *HirModule,
    expression_id: HirExprId,
    operation: HirBinaryOp
): bool {
    let module: *HirModule = &*module_owner;
    if (not valid_expr_id(module, expression_id, false)) {
        return false;
    }
    let expression: HirExpr = raw module_owner->expressions[expression_id];
    if (expression is HirBinary) {
        return expression.op == operation;
    }
    return false;
}

fn binary_left(module_owner: *HirModule, expression_id: HirExprId): HirExprId {
    let module: *HirModule = &*module_owner;
    if (not valid_expr_id(module, expression_id, false)) {
        return 0xFFFFFFFFu64 as HirExprId;
    }
    let expression: HirExpr = raw module_owner->expressions[expression_id];
    if (expression is HirBinary) {
        return expression.lhs;
    }
    return 0xFFFFFFFFu64 as HirExprId;
}

fn binary_right(module_owner: *HirModule, expression_id: HirExprId): HirExprId {
    let module: *HirModule = &*module_owner;
    if (not valid_expr_id(module, expression_id, false)) {
        return 0xFFFFFFFFu64 as HirExprId;
    }
    let expression: HirExpr = raw module_owner->expressions[expression_id];
    if (expression is HirBinary) {
        return expression.rhs;
    }
    return 0xFFFFFFFFu64 as HirExprId;
}

fn is_length_of(
    module_owner: *HirModule,
    expression_id: HirExprId,
    object_type_id: HirTypeId,
    object_slot: HirSlotId
): bool {
    let module: *HirModule = &*module_owner;
    if (not valid_type_id(module, object_type_id, false) or
        not valid_expr_id(module, expression_id, false) or
        (object_slot as u64) == 0xFFFFFFFFu64) {
        return false;
    }

    let object_type: HirType = raw module_owner->types[object_type_id];
    if (object_type.kind == HirTypeKind.Array) {
        let expression: HirExpr = raw module_owner->expressions[expression_id];
        if (expression is HirLiteral) {
            return expression.value_kind == HirLiteralKind.Integer and
                expression.integer >= 0 and
                (expression.integer as u64) == (object_type.ref1 as u64);
        }
        return false;
    }
    if (object_type.kind != HirTypeKind.Slice) {
        return false;
    }
    let expression: HirExpr = raw module_owner->expressions[expression_id];
    if (expression is HirField) {
        return expression.index == 1 and expression.object_type == object_type_id and
            is_slot_load(module, expression.object, object_slot);
    }
    return false;
}

fn match_optional_guard(
    module_owner: *HirModule,
    operation_id: HirExprId,
    condition_id: HirExprId
): u32 {
    let module: *HirModule = &*module_owner;
    let operation: HirExpr = raw module_owner->expressions[operation_id];
    let condition: HirExpr = raw module_owner->expressions[condition_id];
    if (operation is HirField) {
        if (operation.index != 0 or not valid_type_id(module, operation.object_type, false)) {
            return 0;
        }
        let optional_type: HirType = raw module_owner->types[operation.object_type];
        if (optional_type.kind != HirTypeKind.Optional) {
            return 0;
        }
        if (condition is HirField) {
            if (condition.index == 1 and condition.object_type == operation.object_type) {
                let payload_slot = optional_slot(module, operation.object);
                let tag_slot = optional_slot(module, condition.object);
                if ((payload_slot as u64) != 0xFFFFFFFFu64 and payload_slot == tag_slot) {
                    return 1;
                }
            }
        }
    }
    return 0;
}

fn match_index_guard(
    module_owner: *HirModule,
    operation_id: HirExprId,
    condition_id: HirExprId
): u32 {
    let module: *HirModule = &*module_owner;
    let operation: HirExpr = raw module_owner->expressions[operation_id];
    if (operation is HirIndex) {
        if (not is_binary_operation(module, condition_id, HirBinaryOp.And)) {
            return 0;
        }
        let object_slot = slot_of_value(module, operation.object);
        let index_slot = slot_of_value(module, operation.index);
        if ((object_slot as u64) == 0xFFFFFFFFu64 or
            (index_slot as u64) == 0xFFFFFFFFu64) {
            return 0;
        }
        let lower_id = binary_left(module, condition_id);
        let upper_id = binary_right(module, condition_id);
        if (not is_binary_operation(module, lower_id, HirBinaryOp.Ge) or
            not is_binary_operation(module, upper_id, HirBinaryOp.Lt)) {
            return 0;
        }
        if (is_slot_load(module, binary_left(module, lower_id), index_slot) and
            is_zero_literal(module, binary_right(module, lower_id)) and
            is_slot_load(module, binary_left(module, upper_id), index_slot) and
            is_length_of(module, binary_right(module, upper_id),
                operation.object_type, object_slot)) {
            return 1;
        }
    }
    return 0;
}

fn match_slice_guard(
    module_owner: *HirModule,
    operation_id: HirExprId,
    condition_id: HirExprId
): u32 {
    let module: *HirModule = &*module_owner;
    let operation: HirExpr = raw module_owner->expressions[operation_id];
    if (operation is HirMakeSlice) {
        if (not is_binary_operation(module, condition_id, HirBinaryOp.And)) {
            return 0;
        }
        let object_slot = slot_of_value(module, operation.object);
        let lo_slot = slot_of_value(module, operation.lo);
        let hi_slot = slot_of_value(module, operation.hi);
        if ((object_slot as u64) == 0xFFFFFFFFu64 or
            (lo_slot as u64) == 0xFFFFFFFFu64 or
            (hi_slot as u64) == 0xFFFFFFFFu64) {
            return 0;
        }
        let first_id = binary_left(module, condition_id);
        let ordered_id = binary_right(module, condition_id);
        if (not is_binary_operation(module, first_id, HirBinaryOp.And) or
            not is_binary_operation(module, ordered_id, HirBinaryOp.Le)) {
            return 0;
        }
        let lower_id = binary_left(module, first_id);
        let upper_id = binary_right(module, first_id);
        if (not is_binary_operation(module, lower_id, HirBinaryOp.Ge) or
            not is_binary_operation(module, upper_id, HirBinaryOp.Le)) {
            return 0;
        }
        if (is_slot_load(module, binary_left(module, lower_id), lo_slot) and
            is_zero_literal(module, binary_right(module, lower_id)) and
            is_slot_load(module, binary_left(module, upper_id), hi_slot) and
            is_length_of(module, binary_right(module, upper_id),
                operation.object_type, object_slot) and
            is_slot_load(module, binary_left(module, ordered_id), lo_slot) and
            is_slot_load(module, binary_right(module, ordered_id), hi_slot)) {
            return 1;
        }
    }
    return 0;
}

fn match_union_guard(
    module_owner: *HirModule,
    operation_id: HirExprId,
    condition_id: HirExprId
): u32 {
    let module: *HirModule = &*module_owner;
    let operation: HirExpr = raw module_owner->expressions[operation_id];
    let condition: HirExpr = raw module_owner->expressions[condition_id];
    if (operation is HirUnionCast) {
        if (not valid_type_id(module, operation.from_type, false)) {
            return 0;
        }
        let union_type: HirType = raw module_owner->types[operation.from_type];
        if (union_type.kind != HirTypeKind.Union or
            (union_type.ref0 as u64) >= @lengthOf(module_owner->union_defs)) {
            return 0;
        }
        let union_def: HirUnionDef = raw module_owner->union_defs[union_type.ref0];
        if ((operation.member_index as u64) >= @lengthOf(union_def.member_type_ids)) {
            return 0;
        }
        if (condition is HirUnionCheck) {
            if (condition.union_type != operation.from_type or
                not valid_expr_id(module, condition.value, false)) {
                return 0;
            }
            let tag_expr: HirExpr = raw module_owner->expressions[condition.value];
            if (tag_expr is HirField) {
                if (tag_expr.index != 1 or tag_expr.object_type != operation.from_type or
                    not same_value(module, tag_expr.object, operation.value)) {
                    return 0;
                }
                if (condition.member_index == operation.member_index) {
                    return 1;
                }
                if (@lengthOf(union_def.member_type_ids) == 2 and
                    (condition.member_index as u64) < @lengthOf(union_def.member_type_ids)) {
                    return 2;
                }
            }
        }
    }
    return 0;
}

fn match_opaque_guard(
    module_owner: *HirModule,
    operation_id: HirExprId,
    condition_id: HirExprId
): u32 {
    let module: *HirModule = &*module_owner;
    let operation: HirExpr = raw module_owner->expressions[operation_id];
    let condition: HirExpr = raw module_owner->expressions[condition_id];
    if (operation is HirOpaqueCast) {
        if (condition is HirOpaqueCheck) {
            if (condition.opaque_type == operation.opaque_type and
                condition.runtime_type_id == operation.runtime_type_id and
                condition.canonical_hi == operation.canonical_hi and
                condition.canonical_lo == operation.canonical_lo and
                same_value(module, condition.value, operation.value)) {
                return 1;
            }
        }
    }
    return 0;
}

fn invert_guard_polarity(polarity: u32): u32 {
    if (polarity == 1) {
        return 2;
    }
    if (polarity == 2) {
        return 1;
    }
    return 0;
}

fn guard_condition_polarity(
    module_owner: *HirModule,
    operation_id: HirExprId,
    condition_id: HirExprId
): u32 {
    let module: *HirModule = &*module_owner;
    var current = condition_id;
    var inverted = false;
    for (depth in 1u64..(@lengthOf(module_owner->expressions) + 1)) {
        if (not valid_expr_id(module, current, false)) {
            return 0;
        }
        let direct = match_optional_guard(module, operation_id, current);
        if (direct != 0) {
            if (inverted) {
                return invert_guard_polarity(direct);
            }
            return direct;
        }
        let index_match = match_index_guard(module, operation_id, current);
        if (index_match != 0) {
            if (inverted) {
                return invert_guard_polarity(index_match);
            }
            return index_match;
        }
        let slice_match = match_slice_guard(module, operation_id, current);
        if (slice_match != 0) {
            if (inverted) {
                return invert_guard_polarity(slice_match);
            }
            return slice_match;
        }
        let union_match = match_union_guard(module, operation_id, current);
        if (union_match != 0) {
            if (inverted) {
                return invert_guard_polarity(union_match);
            }
            return union_match;
        }
        let opaque_match = match_opaque_guard(module, operation_id, current);
        if (opaque_match != 0) {
            if (inverted) {
                return invert_guard_polarity(opaque_match);
            }
            return opaque_match;
        }
        let expression: HirExpr = raw module_owner->expressions[current];
        if (expression is HirUnary) {
            if (expression.op != HirUnaryOp.Not) {
                return 0;
            }
            current = expression.operand;
            inverted = not inverted;
        } else {
            return 0;
        }
    }
    return 0;
}

fn cfg_has_edge(
    module_owner: *HirModule,
    function: HirFunction,
    source: u64,
    target: u64
): bool {
    let module: *HirModule = &*module_owner;
    let block: HirBasicBlock = raw function.blocks[source];
    let terminator: HirExpr = raw module_owner->expressions[block.terminator];
    if (terminator is HirBranch) {
        return (terminator.then_block as u64) == target or
            (terminator.else_block as u64) == target;
    }
    if (terminator is HirJump) {
        return (terminator.target as u64) == target;
    }
    return false;
}

fn selected_guard_edge_dominates(
    module_owner: *HirModule,
    function: HirFunction,
    use_block: u64,
    guard_block: u64,
    selected_then: bool,
    scratch: *u8,
    reachable_offset: u64,
    visited_offset: u64,
    dominators_offset: u64,
    block_count: u64
): bool {
    if (use_block >= block_count or guard_block >= block_count or
        raw scratch[reachable_offset + use_block] == 0 or
        raw scratch[reachable_offset + guard_block] == 0 or
        raw scratch[dominators_offset + use_block * block_count + guard_block] == 0) {
        return false;
    }

    for (block_offset in 1u64..block_count) {
        raw scratch[visited_offset + block_offset - 1] = 0u8;
    }
    raw scratch[visited_offset] = 1u8;

    var changed = true;
    while (changed) {
        changed = false;
        for (source_offset in 1u64..block_count) {
            let source = source_offset - 1;
            if (raw scratch[visited_offset + source] == 0) {
                continue;
            }
            if (source == use_block) {
                return false;
            }
            let block: HirBasicBlock = raw function.blocks[source];
            let terminator: HirExpr = raw module_owner->expressions[block.terminator];
            if (terminator is HirBranch) {
                var first_target = terminator.then_block as u64;
                var second_target = terminator.else_block as u64;
                if (source == guard_block) {
                    if (selected_then) {
                        first_target = terminator.else_block as u64;
                    } else {
                        first_target = terminator.then_block as u64;
                    }
                    second_target = block_count;
                }
                if (first_target < block_count and
                    raw scratch[reachable_offset + first_target] != 0 and
                    raw scratch[visited_offset + first_target] == 0) {
                    raw scratch[visited_offset + first_target] = 1u8;
                    changed = true;
                }
                if (second_target < block_count and
                    raw scratch[reachable_offset + second_target] != 0 and
                    raw scratch[visited_offset + second_target] == 0) {
                    raw scratch[visited_offset + second_target] = 1u8;
                    changed = true;
                }
            } else if (terminator is HirJump) {
                let target = terminator.target as u64;
                if (target < block_count and raw scratch[reachable_offset + target] != 0 and
                    raw scratch[visited_offset + target] == 0) {
                    raw scratch[visited_offset + target] = 1u8;
                    changed = true;
                }
            }
        }
    }
    return true;
}

fn has_dominating_guard(
    module_owner: *HirModule,
    function: HirFunction,
    use_block: u64,
    operation_id: HirExprId,
    scratch: *u8,
    reachable_offset: u64,
    visited_offset: u64,
    dominators_offset: u64,
    block_count: u64
): bool {
    for (guard_offset in 1u64..block_count) {
        let guard_block = guard_offset - 1;
        if (raw scratch[reachable_offset + guard_block] == 0 or
            raw scratch[dominators_offset + use_block * block_count + guard_block] == 0) {
            continue;
        }
        let block: HirBasicBlock = raw function.blocks[guard_block];
        let terminator: HirExpr = raw module_owner->expressions[block.terminator];
        if (terminator is HirBranch) {
            if (terminator.then_block == terminator.else_block) {
                continue;
            }
            let polarity = guard_condition_polarity(
                module_owner, operation_id, terminator.condition);
            if (polarity == 1 and selected_guard_edge_dominates(
                    module_owner, function, use_block, guard_block, true, scratch,
                    reachable_offset, visited_offset, dominators_offset, block_count)) {
                return true;
            }
            if (polarity == 2 and selected_guard_edge_dominates(
                    module_owner, function, use_block, guard_block, false, scratch,
                    reachable_offset, visited_offset, dominators_offset, block_count)) {
                return true;
            }
        }
    }
    return false;
}

fn push_expression(
    module_owner: *HirModule,
    expression_id: HirExprId,
    seen: *u8,
    stack: *u64,
    stack_count: u64
): u64 {
    let module: *HirModule = &*module_owner;
    if (not valid_expr_id(module, expression_id, false) or raw seen[expression_id] != 0) {
        return stack_count;
    }
    raw seen[expression_id] = 1u8;
    raw stack[stack_count] = expression_id as u64;
    return stack_count + 1;
}

fn push_call_expressions(
    module_owner: *HirModule,
    call: HirCall,
    seen: *u8,
    stack: *u64,
    stack_count: u64
): u64 {
    var count = push_expression(module_owner, call.callee, seen, stack, stack_count);
    for (argument_offset in 1u64..@lengthOf(call.args)) {
        let argument_id: HirExprId = raw call.args[argument_offset - 1];
        count = push_expression(module_owner, argument_id, seen, stack, count);
    }
    return count;
}

fn push_expression_children(
    module_owner: *HirModule,
    expression_id: HirExprId,
    seen: *u8,
    stack: *u64,
    stack_count: u64
): u64 {
    let module: *HirModule = &*module_owner;
    let expression: HirExpr = raw module_owner->expressions[expression_id];
    var count = stack_count;
    if (expression is HirBinary) {
        count = push_expression(module, expression.lhs, seen, stack, count);
        count = push_expression(module, expression.rhs, seen, stack, count);
    } else if (expression is HirUnary) {
        count = push_expression(module, expression.operand, seen, stack, count);
    } else if (expression is HirLet) {
        count = push_expression(module, expression.init, seen, stack, count);
    } else if (expression is HirCall) {
        count = push_call_expressions(module, expression, seen, stack, count);
    } else if (expression is HirRet) {
        count = push_expression(module, expression.value, seen, stack, count);
    } else if (expression is HirBranch) {
        count = push_expression(module, expression.condition, seen, stack, count);
    } else if (expression is HirPhi) {
        for (incoming_offset in 1u64..@lengthOf(expression.incoming)) {
            let incoming_id: HirExprId = raw expression.incoming[incoming_offset - 1];
            count = push_expression(module, incoming_id, seen, stack, count);
        }
    } else if (expression is HirAssign) {
        count = push_expression(module, expression.target, seen, stack, count);
        count = push_expression(module, expression.value, seen, stack, count);
    } else if (expression is HirIndex) {
        count = push_expression(module, expression.object, seen, stack, count);
        count = push_expression(module, expression.index, seen, stack, count);
    } else if (expression is HirField) {
        count = push_expression(module, expression.object, seen, stack, count);
    } else if (expression is HirStructLiteral) {
        for (value_offset in 1u64..@lengthOf(expression.values)) {
            let value_id: HirExprId = raw expression.values[value_offset - 1];
            count = push_expression(module, value_id, seen, stack, count);
        }
    } else if (expression is HirArrayLiteral) {
        for (element_offset in 1u64..@lengthOf(expression.elements)) {
            let element_id: HirExprId = raw expression.elements[element_offset - 1];
            count = push_expression(module, element_id, seen, stack, count);
        }
    } else if (expression is HirSlotStore) {
        count = push_expression(module, expression.value, seen, stack, count);
    } else if (expression is HirMakeSome) {
        count = push_expression(module, expression.value, seen, stack, count);
    } else if (expression is HirMakeSlice) {
        count = push_expression(module, expression.object, seen, stack, count);
        count = push_expression(module, expression.lo, seen, stack, count);
        count = push_expression(module, expression.hi, seen, stack, count);
    } else if (expression is HirCast) {
        count = push_expression(module, expression.value, seen, stack, count);
    } else if (expression is HirUnionCast) {
        count = push_expression(module, expression.value, seen, stack, count);
    } else if (expression is HirUnionCheck) {
        count = push_expression(module, expression.value, seen, stack, count);
    } else if (expression is HirLayoutIntrinsic) {
        count = push_expression(module, expression.operand, seen, stack, count);
    } else if (expression is HirStateTailCall) {
        count = push_call_expressions(module, expression.call, seen, stack, count);
    } else if (expression is HirCleanup) {
        for (cleanup_offset in 1u64..@lengthOf(expression.expressions)) {
            let cleanup_id: HirExprId = raw expression.expressions[cleanup_offset - 1];
            count = push_expression(module, cleanup_id, seen, stack, count);
        }
    } else if (expression is HirMakeDyn) {
        count = push_expression(module, expression.value, seen, stack, count);
    } else if (expression is HirDynCall) {
        count = push_expression(module, expression.receiver, seen, stack, count);
        for (argument_offset in 1u64..@lengthOf(expression.args)) {
            let argument_id: HirExprId = raw expression.args[argument_offset - 1];
            count = push_expression(module, argument_id, seen, stack, count);
        }
    } else if (expression is HirMakeOpaque) {
        count = push_expression(module, expression.value, seen, stack, count);
    } else if (expression is HirOpaqueCast) {
        count = push_expression(module, expression.value, seen, stack, count);
    } else if (expression is HirOpaqueCheck) {
        count = push_expression(module, expression.value, seen, stack, count);
    } else if (expression is HirPipe) {
        count = push_expression(module, expression.stage, seen, stack, count);
    }
    return count;
}

fn clear_expression_seen(seen: *u8, expression_count: u64) {
    for (offset in 1u64..expression_count) {
        raw seen[offset - 1] = 0u8;
    }
}

fn scan_guarded_expression_tree(
    module_owner: *HirModule,
    function: HirFunction,
    use_block: u64,
    root_id: HirExprId,
    guarded_seen: *u8,
    expression_seen: *u8,
    expression_stack: *u64,
    scratch: *u8,
    reachable_offset: u64,
    visited_offset: u64,
    dominators_offset: u64,
    block_count: u64
): HirVerificationResult {
    let module: *HirModule = &*module_owner;
    var stack_count: u64 = 0;
    stack_count = push_expression(module, root_id, expression_seen, expression_stack, stack_count);
    for (stack_count != 0) {
        stack_count = stack_count - 1;
        let expression_id = raw expression_stack[stack_count] as HirExprId;
        if (safety_mode_of(module, expression_id) == HirSafetyMode.Guarded) {
            if (not has_dominating_guard(module, function, use_block, expression_id, scratch,
                    reachable_offset, visited_offset, dominators_offset, block_count)) {
                return verification_error(HirVerifyError.InvalidSafetyGuard, expression_id);
            }
            raw guarded_seen[expression_id] = 1u8;
        }
        stack_count = push_expression_children(
            module, expression_id, expression_seen, expression_stack, stack_count);
    }
    return verification_error(HirVerifyError.None, 0);
}

pub fn verify_function_guards(
    module_owner: *HirModule,
    function: HirFunction,
    function_index: u32,
    guarded_seen: *u8,
    expression_seen: *u8,
    expression_stack: *u64,
    expression_count: u64
): HirVerificationResult {
    let module: *HirModule = &*module_owner;
    let block_count = @lengthOf(function.blocks);
    if (block_count == 0) {
        return verification_error(HirVerifyError.None, 0);
    }

    let max_u64 = 0xFFFFFFFFFFFFFFFFu64;
    if (block_count > max_u64 / block_count) {
        return verification_error(HirVerifyError.InvalidTableShape, function_index);
    }
    let matrix_size = block_count * block_count;
    if (matrix_size > max_u64 / 2 or
        block_count > (max_u64 - matrix_size * 2) / 2) {
        return verification_error(HirVerifyError.InvalidTableShape, function_index);
    }
    let scratch_size = matrix_size * 2 + block_count * 2;
    let scratch_option: ?*u8 = calloc(scratch_size, 1u64) as ?*u8;
    if (scratch_option is null) {
        return verification_error(HirVerifyError.AllocationFailure, function_index);
    }
    var scratch: *u8 = must scratch_option;
    let reachable_offset = 0u64;
    let visited_offset = block_count;
    let dominators_offset = block_count * 2;
    let next_dominators_offset = dominators_offset + matrix_size;

    raw scratch[reachable_offset] = 1u8;
    var reachability_changed = true;
    while (reachability_changed) {
        reachability_changed = false;
        for (source_offset in 1u64..block_count) {
            let source = source_offset - 1;
            if (raw scratch[reachable_offset + source] == 0) {
                continue;
            }
            for (target_offset in 1u64..block_count) {
                let target = target_offset - 1;
                if (raw scratch[reachable_offset + target] == 0 and
                    cfg_has_edge(module, function, source, target)) {
                    raw scratch[reachable_offset + target] = 1u8;
                    reachability_changed = true;
                }
            }
        }
    }

    for (block_offset in 1u64..block_count) {
        let block = block_offset - 1;
        for (candidate_offset in 1u64..block_count) {
            let candidate = candidate_offset - 1;
            if (block == 0 or raw scratch[reachable_offset + block] == 0) {
                if (block == candidate) {
                    raw scratch[dominators_offset + block * block_count + candidate] = 1u8;
                }
            } else if (raw scratch[reachable_offset + candidate] != 0) {
                raw scratch[dominators_offset + block * block_count + candidate] = 1u8;
            }
        }
    }

    var dominators_changed = true;
    while (dominators_changed) {
        dominators_changed = false;
        for (block_offset in 1u64..block_count) {
            let block = block_offset - 1;
            for (candidate_offset in 1u64..block_count) {
                let candidate = candidate_offset - 1;
                var dominates = false;
                if (block == 0 or raw scratch[reachable_offset + block] == 0) {
                    dominates = block == candidate;
                } else {
                    var has_predecessor = false;
                    var all_predecessors_dominate = true;
                    for (source_offset in 1u64..block_count) {
                        let source = source_offset - 1;
                        if (raw scratch[reachable_offset + source] != 0 and
                            cfg_has_edge(module, function, source, block)) {
                            has_predecessor = true;
                            if (raw scratch[dominators_offset +
                                source * block_count + candidate] == 0) {
                                all_predecessors_dominate = false;
                            }
                        }
                    }
                    dominates = has_predecessor and all_predecessors_dominate;
                    if (block == candidate) {
                        dominates = true;
                    }
                }
                if (dominates) {
                    raw scratch[next_dominators_offset + block * block_count + candidate] = 1u8;
                } else {
                    raw scratch[next_dominators_offset + block * block_count + candidate] = 0u8;
                }
            }
        }
        for (matrix_offset in 1u64..matrix_size) {
            let offset = matrix_offset - 1;
            let current_index = dominators_offset + offset;
            let next_index = next_dominators_offset + offset;
            if (raw scratch[current_index] != raw scratch[next_index]) {
                dominators_changed = true;
            }
            raw scratch[current_index] = raw scratch[next_index];
            raw scratch[next_index] = 0u8;
        }
    }

    for (block_offset in 1u64..block_count) {
        let use_block = block_offset - 1;
        let block: HirBasicBlock = raw function.blocks[use_block];
        for (instruction_offset in 1u64..@lengthOf(block.instructions)) {
            let instruction_id: HirExprId = raw block.instructions[instruction_offset - 1];
            clear_expression_seen(expression_seen, expression_count);
            let result = scan_guarded_expression_tree(
                module, function, use_block, instruction_id, guarded_seen,
                expression_seen, expression_stack, scratch, reachable_offset,
                visited_offset, dominators_offset, block_count);
            if (result.error != HirVerifyError.None) {
                free(scratch);
                return result;
            }
        }
        clear_expression_seen(expression_seen, expression_count);
        let result = scan_guarded_expression_tree(
            module, function, use_block, block.terminator, guarded_seen,
            expression_seen, expression_stack, scratch, reachable_offset,
            visited_offset, dominators_offset, block_count);
        if (result.error != HirVerifyError.None) {
            free(scratch);
            return result;
        }
    }
    free(scratch);
    return verification_error(HirVerifyError.None, 0);
}

