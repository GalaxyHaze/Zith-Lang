from ir/hir
from ir/hir-verify-common
from ir/hir-verify-guards

extern fn calloc(count: u64, size: u64): raw opaque
extern fn free(ptr: raw opaque): void

fn known_safety_mode(mode: HirSafetyMode): bool {
    return mode == HirSafetyMode.RequiredCheck or mode == HirSafetyMode.Guarded or
        mode == HirSafetyMode.Intrinsic or mode == HirSafetyMode.Raw;
}

fn is_block_terminator(expression: HirExpr): bool {
    if (expression is HirRet) {
        return true;
    }
    if (expression is HirBranch) {
        return true;
    }
    if (expression is HirJump) {
        return true;
    }
    if (expression is HirStateTailCall) {
        return true;
    }
    if (expression is HirRuntimePanic) {
        return true;
    }
    return false;
}

fn valid_call(module_owner: *HirModule, call: HirCall): bool {
    let module: *HirModule = &*module_owner;
    if (not valid_expr_id(module, call.callee, true) or
        not valid_type_id(module, call.function_type, true) or
        not valid_function_id(module, call.resolved_function, true) or
        @lengthOf(call.args) != @lengthOf(call.argument_types)) {
        return false;
    }
    for (argument_offset in 1u64..@lengthOf(call.args)) {
        let argument_index = argument_offset - 1;
        let argument: HirExprId = raw call.args[argument_index];
        if (not valid_expr_id(module, argument, false)) {
            return false;
        }
    }
    for (argument_offset in 1u64..@lengthOf(call.argument_types)) {
        let argument_index = argument_offset - 1;
        let argument_type: HirTypeId = raw call.argument_types[argument_index];
        if (not valid_type_id(module, argument_type, false)) {
            return false;
        }
    }
    return true;
}


fn verify_safety_proof(
    module_owner: *HirModule,
    expression_id: HirExprId,
    proof: HirSafetyProof
): HirVerifyError {
    let module: *HirModule = &*module_owner;
    if (not proof.present) {
        return HirVerifyError.None;
    }
    if ((proof.kind != HirSafetyProofKind.BoundsValid and
         proof.kind != HirSafetyProofKind.OptionalPresent and
         proof.kind != HirSafetyProofKind.UnionMemberMatches and
         proof.kind != HirSafetyProofKind.OpaqueTypeMatches) or
        safety_mode_of(module, expression_id) != HirSafetyMode.RequiredCheck) {
        return HirVerifyError.InvalidSafetyProof;
    }
    let expression: HirExpr = raw module_owner->expressions[expression_id];
    if (expression is HirIndex) {
        if (proof.kind == HirSafetyProofKind.BoundsValid and
            proof.operand_a == expression.object and
            proof.operand_b == expression.index and
            (proof.operand_c as u64) == 0xFFFFFFFFu64) {
            return HirVerifyError.None;
        }
        return HirVerifyError.InvalidSafetyProof;
    }
    if (expression is HirField) {
        if (proof.kind == HirSafetyProofKind.OptionalPresent and
            proof.operand_a == expression.object and
            (proof.operand_b as u64) == 0xFFFFFFFFu64 and
            (proof.operand_c as u64) == 0xFFFFFFFFu64) {
            return HirVerifyError.None;
        }
        return HirVerifyError.InvalidSafetyProof;
    }
    if (expression is HirMakeSlice) {
        if (proof.kind == HirSafetyProofKind.BoundsValid and
            proof.operand_a == expression.object and
            proof.operand_b == expression.lo and
            proof.operand_c == expression.hi) {
            return HirVerifyError.None;
        }
        return HirVerifyError.InvalidSafetyProof;
    }
    if (expression is HirUnionCast) {
        if (proof.kind == HirSafetyProofKind.UnionMemberMatches and
            proof.operand_a == expression.value and
            (proof.operand_b as u64) == 0xFFFFFFFFu64 and
            (proof.operand_c as u64) == 0xFFFFFFFFu64) {
            return HirVerifyError.None;
        }
        return HirVerifyError.InvalidSafetyProof;
    }
    if (expression is HirOpaqueCast) {
        if (proof.kind == HirSafetyProofKind.OpaqueTypeMatches and
            proof.operand_a == expression.value and
            (proof.operand_b as u64) == 0xFFFFFFFFu64 and
            (proof.operand_c as u64) == 0xFFFFFFFFu64) {
            return HirVerifyError.None;
        }
        return HirVerifyError.InvalidSafetyProof;
    }
    return HirVerifyError.InvalidSafetyProof;
}

pub fn verify_hir(module_owner: *HirModule): HirVerificationResult {
    let module: *HirModule = &*module_owner;
    for (definition_iteration in 1u64..@lengthOf(module_owner->struct_defs)) {
        let definition_offset = definition_iteration - 1;
        let definition_index = definition_offset as u32;
        let definition: HirStructDef = raw module_owner->struct_defs[definition_offset];
        if (not valid_string_id(module, definition.name_id, false)) {
            return verification_error(HirVerifyError.InvalidStringReference, definition_index);
        }
        if (@lengthOf(definition.field_name_ids) != @lengthOf(definition.field_type_ids)) {
            return verification_error(HirVerifyError.InvalidTableShape, definition_index);
        }
        if (definition.has_foreign_layout and
            (@lengthOf(definition.foreign_field_offsets) != @lengthOf(definition.field_type_ids) or
             definition.foreign_size_bytes == 0u64 or
             definition.foreign_align_bytes == 0u64)) {
            return verification_error(HirVerifyError.InvalidTableShape, definition_index);
        }
        for (field_iteration in 1u64..@lengthOf(definition.field_type_ids)) {
            let field_offset = field_iteration - 1;
            let field_name: HirStringId = raw definition.field_name_ids[field_offset];
            let field_type: HirTypeId = raw definition.field_type_ids[field_offset];
            if (not valid_string_id(module, field_name, false)) {
                return verification_error(HirVerifyError.InvalidStringReference, definition_index);
            }
            if (not valid_type_id(module, field_type, false)) {
                return verification_error(HirVerifyError.InvalidTypeReference, definition_index);
            }
        }
        for (argument_iteration in 1u64..@lengthOf(definition.type_arg_ids)) {
            let argument_offset = argument_iteration - 1;
            let argument_type: HirTypeId = raw definition.type_arg_ids[argument_offset];
            if (not valid_type_id(module, argument_type, false)) {
                return verification_error(HirVerifyError.InvalidTypeReference, definition_index);
            }
        }
    }
    for (definition_iteration in 1u64..@lengthOf(module_owner->enum_defs)) {
        let definition_offset = definition_iteration - 1;
        let definition_index = definition_offset as u32;
        let definition: HirEnumDef = raw module_owner->enum_defs[definition_offset];
        if (not valid_string_id(module, definition.name_id, false)) {
            return verification_error(HirVerifyError.InvalidStringReference, definition_index);
        }
        if (not valid_type_id(module, definition.underlying_type_id, true)) {
            return verification_error(HirVerifyError.InvalidTypeReference, definition_index);
        }
        for (variant_iteration in 1u64..@lengthOf(definition.variants)) {
            let variant_offset = variant_iteration - 1;
            let variant: HirEnumVariant = raw definition.variants[variant_offset];
            if (not valid_string_id(module, variant.name_id, false)) {
                return verification_error(HirVerifyError.InvalidStringReference, definition_index);
            }
        }
    }
    for (definition_iteration in 1u64..@lengthOf(module_owner->union_defs)) {
        let definition_offset = definition_iteration - 1;
        let definition_index = definition_offset as u32;
        let definition: HirUnionDef = raw module_owner->union_defs[definition_offset];
        if (not valid_string_id(module, definition.name_id, false)) {
            return verification_error(HirVerifyError.InvalidStringReference, definition_index);
        }
        for (member_iteration in 1u64..@lengthOf(definition.member_type_ids)) {
            let member_offset = member_iteration - 1;
            let member_type: HirTypeId = raw definition.member_type_ids[member_offset];
            if (not valid_type_id(module, member_type, false)) {
                return verification_error(HirVerifyError.InvalidTypeReference, definition_index);
            }
        }
    }
    for (type_iteration in 1u64..@lengthOf(module_owner->types)) {
        let type_offset = type_iteration - 1;
        let type_index = type_offset as u32;
        let hir_type: HirType = raw module_owner->types[type_offset];
        if (hir_type.kind > HirTypeKind.Trait) {
            return verification_error(HirVerifyError.InvalidTableShape, type_index);
        }
        if ((hir_type.kind == HirTypeKind.Ptr or hir_type.kind == HirTypeKind.Array or
             hir_type.kind == HirTypeKind.Fn or hir_type.kind == HirTypeKind.Optional or
             hir_type.kind == HirTypeKind.Failable or hir_type.kind == HirTypeKind.Slice or
             hir_type.kind == HirTypeKind.Incomplete or hir_type.kind == HirTypeKind.Dyn) and
            not valid_type_id(module, hir_type.ref0, false)) {
            return verification_error(HirVerifyError.InvalidTypeReference, type_index);
        }
        if ((hir_type.kind == HirTypeKind.Struct and
             (hir_type.ref0 as u64) >= @lengthOf(module_owner->struct_defs)) or
            (hir_type.kind == HirTypeKind.Enum and
             (hir_type.ref0 as u64) >= @lengthOf(module_owner->enum_defs)) or
            (hir_type.kind == HirTypeKind.Union and
             (hir_type.ref0 as u64) >= @lengthOf(module_owner->union_defs))) {
            return verification_error(HirVerifyError.InvalidDefinitionReference, type_index);
        }
        if (hir_type.kind == HirTypeKind.Trait and
            not valid_string_id(module, hir_type.ref0, false)) {
            return verification_error(HirVerifyError.InvalidStringReference, type_index);
        }
        if (@lengthOf(hir_type.arg_names) != 0 and
            @lengthOf(hir_type.arg_names) != @lengthOf(hir_type.args)) {
            return verification_error(HirVerifyError.InvalidTableShape, type_index);
        }
        for (argument_offset in 1u64..@lengthOf(hir_type.args)) {
            let argument_index = argument_offset - 1;
            let argument_type: HirTypeId = raw hir_type.args[argument_index];
            if (not valid_type_id(module, argument_type, false)) {
                return verification_error(HirVerifyError.InvalidTypeReference, type_index);
            }
        }
        for (argument_offset in 1u64..@lengthOf(hir_type.arg_names)) {
            let argument_index = argument_offset - 1;
            let argument_name: HirStringId = raw hir_type.arg_names[argument_index];
            if (not valid_string_id(module, argument_name, false)) {
                return verification_error(HirVerifyError.InvalidStringReference, type_index);
            }
        }
    }

    for (expression_iteration in 1u64..@lengthOf(module_owner->expressions)) {
        let expression_offset = expression_iteration - 1;
        let expression_index = expression_offset as u32;
        let expression: HirExpr = raw module_owner->expressions[expression_offset];
        if (expression is HirLiteral) {
            if (not valid_type_id(module, expression.type_id, false) or
                expression.value_kind > HirLiteralKind.String or
                (expression.value_kind == HirLiteralKind.String and
                 not valid_string_id(module, expression.string_id, false))) {
                return verification_error(HirVerifyError.InvalidExpressionShape, expression_index);
            }
        } else if (expression is HirBinary) {
            if (not valid_expr_id(module, expression.lhs, false) or
                not valid_expr_id(module, expression.rhs, false) or
                not valid_type_id(module, expression.type_id, false) or
                not valid_type_id(module, expression.operand_type, true) or
                expression.op > HirBinaryOp.Shr) {
                return verification_error(HirVerifyError.InvalidExpressionShape, expression_index);
            }
        } else if (expression is HirUnary) {
            if (not valid_expr_id(module, expression.operand, false) or
                not valid_type_id(module, expression.type_id, false) or
                expression.op > HirUnaryOp.Deref) {
                return verification_error(HirVerifyError.InvalidExpressionShape, expression_index);
            }
        } else if (expression is HirLet) {
            if (not valid_string_id(module, expression.name_id, false) or
                not valid_type_id(module, expression.type_id, false) or
                not valid_expr_id(module, expression.init, true)) {
                return verification_error(HirVerifyError.InvalidExpressionShape, expression_index);
            }
        } else if (expression is HirVar) {
            if (not valid_string_id(module, expression.name_id, false)) {
                return verification_error(HirVerifyError.InvalidExpressionShape, expression_index);
            }
        } else if (expression is HirCall) {
            if (not valid_call(module, expression)) {
                return verification_error(HirVerifyError.InvalidExpressionShape, expression_index);
            }
        } else if (expression is HirRet) {
            if (not valid_expr_id(module, expression.value, true)) {
                return verification_error(HirVerifyError.InvalidExpressionShape, expression_index);
            }
        } else if (expression is HirBranch) {
            if (not valid_expr_id(module, expression.condition, false)) {
                return verification_error(HirVerifyError.InvalidExpressionShape, expression_index);
            }
        } else if (expression is HirJump) {
            if ((expression.target as u64) == 0xFFFFFFFFu64) {
                return verification_error(HirVerifyError.InvalidBlockTarget, expression_index);
            }
        } else if (expression is HirPhi) {
            for (incoming_offset in 1u64..@lengthOf(expression.incoming)) {
                let incoming_index = incoming_offset - 1;
                let incoming: HirExprId = raw expression.incoming[incoming_index];
                if (not valid_expr_id(module, incoming, false)) {
                    return verification_error(HirVerifyError.InvalidExpressionReference, expression_index);
                }
            }
        } else if (expression is HirAssign) {
            if (not valid_expr_id(module, expression.target, false) or
                not valid_expr_id(module, expression.value, false)) {
                return verification_error(HirVerifyError.InvalidExpressionReference, expression_index);
            }
        } else if (expression is HirIndex) {
            if (not valid_expr_id(module, expression.object, false) or
                not valid_expr_id(module, expression.index, false) or
                not valid_type_id(module, expression.type_id, false) or
                not valid_type_id(module, expression.object_type, false) or
                not known_safety_mode(expression.safety)) {
                return verification_error(HirVerifyError.InvalidSafetyMode, expression_index);
            }
        } else if (expression is HirField) {
            if (not valid_expr_id(module, expression.object, false) or
                not valid_type_id(module, expression.type_id, false) or
                not valid_type_id(module, expression.object_type, false) or
                not known_safety_mode(expression.safety)) {
                return verification_error(HirVerifyError.InvalidSafetyMode, expression_index);
            }
        } else if (expression is HirStructLiteral) {
            if (not valid_type_id(module, expression.type_id, false)) {
                return verification_error(HirVerifyError.InvalidTypeReference, expression_index);
            }
            for (value_offset in 1u64..@lengthOf(expression.values)) {
                let value_index = value_offset - 1;
                let value: HirExprId = raw expression.values[value_index];
                if (not valid_expr_id(module, value, false)) {
                    return verification_error(HirVerifyError.InvalidExpressionReference, expression_index);
                }
            }
        } else if (expression is HirArrayLiteral) {
            if (not valid_type_id(module, expression.type_id, false)) {
                return verification_error(HirVerifyError.InvalidTypeReference, expression_index);
            }
            for (element_offset in 1u64..@lengthOf(expression.elements)) {
                let element_index = element_offset - 1;
                let element: HirExprId = raw expression.elements[element_index];
                if (not valid_expr_id(module, element, false)) {
                    return verification_error(HirVerifyError.InvalidExpressionReference, expression_index);
                }
            }
        } else if (expression is HirEnumValue) {
            if (not valid_type_id(module, expression.type_id, false)) {
                return verification_error(HirVerifyError.InvalidTypeReference, expression_index);
            }
        } else if (expression is HirSlotAlloca) {
            if ((expression.slot as u64) == 0xFFFFFFFFu64 or
                not valid_type_id(module, expression.type_id, false)) {
                return verification_error(HirVerifyError.InvalidSlotReference, expression_index);
            }
        } else if (expression is HirSlotStore) {
            if ((expression.slot as u64) == 0xFFFFFFFFu64 or
                not valid_expr_id(module, expression.value, false)) {
                return verification_error(HirVerifyError.InvalidSlotReference, expression_index);
            }
        } else if (expression is HirSlotLoad) {
            if ((expression.slot as u64) == 0xFFFFFFFFu64 or
                not valid_type_id(module, expression.type_id, false)) {
                return verification_error(HirVerifyError.InvalidSlotReference, expression_index);
            }
        } else if (expression is HirSlotAddr) {
            if ((expression.slot as u64) == 0xFFFFFFFFu64 or
                not valid_type_id(module, expression.type_id, false)) {
                return verification_error(HirVerifyError.InvalidSlotReference, expression_index);
            }
        } else if (expression is HirMakeNone) {
            if (not valid_type_id(module, expression.type_id, false)) {
                return verification_error(HirVerifyError.InvalidTypeReference, expression_index);
            }
        } else if (expression is HirMakeSome) {
            if (not valid_expr_id(module, expression.value, false) or
                not valid_type_id(module, expression.type_id, false)) {
                return verification_error(HirVerifyError.InvalidExpressionShape, expression_index);
            }
        } else if (expression is HirMakeSlice) {
            if (not valid_expr_id(module, expression.object, false) or
                not valid_expr_id(module, expression.lo, false) or
                not valid_expr_id(module, expression.hi, false) or
                not valid_type_id(module, expression.type_id, false) or
                not valid_type_id(module, expression.object_type, false) or
                not valid_type_id(module, expression.bound_type, false) or
                not known_safety_mode(expression.safety)) {
                return verification_error(HirVerifyError.InvalidSafetyMode, expression_index);
            }
        } else if (expression is HirCast) {
            if (not valid_expr_id(module, expression.value, false) or
                not valid_type_id(module, expression.from_type, false) or
                not valid_type_id(module, expression.to_type, false)) {
                return verification_error(HirVerifyError.InvalidExpressionShape, expression_index);
            }
        } else if (expression is HirUnionCast) {
            if (not valid_expr_id(module, expression.value, false) or
                not valid_type_id(module, expression.from_type, false) or
                not valid_type_id(module, expression.to_type, false) or
                not known_safety_mode(expression.safety)) {
                return verification_error(HirVerifyError.InvalidSafetyMode, expression_index);
            }
        } else if (expression is HirUnionCheck) {
            if (not valid_expr_id(module, expression.value, false) or
                not valid_type_id(module, expression.union_type, false)) {
                return verification_error(HirVerifyError.InvalidExpressionShape, expression_index);
            }
        } else if (expression is HirLayoutIntrinsic) {
            if (not valid_type_id(module, expression.type_id, false) or
                not valid_expr_id(module, expression.operand, true) or
                not valid_type_id(module, expression.operand_type, true) or
                expression.kind > HirLayoutIntrinsicKind.PtrOf) {
                return verification_error(HirVerifyError.InvalidExpressionShape, expression_index);
            }
        } else if (expression is HirStateTailCall) {
            if (not valid_call(module, expression.call)) {
                return verification_error(HirVerifyError.InvalidExpressionShape, expression_index);
            }
        } else if (expression is HirCanonicalType) {
            if (not valid_type_id(module, expression.type_id, false)) {
                return verification_error(HirVerifyError.InvalidTypeReference, expression_index);
            }
        } else if (expression is HirCleanup) {
            for (cleanup_offset in 1u64..@lengthOf(expression.expressions)) {
                let cleanup_index = cleanup_offset - 1;
                let cleanup_expression: HirExprId = raw expression.expressions[cleanup_index];
                if (not valid_expr_id(module, cleanup_expression, false)) {
                    return verification_error(HirVerifyError.InvalidExpressionReference, expression_index);
                }
            }
        } else if (expression is HirGlobalConstLoad) {
            if (not valid_string_id(module, expression.name_id, false) or
                not valid_type_id(module, expression.type_id, false)) {
                return verification_error(HirVerifyError.InvalidExpressionShape, expression_index);
            }
        } else if (expression is HirExternalGlobalAddr) {
            if (not valid_string_id(module, expression.name_id, false) or
                not valid_type_id(module, expression.type_id, false)) {
                return verification_error(HirVerifyError.InvalidExpressionShape, expression_index);
            }
        } else if (expression is HirMakeDyn) {
            if (not valid_expr_id(module, expression.value, false) or
                not valid_type_id(module, expression.source_type, false) or
                not valid_type_id(module, expression.dyn_type, false) or
                not valid_string_id(module, expression.vtable_name_id, false)) {
                return verification_error(HirVerifyError.InvalidExpressionShape, expression_index);
            }
        } else if (expression is HirDynCall) {
            if (not valid_expr_id(module, expression.receiver, false) or
                not valid_string_id(module, expression.vtable_name_id, false) or
                not valid_type_id(module, expression.result_type, false) or
                not valid_type_id(module, expression.function_type, false) or
                @lengthOf(expression.args) != @lengthOf(expression.argument_types)) {
                return verification_error(HirVerifyError.InvalidExpressionShape, expression_index);
            }
            for (argument_offset in 1u64..@lengthOf(expression.args)) {
                let argument_index = argument_offset - 1;
                let argument: HirExprId = raw expression.args[argument_index];
                if (not valid_expr_id(module, argument, false)) {
                    return verification_error(HirVerifyError.InvalidExpressionReference, expression_index);
                }
            }
            for (argument_offset in 1u64..@lengthOf(expression.argument_types)) {
                let argument_index = argument_offset - 1;
                let argument_type: HirTypeId = raw expression.argument_types[argument_index];
                if (not valid_type_id(module, argument_type, false)) {
                    return verification_error(HirVerifyError.InvalidTypeReference, expression_index);
                }
            }
        } else if (expression is HirMakeOpaque) {
            if (not valid_expr_id(module, expression.value, false) or
                not valid_type_id(module, expression.source_type, false) or
                not valid_type_id(module, expression.opaque_type, false)) {
                return verification_error(HirVerifyError.InvalidExpressionShape, expression_index);
            }
        } else if (expression is HirOpaqueCast) {
            if (not valid_expr_id(module, expression.value, false) or
                not valid_type_id(module, expression.from_type, false) or
                not valid_type_id(module, expression.to_type, false) or
                not valid_type_id(module, expression.opaque_type, false) or
                not valid_type_id(module, expression.result_type, false) or
                not known_safety_mode(expression.safety)) {
                return verification_error(HirVerifyError.InvalidSafetyMode, expression_index);
            }
        } else if (expression is HirOpaqueCheck) {
            if (not valid_expr_id(module, expression.value, false) or
                not valid_type_id(module, expression.opaque_type, false)) {
                return verification_error(HirVerifyError.InvalidExpressionShape, expression_index);
            }
        } else if (expression is HirRuntimePanic) {
        } else if (expression is HirPipe) {
            if ((expression.source_slot as u64) == 0xFFFFFFFFu64 or
                not valid_type_id(module, expression.source_type, false) or
                not valid_expr_id(module, expression.stage, false) or
                not valid_type_id(module, expression.type_id, false)) {
                return verification_error(HirVerifyError.InvalidSlotReference, expression_index);
            }
        } else if (expression is HirPipeCurrent) {
            if ((expression.slot as u64) == 0xFFFFFFFFu64 or
                not valid_type_id(module, expression.type_id, false)) {
                return verification_error(HirVerifyError.InvalidSlotReference, expression_index);
            }
        } else {
            return verification_error(HirVerifyError.InvalidExpressionShape, expression_index);
        }
    }

    if (@lengthOf(module_owner->safety_attrs.proofs) > @lengthOf(module_owner->expressions) or
        @lengthOf(module_owner->call_attrs) > @lengthOf(module_owner->expressions) or
        @lengthOf(module_owner->function_attrs) > @lengthOf(module_owner->functions)) {
        return verification_error(HirVerifyError.InvalidTableShape, 0);
    }

    for (proof_iteration in 1u64..@lengthOf(module_owner->safety_attrs.proofs)) {
        let proof_offset = proof_iteration - 1;
        let proof_index = proof_offset as u32;
        let proof: HirSafetyProof = raw module_owner->safety_attrs.proofs[proof_offset];
        if (proof.present) {
            let error = verify_safety_proof(module, proof_index, proof);
            if (error != HirVerifyError.None) {
                return verification_error(error, proof_index);
            }
        }
    }

    var call_attr_index: u32 = 0;
    for (call_attr_iteration in 1u64..@lengthOf(module_owner->call_attrs)) {
        let call_attr_offset = call_attr_iteration - 1;
        let attributes: HirCallAttrs = raw module_owner->call_attrs[call_attr_offset];
        if (attributes.returns_argument != 0xFFFFFFFFu32) {
            if ((call_attr_index as u64) >= @lengthOf(module_owner->expressions)) {
                return verification_error(HirVerifyError.InvalidAttributeOwner, call_attr_index);
            }
            let expression: HirExpr = raw module_owner->expressions[call_attr_index];
            if (expression is HirCall) {
                if ((attributes.returns_argument as u64) >= @lengthOf(expression.args)) {
                    return verification_error(HirVerifyError.InvalidAttributeOwner, call_attr_index);
                }
            } else {
                return verification_error(HirVerifyError.InvalidAttributeOwner, call_attr_index);
            }
        }
        for (argument_offset in 1u64..@lengthOf(attributes.args)) {
            let argument_index = argument_offset - 1;
            let argument_attributes: HirCallArgAttrs = raw attributes.args[argument_index];
            if (argument_attributes.escape > HirCallEscape.Move) {
                return verification_error(HirVerifyError.InvalidTableShape, call_attr_index);
            }
        }
        call_attr_index = call_attr_index + 1;
    }

    var declaration_index: u32 = 0;
    for (declaration_iteration in 1u64..@lengthOf(module_owner->declarations)) {
        let declaration_offset = declaration_iteration - 1;
        let declaration: HirDeclaration = raw module_owner->declarations[declaration_offset];
        if (declaration.template_id != invalidTemplate) {
            let template_id = declaration.template_id as u64;
            let template_count = @lengthOf(module_owner->templates);
            if (not (template_id < template_count)) {
                return verification_error(HirVerifyError.InvalidDeclarationReference, declaration_index);
            }
        }
        if (not valid_string_id(module, declaration.name_id, false) or
            not valid_type_id(module, declaration.type_id, true) or
            declaration.kind > HirDeclarationKind.Context or
            declaration.visibility > HirVisibility.Module) {
            return verification_error(HirVerifyError.InvalidDeclarationReference, declaration_index);
        }
        if (not valid_function_id(module, declaration.body_function_id, true)) {
            return verification_error(HirVerifyError.InvalidDeclarationReference, declaration_index);
        }
        if (declaration.body_function_id != invalidFunction and
            declaration.kind != HirDeclarationKind.Function) {
            return verification_error(HirVerifyError.InvalidDeclarationReference, declaration_index);
        }
        for (member_offset in 1u64..@lengthOf(declaration.members)) {
            let member_index = member_offset - 1;
            let member: HirDeclarationId = raw declaration.members[member_index];
            if (not valid_declaration_id(module, member, false)) {
                return verification_error(HirVerifyError.InvalidDeclarationReference, declaration_index);
            }
        }
        for (method_offset in 1u64..@lengthOf(declaration.method_declaration_ids)) {
            let method_index = method_offset - 1;
            let method_id: HirDeclarationId =
                raw declaration.method_declaration_ids[method_index];
            if (not valid_declaration_id(module, method_id, false)) {
                return verification_error(HirVerifyError.InvalidDeclarationReference, declaration_index);
            }
            let method: HirDeclaration = raw module_owner->declarations[method_id as u64];
            if (method.kind != HirDeclarationKind.Function) {
                return verification_error(HirVerifyError.InvalidDeclarationReference, declaration_index);
            }
        }
        if (declaration.template_id != invalidTemplate) {
            let template: HirTemplate =
                raw module_owner->templates[declaration.template_id as u64];
            if (template.declaration_id != declaration_index) {
                return verification_error(HirVerifyError.InvalidTemplateReference, declaration_index);
            }
        }
        declaration_index = declaration_index + 1;
    }

    var template_index: u32 = 0;
    for (template_iteration in 1u64..@lengthOf(module_owner->templates)) {
        let template_offset = template_iteration - 1;
        let template: HirTemplate = raw module_owner->templates[template_offset];
        if (@lengthOf(template.param_type_ids) !=
                @lengthOf(template.param_name_ids) or
            @lengthOf(template.field_name_ids) !=
                @lengthOf(template.field_type_ids) or
            @lengthOf(template.canonical_field_order) !=
                @lengthOf(template.field_name_ids)) {
            return verification_error(HirVerifyError.InvalidTemplateShape, template_index);
        }
        if (not valid_declaration_id(module, template.declaration_id, false) or
            not valid_function_id(module, template.function_id, true) or
            template.kind > HirDeclarationKind.Context or
            not valid_string_id(module, template.name_id, false) or
            not valid_type_id(module, template.return_type_id,
                template.kind != HirDeclarationKind.Function)) {
            return verification_error(HirVerifyError.InvalidTemplateShape, template_index);
        }
        let owner: HirDeclaration =
            raw module_owner->declarations[template.declaration_id as u64];
        if (owner.template_id != template_index or owner.kind != template.kind or
            owner.name_id != template.name_id or owner.is_extern != template.is_extern or
            @lengthOf(owner.method_declaration_ids) !=
                @lengthOf(template.method_declaration_indices) or
            (owner.body_function_id != invalidFunction and
             template.function_id != invalidFunction and
             owner.body_function_id != template.function_id)) {
            return verification_error(HirVerifyError.InvalidTemplateReference, template_index);
        }
        for (method_offset in 1u64..@lengthOf(owner.method_declaration_ids)) {
            let method_index = method_offset - 1;
            if (raw owner.method_declaration_ids[method_index] !=
                raw template.method_declaration_indices[method_index]) {
                return verification_error(HirVerifyError.InvalidTemplateReference, template_index);
            }
        }

        for (parameter_offset in 1u64..@lengthOf(template.params)) {
            let parameter_index = parameter_offset - 1;
            let parameter: HirGenericParam = raw template.params[parameter_index];
            if (not valid_string_id(module, parameter.name_id, false)) {
                return verification_error(HirVerifyError.InvalidStringReference, template_index);
            }
            for (bound_offset in 1u64..@lengthOf(parameter.bound_type_ids)) {
                let bound_index = bound_offset - 1;
                let bound_type: HirTypeId = raw parameter.bound_type_ids[bound_index];
                if (not valid_type_id(module, bound_type, false)) {
                    return verification_error(HirVerifyError.InvalidTypeReference, template_index);
                }
            }
        }
        for (parameter_offset in 1u64..@lengthOf(template.param_type_ids)) {
            let parameter_index = parameter_offset - 1;
            let parameter_type: HirTypeId = raw template.param_type_ids[parameter_index];
            let parameter_name: HirStringId = raw template.param_name_ids[parameter_index];
            if (not valid_type_id(module, parameter_type, false)) {
                return verification_error(HirVerifyError.InvalidTypeReference, template_index);
            }
            if (not valid_string_id(module, parameter_name, false)) {
                return verification_error(HirVerifyError.InvalidStringReference, template_index);
            }
        }
        for (field_offset in 1u64..@lengthOf(template.field_name_ids)) {
            let field_index = field_offset - 1;
            let field_name: HirStringId = raw template.field_name_ids[field_index];
            let field_type: HirTypeId = raw template.field_type_ids[field_index];
            if (not valid_string_id(module, field_name, false)) {
                return verification_error(HirVerifyError.InvalidStringReference, template_index);
            }
            if (not valid_type_id(module, field_type, false)) {
                return verification_error(HirVerifyError.InvalidTypeReference, template_index);
            }
            let canonical_index: u32 =
                raw template.canonical_field_order[field_index];
            if ((canonical_index as u64) >= @lengthOf(template.field_name_ids)) {
                return verification_error(HirVerifyError.InvalidTemplateShape, template_index);
            }
            for (prior_offset in 1u64..(field_offset - 1u64)) {
                let prior_index = prior_offset - 1;
                if (raw template.canonical_field_order[prior_index] == canonical_index) {
                    return verification_error(HirVerifyError.InvalidTemplateShape, template_index);
                }
            }
        }
        for (method_offset in 1u64..@lengthOf(template.method_declaration_indices)) {
            let method_index = method_offset - 1;
            let method_id: HirDeclarationId =
                raw template.method_declaration_indices[method_index];
            if (not valid_declaration_id(module, method_id, false)) {
                return verification_error(HirVerifyError.InvalidDeclarationReference, template_index);
            }
            let method: HirDeclaration = raw module_owner->declarations[method_id as u64];
            if (method.kind != HirDeclarationKind.Function) {
                return verification_error(HirVerifyError.InvalidDeclarationReference, template_index);
            }
        }
        for (trait_offset in 1u64..@lengthOf(template.trait_type_ids)) {
            let trait_index = trait_offset - 1;
            let trait_type: HirTypeId = raw template.trait_type_ids[trait_index];
            if (not is_trait_type(module_owner, trait_type)) {
                return verification_error(HirVerifyError.InvalidTypeReference, template_index);
            }
        }

        if (template.function_id != invalidFunction) {
            let function: HirFunction =
                raw module_owner->functions[template.function_id as u64];
            if (function.return_type != template.return_type_id or
                function.variadic != template.variadic or
                function.state_function != template.state_function or
                function.foreign_c != template.foreign_c or
                function.uses_tail_calling_convention !=
                    template.uses_tail_calling_convention or
                @lengthOf(function.parameter_types) !=
                    @lengthOf(template.param_type_ids) or
                @lengthOf(function.parameter_name_ids) !=
                    @lengthOf(template.param_name_ids)) {
                return verification_error(HirVerifyError.InvalidTemplateShape, template_index);
            }
            for (parameter_offset in 1u64..@lengthOf(template.param_type_ids)) {
                let parameter_index = parameter_offset - 1;
                if (raw function.parameter_types[parameter_index] !=
                        raw template.param_type_ids[parameter_index] or
                    raw function.parameter_name_ids[parameter_index] !=
                        raw template.param_name_ids[parameter_index]) {
                    return verification_error(HirVerifyError.InvalidTemplateShape, template_index);
                }
            }
        }
        template_index = template_index + 1;
    }

    var function_index: u32 = 0;
    for (function_iteration in 1u64..@lengthOf(module_owner->functions)) {
        let function_offset = function_iteration - 1;
        let function: HirFunction = raw module_owner->functions[function_offset];
        if (not valid_string_id(module, function.name_id, false) or
            not valid_type_id(module, function.return_type, false) or
            not valid_type_id(module, function.machine_return_type, true) or
            not valid_string_id(module, function.foreign_adapter_name_id, true) or
            function.has_body != (@lengthOf(function.blocks) != 0) or
            (@lengthOf(function.parameter_name_ids) != 0 and
             @lengthOf(function.parameter_name_ids) != @lengthOf(function.parameter_types)) or
            (@lengthOf(function.parameter_slots) != 0 and
             @lengthOf(function.parameter_slots) != @lengthOf(function.parameter_types))) {
            return verification_error(HirVerifyError.InvalidTableShape, function_index);
        }
        for (parameter_offset in 1u64..@lengthOf(function.parameter_types)) {
            let parameter_index = parameter_offset - 1;
            let parameter_type: HirTypeId = raw function.parameter_types[parameter_index];
            if (not valid_type_id(module, parameter_type, false)) {
                return verification_error(HirVerifyError.InvalidTypeReference, function_index);
            }
        }
        for (parameter_offset in 1u64..@lengthOf(function.parameter_name_ids)) {
            let parameter_index = parameter_offset - 1;
            let parameter_name: HirStringId = raw function.parameter_name_ids[parameter_index];
            if (not valid_string_id(module, parameter_name, false)) {
                return verification_error(HirVerifyError.InvalidStringReference, function_index);
            }
        }

        var block_index: u32 = 0;
        for (block_iteration in 1u64..@lengthOf(function.blocks)) {
            let block_offset = block_iteration - 1;
            let block: HirBasicBlock = raw function.blocks[block_offset];
            if (not valid_expr_id(module, block.terminator, false)) {
                return verification_error(HirVerifyError.InvalidExpressionReference, block_index);
            }
            let terminator: HirExpr = raw module_owner->expressions[block.terminator];
            if (not is_block_terminator(terminator)) {
                return verification_error(HirVerifyError.InvalidExpressionShape, block_index);
            }
            if (terminator is HirBranch) {
                if ((terminator.then_block as u64) >= @lengthOf(function.blocks) or
                    (terminator.else_block as u64) >= @lengthOf(function.blocks)) {
                    return verification_error(HirVerifyError.InvalidBlockTarget, block_index);
                }
            } else if (terminator is HirJump) {
                if ((terminator.target as u64) >= @lengthOf(function.blocks)) {
                    return verification_error(HirVerifyError.InvalidBlockTarget, block_index);
                }
            }
            for (instruction_offset in 1u64..@lengthOf(block.instructions)) {
                let instruction_index = instruction_offset - 1;
                let instruction: HirExprId = raw block.instructions[instruction_index];
                if (not valid_expr_id(module, instruction, false)) {
                    return verification_error(HirVerifyError.InvalidExpressionReference, block_index);
                }
                let instruction_expression: HirExpr = raw module_owner->expressions[instruction];
                if (is_block_terminator(instruction_expression)) {
                    return verification_error(HirVerifyError.InvalidExpressionShape, block_index);
                }
            }
            block_index = block_index + 1;
        }
        function_index = function_index + 1;
    }

    let expression_count = @lengthOf(module_owner->expressions);
    var allocation_count = expression_count;
    if (allocation_count == 0) {
        allocation_count = 1;
    }
    let guarded_seen_option: ?*u8 = calloc(allocation_count, 1u64) as ?*u8;
    if (guarded_seen_option is null) {
        return verification_error(HirVerifyError.AllocationFailure, 0);
    }
    let expression_seen_option: ?*u8 = calloc(allocation_count, 1u64) as ?*u8;
    if (expression_seen_option is null) {
        free(must guarded_seen_option);
        return verification_error(HirVerifyError.AllocationFailure, 0);
    }
    let expression_stack_option: ?*u64 = calloc(allocation_count, 8u64) as ?*u64;
    if (expression_stack_option is null) {
        free(must expression_seen_option);
        free(must guarded_seen_option);
        return verification_error(HirVerifyError.AllocationFailure, 0);
    }
    var guarded_seen: *u8 = must guarded_seen_option;
    var expression_seen: *u8 = must expression_seen_option;
    var expression_stack: *u64 = must expression_stack_option;

    var guarded_function_index: u32 = 0;
    for (function_iteration in 1u64..@lengthOf(module_owner->functions)) {
        let function_offset = function_iteration - 1;
        let function: HirFunction = raw module_owner->functions[function_offset];
        let result = verify_function_guards(
            module, function, guarded_function_index, guarded_seen, expression_seen,
            expression_stack, expression_count);
        if (result.error != HirVerifyError.None) {
            free(expression_stack);
            free(expression_seen);
            free(guarded_seen);
            return result;
        }
        guarded_function_index = guarded_function_index + 1;
    }

    for (expression_offset in 1u64..expression_count) {
        let expression_index = expression_offset - 1;
        let expression_id = expression_index as HirExprId;
        if (safety_mode_of(module, expression_id) == HirSafetyMode.Guarded and
            raw guarded_seen[expression_index] == 0) {
            free(expression_stack);
            free(expression_seen);
            free(guarded_seen);
            return verification_error(HirVerifyError.InvalidSafetyGuard, expression_id);
        }
    }
    free(expression_stack);
    free(expression_seen);
    free(guarded_seen);

    var global_index: u32 = 0;
    for (global_iteration in 1u64..@lengthOf(module_owner->global_constants)) {
        let global_offset = global_iteration - 1;
        let global_constant: HirGlobalConst = raw module_owner->global_constants[global_offset];
        if (not valid_string_id(module, global_constant.name_id, false) or
            not valid_type_id(module, global_constant.type_id, false) or
            not valid_expr_id(module, global_constant.initializer, false)) {
            return verification_error(HirVerifyError.InvalidGlobal, global_index);
        }
        global_index = global_index + 1;
    }

    var vtable_index: u32 = 0;
    for (vtable_iteration in 1u64..@lengthOf(module_owner->vtables)) {
        let vtable_offset = vtable_iteration - 1;
        let vtable: HirVTable = raw module_owner->vtables[vtable_offset];
        if (not valid_string_id(module, vtable.name_id, false)) {
            return verification_error(HirVerifyError.InvalidVTable, vtable_index);
        }
        for (function_iteration in 1u64..@lengthOf(vtable.slot_functions)) {
            let function_index = function_iteration - 1;
            let function_id: HirFunctionId = raw vtable.slot_functions[function_index];
            if (not valid_function_id(module, function_id, false)) {
                return verification_error(HirVerifyError.InvalidVTable, vtable_index);
            }
        }
        vtable_index = vtable_index + 1;
    }

    var function_attr_index: u32 = 0;
    for (function_attr_iteration in 1u64..@lengthOf(module_owner->function_attrs)) {
        let function_attr_offset = function_attr_iteration - 1;
        let attributes: HirFunctionAttrs = raw module_owner->function_attrs[function_attr_offset];
        if (attributes.return_consumed > HirConsumedState.NonConsumed) {
            return verification_error(HirVerifyError.InvalidTableShape, function_attr_index);
        }
        function_attr_index = function_attr_index + 1;
    }

    var slot_attr_index: u32 = 0;
    for (slot_attr_iteration in 1u64..@lengthOf(module_owner->slot_attrs)) {
        let slot_attr_offset = slot_attr_iteration - 1;
        let attributes: HirSlotAttrs = raw module_owner->slot_attrs[slot_attr_offset];
        if (attributes.ownership > HirOwnership.Belong or
            attributes.consumed > HirConsumedState.NonConsumed) {
            return verification_error(HirVerifyError.InvalidTableShape, slot_attr_index);
        }
        slot_attr_index = slot_attr_index + 1;
    }

    return verification_error(HirVerifyError.None, 0);
}
