import "stdio.h"
//import "unistd.h"

fn main(argc: i32, argv: **char){
    _ = printf("\033[1;31mThis text is bold red.\033[0m\n");
    
    // Green text
    _ = printf("\033[0;32mThis text is normal green.\n");
    
    // Reset back to default
    _ = printf("\033[0mBack to default color.\n");
    
    _ = fprintf(stderr, "Yoo wtf");
}