//from utils/prints
from utils/keywords

fn main(argc: i32, argv: **char){
    printerr(tColor.Green, "Erro: ");
    printerr(tColor.Blue, raw argv[0]);

    let id =  getKeywordId("if");

    when (id){
        (getKeywordId("if")) printout(tColor.Magenta, "nice! it works\n"),
        (_) printout(tColor.Cyan, "sad...\n")
    }
    if (id == getKeywordId("if")){
        printout(tColor.Cyan, "\nWorks!!!\n");
    }
}